-- MAP DISCOVERY  (lists rebuild themselves when the game adds worlds)
------------------------------------------------------------------------
local Maps = {}
Maps.Changed = Instance.new("BindableEvent")

function Maps.IsFarmWorld(folder)
    return folder:IsA("Folder") and not CFG.ModeWorlds[folder.Name]
        and not string.find(folder.Name, "Gamemode", 1, true)
end

function Maps.FarmWorlds()
    local names = {}
    for _, folder in ipairs(Worlds:GetChildren()) do
        if Maps.IsFarmWorld(folder) then names[#names + 1] = folder.Name end
    end
    table.sort(names)
    return names
end

function Maps.Eggs(worldName)
    local world, names, seen = Worlds:FindFirstChild(worldName or ""), {}, {}
    if not world then return names end
    for _, obj in ipairs(world:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) and string.sub(obj.Name, -3) == "Egg" and not seen[obj.Name] then
            seen[obj.Name] = true
            names[#names + 1] = obj.Name
        end
    end
    table.sort(names)
    return names
end

function Maps.Monsters(worldName)
    local names, seen = { "Nearest" }, {}
    for _, enemy in ipairs(Combat.List(worldName)) do
        local n = Combat.Name(enemy)
        if not seen[n] then seen[n] = true names[#names + 1] = n end
    end
    return names
end

function Maps.Pets()
    local names = {}
    local folder = LP:FindFirstChild("Pets")
    if folder then
        for _, pet in ipairs(folder:GetChildren()) do names[#names + 1] = pet.Name end
    end
    table.sort(names)
    return names
end

Worlds.ChildAdded:Connect(function(child)
    task.wait(1)
    if Maps.IsFarmWorld(child) then
        Util.Notify("New map: " .. child.Name)
        Maps.Changed:Fire()
    end
end)
Worlds.ChildRemoved:Connect(function() Maps.Changed:Fire() end)

