-- called by the Brain at Battle Pass's place in the Priority list
function BP.Step()
    if not On("AutoBattlePass") then return false end
    if not next(F("BPQuests") or {}) then
        note("pick", "pick the quests to do first")
        return false
    end
    local cur = BP.task
    if cur and BP.Inside(cur) and BP.Run[cur] then
        local ok, busy = pcall(BP.Run[cur])
        if ok and busy then return true end
    end
    local pending = BP.Pending()
    for _, q in ipairs(pending) do
        local run = BP.Run[q.kind]
        if run and not skipped(q) then
            local ok, busy = pcall(run, q)
            if not ok then
                warn("[" .. CFG.Name .. "] Battle Pass " .. tostring(q.kind) .. ": " .. tostring(busy))
            elseif busy then
                if BP.task ~= q.kind then
                    BP.task, BP.since = q.kind, os.clock()
                    Util.Notify(string.format("Battle Pass: %s (repeat %d/%d)", q.name, (q.reps or 0) + 1, q.max or BP.Repeats))
                end
                BP.allDone = false
                watch(q)
                return true
            end
        end
    end
    table.clear(Forced)
    BP.task = nil
    if #pending == 0 and #BP.quests > 0 and not BP.allDone then
        BP.allDone = true
        Util.Notify("Battle Pass: picked quests done for today")
    end
    return false
end

function BP.StatusText()
    local lines = {}
    local left = BP.resetAt and math.max(0, math.floor(BP.resetAt - os.clock()))
    lines[1] = "Reset In : " .. (left and string.format("%d:%02d:%02d", left // 3600, (left % 3600) // 60, left % 60) or "?")
        .. "    Doing : " .. (BP.task or "-")
    if #BP.quests == 0 then
        lines[#lines + 1] = "No quests read yet - press Read Quests (opens the Battle Pass window once)"
    end
    local pick = F("BPQuests") or {}
    for _, q in ipairs(BP.quests) do
        local mark = q.done and "[done]" or (q.kind and pick[q.kind]) and (skipped(q) and "[skip]" or "[ on ]") or "[ -- ]"
        lines[#lines + 1] = string.format("%s %s  %s/%s  Repeats %d/%d%s", mark, q.name, short(q.prog), short(q.goal),
            q.reps or 0, q.max or BP.Repeats, q.kind and "" or "  (not supported)")
    end
    return table.concat(lines, "\n")
end
end

-- BRAIN: one owner of the character at a time ----------------------------------------------------
-- DIAGNOSTICS ---------------------------------------------------------------------------------------
-- One text file (GravityHub/AFS/diagnostics.txt) with what the hub sees in YOUR game:
-- remotes it calls (found? Event or Function?), your player values, the world you're
-- in and its enemies, the game GUI, modules it reads, learned calls and recent errors.
-- It's what's needed to fix a feature without guessing.
local Diag = { Errors = {}, ErrorSeen = {} }
-- own folder helper: the Window (and its EnsureFolder) doesn't exist yet at this point
function Diag.EnsureFolder(path)
    if not (isfolder and makefolder) then return end
    local cur = ""
    for part in string.gmatch(path, "[^/]+") do
        cur = cur == "" and part or (cur .. "/" .. part)
        pcall(function() if not isfolder(cur) then makefolder(cur) end end)
    end
end

function Diag.LogError(where, err)
    local msg = tostring(where) .. ": " .. tostring(err)
    local now = os.clock()
    if Diag.ErrorSeen[msg] and now - Diag.ErrorSeen[msg] < 60 then return end
    Diag.ErrorSeen[msg] = now
    local line = os.date("%H:%M:%S") .. "  " .. msg
    Diag.Errors[#Diag.Errors + 1] = line
    if #Diag.Errors > 200 then table.remove(Diag.Errors, 1) end
    if appendfile then
        pcall(function()
            Diag.EnsureFolder(CFG.ConfigFolder)
            appendfile(CFG.ConfigFolder .. "/errors.txt", line .. "\n")
        end)
    end
end

local function diagTree(obj, depth, maxKids, out, indent)
    indent = indent or ""
    if not obj then out[#out + 1] = indent .. "(missing)" return end
    local kids = obj:GetChildren()
    local val = ""
    if obj:IsA("ValueBase") then val = " = " .. tostring(obj.Value) end
    if obj:IsA("GuiObject") then val = val .. (obj.Visible and "  [visible]" or "  [hidden]") end
    if obj:IsA("TextLabel") or obj:IsA("TextButton") then val = val .. '  "' .. string.sub(obj.Text, 1, 40) .. '"' end
    out[#out + 1] = indent .. obj.Name .. "  <" .. obj.ClassName .. ">" .. val .. (#kids > 0 and ("  (" .. #kids .. ")") or "")
    if depth <= 0 then return end
    -- group same-named children (enemy lists, pickups...) so the file stays short
    local shown, groups, order = 0, {}, {}
    for _, c in ipairs(kids) do
        local key = c.Name .. "<" .. c.ClassName .. ">"
        if not groups[key] then groups[key] = { first = c, n = 0 } order[#order + 1] = key end
        groups[key].n = groups[key].n + 1
    end
    for _, key in ipairs(order) do
        shown = shown + 1
        if shown > (maxKids or 25) then out[#out + 1] = indent .. "  ... " .. (#order - shown + 1) .. " more kinds" break end
        local g = groups[key]
        if g.n > 1 then out[#out + 1] = indent .. "  x" .. g.n .. " of:" end
        diagTree(g.first, depth - 1, maxKids, out, indent .. "  ")
    end
end

function Diag.Report()
    local out = {}
    local function add(s) out[#out + 1] = s end
    local function section(t) add("") add("==== " .. t .. " ====") end
    local exec = "?"
    pcall(function() exec = table.concat({ identifyexecutor() }, " ") end)
    add(CFG.Name .. " diagnostics  " .. os.date("%Y-%m-%d %H:%M:%S") .. "  executor: " .. exec .. "  place: " .. tostring(game.PlaceId))
    add("functions: hookmetamethod=" .. tostring(hookmetamethod ~= nil) .. " getconnections=" .. tostring(getconnections ~= nil)
        .. " firesignal=" .. tostring(firesignal ~= nil) .. " fireproximityprompt=" .. tostring(fireproximityprompt ~= nil)
        .. " firetouchinterest=" .. tostring(firetouchinterest ~= nil) .. " writefile=" .. tostring(writefile ~= nil))

    section("REMOTES the hub uses")
    local names, seen = {}, {}
    for key, e in pairs(CFG.Calls) do if not seen[e[1]] then seen[e[1]] = key names[#names + 1] = e[1] end end
    for _, n in ipairs({ "JoinDungeon", "SetDungeonSetting", "ClaimGift", "AttemptMultiOpen", "GetSpawn", "PetAttack", "PetAbility", "SendPet" }) do
        if not seen[n] then seen[n] = "raw" names[#names + 1] = n end
    end
    table.sort(names)
    for _, n in ipairs(names) do
        local r = Remotes:FindFirstChild(n)
        add(string.format("%-28s %s", n, r and r.ClassName or "MISSING"))
    end
    section("BINDABLES")
    for _, n in ipairs({ "SendPet", "FindSpawn", "ToggleMount", "Teleported", "SummonDungeon", "AttemptOpenGate" }) do
        local b = Bindables:FindFirstChild(n)
        add(string.format("%-28s %s", n, b and b.ClassName or "MISSING"))
    end

    section("PLAYER")
    add("World value: " .. tostring(Util.World()) .. "   character: " .. tostring(LP.Character ~= nil) .. "   root: " .. tostring(Util.Root() ~= nil))
    diagTree(LP, 1, 40, out)
    local pets = LP:FindFirstChild("Pets")
    if pets and pets:GetChildren()[1] then add("first pet:") diagTree(pets:GetChildren()[1], 2, 30, out, "  ") end

    section("WORLDS")
    add("farm worlds: " .. #Data.FarmWorlds() .. "   event worlds: " .. #Data.EventWorlds() .. "   all: " .. #Data.AllWorlds())
    local fl = Data.FarmWorldLabels()
    add("first labels: " .. table.concat({ fl[1] or "-", fl[2] or "-", fl[3] or "-" }, ", "))
    local w = Worlds:FindFirstChild(Util.World())
    add("current world folder:")
    diagTree(w, 3, 20, out, "  ")
    local enemies = Combat.List(Util.World())
    add("enemies found by the hub here: " .. #enemies)
    if enemies[1] then diagTree(enemies[1], 2, 30, out, "  ") end

    section("WORKSPACE (top)")
    diagTree(workspace, 1, 60, out)
    local fx = workspace:FindFirstChild("Effects")
    if fx then add("Effects:") diagTree(fx, 2, 15, out, "  ") end

    section("MODE WORLDS")
    for _, n in ipairs({ "Dungeon", "Raid", "Tower", "InfinityTower", "GatesMode", "TimeChamber", "GlobalBoss" }) do
        diagTree(Worlds:FindFirstChild(n), 2, 15, out)
    end

    section("GAME GUI (MainGui)")
    diagTree(Data.MainGui(), 1, 200, out)
    for _, n in ipairs({ "DungeonSummon", "DungeonTravel", "DungeonTimer", "TowerTimer", "TimeTrialTeleport", "RaidPicker", "RaidTransport", "Quest", "MountButtonFrame", "BattlePass" }) do
        local g = Data.MainGui() and Data.MainGui():FindFirstChild(n)
        if g then diagTree(g, 3, 12, out, "  ") end
    end

    section("MODULES")
    for _, n in ipairs({ "WorldData", "PassiveStats", "ArtefactData", "RebirthBossData", "QuestData", "EggStats", "EnemyStats", "BattlePassInfo", "BattlepassQuest" }) do
        local m = Data.Module(n)
        local keys = {}
        for k in pairs(m or {}) do keys[#keys + 1] = tostring(k) if #keys >= 8 then break end end
        add(string.format("%-16s %s  %s", n, m and "OK" or "BLOCKED/MISSING", table.concat(keys, ", ")))
    end

    section("BATTLE PASS")
    pcall(function()
        local BP = Features.BattlePass
        add(BP.StatusText())
        add("save tables: " .. table.concat(BP.saveKeys or {}, ", "))
        for k, t in pairs(BP.SaveTables()) do
            local ok, j = pcall(HttpService.JSONEncode, HttpService, t)
            add("save." .. k .. "  " .. string.sub(ok and j or "?", 1, 1500))
        end
        local ok, j = pcall(HttpService.JSONEncode, HttpService, BP.raw)
        add("GetBPdata  " .. string.sub(ok and tostring(j) or tostring(BP.raw), 1, 1500))
        for _, n in ipairs({ "BattlepassQuest", "BattlePassInfo" }) do
            local okm, jm = pcall(HttpService.JSONEncode, HttpService, Data.Module(n))
            add(n .. "  " .. string.sub(okm and tostring(jm) or "?", 1, 1500))
        end
    end)

    section("LEARNED CALLS")
    pcall(function()
        for name, args in pairs(Learn.Load()) do
            local ok, j = pcall(HttpService.JSONEncode, HttpService, args)
            add(name .. "  " .. (ok and j or "?"))
        end
    end)

    section("FLAGS ON")
    local on = {}
    for flag, el in pairs(Library.Flags) do
        local v = el:Get()
        if v == true then on[#on + 1] = flag
        elseif type(v) == "string" and v ~= "" then on[#on + 1] = flag .. "=" .. v end
    end
    table.sort(on)
    add(table.concat(on, ", "))

    section("RECENT ERRORS")
    for _, e in ipairs(Diag.Errors) do add(e) end
    if Net.Missing then
        local m = {}
        for n in pairs(Net.Missing) do m[#m + 1] = n end
        add("missing remotes called: " .. table.concat(m, ", "))
    end
    return table.concat(out, "\n")
end

function Diag.Save()
    local ok, text = pcall(Diag.Report)
    if not ok then text = "report failed: " .. tostring(text) end
    if not writefile then Util.Notify("Executor has no writefile") return text end
    pcall(function()
        Diag.EnsureFolder(CFG.ConfigFolder)
        writefile(CFG.ConfigFolder .. "/diagnostics.txt", text)
    end)
    Util.Notify("Saved " .. CFG.ConfigFolder .. "/diagnostics.txt")
    return text
end

-- PRIORITY: every feature that moves the character is a task; the Brain runs them in the order
-- set in Settings > Priority (1 = first). The first task that wants the character this tick gets
-- it; a task that has nothing to do right now (trial not open, cooldown, ...) lets the next one go.
local function wantedRecently(who, secs)
    local w = Features.PassiveWants and Features.PassiveWants[who]
    return w and os.clock() - w.at < (secs or 3) and On("PassiveGoMachine") and w or nil
end
Features.Tasks = {
    { id = "Lunar", name = "Auto Lunar Quests", run = function()
        local w = On("AutoEventQuests") and wantedRecently("lunar")
        if w then Features.GoPassiveMachine(w.machine) return true end
    end },
    { id = "Passive", name = "Auto Passive", run = function()
        local w = On("AutoPassive") and wantedRecently("passive")
        if w then Features.GoPassiveMachine(w.machine) return true end
    end },
    { id = "Mega", name = "Mega Boost Craft", run = function()
        if Features.MegaWantAt and os.clock() - Features.MegaWantAt < 4 and On("AutoMegaCraft") and On("MegaGoMaster") then
            Features.GoPotionMaster() return true
        end
    end },
    { id = "BattlePass", name = "Battle Pass", run = function()
        return Features.BattlePass ~= nil and Features.BattlePass.Step()
    end },
    { id = "Infinity", name = "Infinity Tower", run = function()
        if On("AutoInf") then Features.InfinityTower() return true end
    end },
    { id = "Dungeon", name = "Dungeon", run = function()
        if On("AutoOpenDungeon") or (On("AutoFarmDungeon") and Features.InDungeon()) then return Features.Dungeon() end
    end },
    { id = "Gate", name = "Gate", run = function()
        -- false = no gates left: the next feature in the Priority list runs
        if On("AutoGate") then return Features.Gates() end
    end },
    { id = "Trial", name = "Time Trial", run = function() return On("AutoTrial") and Features.TimeTrial() end },
    { id = "Raid", name = "Raid", run = function() return On("AutoRaid") and Features.Raid() end },
    { id = "Defense", name = "Defense", run = function() return On("AutoDefense") and Features.Defense() end },
    { id = "Event", name = "Event", run = function() return On("AutoEvent") and Features.Events() end },
    { id = "GlobalBoss", name = "Global Boss", run = function() return On("AutoGlobalBoss") and Features.GlobalBoss() end },
    { id = "Meteor", name = "Meteor", run = function() return On("AutoMeteor") and Features.Meteor() end },
    { id = "Hatch", name = "Hatch Egg", run = function()
        return On("AutoHatch") and Features.HatchWantAt ~= nil and os.clock() - Features.HatchWantAt < 3
    end },
    { id = "Farm", name = "Farm / Quest", run = function()
        if On("AutoQuest") then Features.Quest() end
        if On("AutoFarm") then
            Combat.InFarm = true
            local ok, err = pcall(Features.Farm)
            Combat.InFarm = false
            if not ok then warn("[" .. CFG.Name .. "] " .. tostring(err)) end
            return true
        end
    end },
    { id = "TimeChamber", name = "Time Chamber", run = function()
        if On("AutoTimeChamber") then Features.TimeChamber() return true end
    end },
}
-- default order (Settings > Priority changes it)
Features.DefaultPrio = { Lunar = 1, Trial = 2, BattlePass = 3, Dungeon = 4, Hatch = 5, Passive = 6, Mega = 7, Infinity = 8,
    Gate = 9, Raid = 10, Defense = 11, Event = 12, GlobalBoss = 13, Meteor = 14, Farm = 15, TimeChamber = 16 }
-- the tasks sorted by their Priority number (ties keep the default order)
function Features.TaskOrder()
    local list = {}
    for i, t in ipairs(Features.Tasks) do
        local def = Features.DefaultPrio[t.id] or i
        list[#list + 1] = { task = t, prio = tonumber(F("Prio_" .. t.id)) or def, def = def }
    end
    table.sort(list, function(a, b) if a.prio ~= b.prio then return a.prio < b.prio end return a.def < b.def end)
    local out = {}
    for _, e in ipairs(list) do out[#out + 1] = e.task end
    return out
end
local function Brain()
    for _, t in ipairs(Features.TaskOrder()) do
        local ok, took = pcall(t.run)
        if not ok then
            warn("[" .. CFG.Name .. "] " .. t.id .. ": " .. tostring(took))
            Combat.Log("err-" .. t.id, "ERROR in " .. t.id .. ": " .. tostring(took))
        end
        if ok and took then
            -- who has the character now (in combat_log.txt only when it changes)
            Combat.Log("brain", "priority: " .. t.name .. " is running")
            Features.BrainOwner = t.id
            return
        end
    end
    Combat.Log("brain", "priority: nothing to do right now")
    Features.BrainOwner = nil
end

