-- BATTLE PASS ---------------------------------------------------------------------------------------
-- MainGui.BattlePass shows the day's quests (season 7 "Straw Hat Pass"):
--   Complete Dungeon   Repeats: 2/5   + 25 exp   0/1
--   Complete Portal    Repeats: 0/5   + 25 exp   0/5
--   Open Star          Repeats: 0/5   + 25 exp   0/1000000
--   Open Divine        Repeats: 0/5   + 25 exp   0/1
-- and "Quests reset in 18:34:55". Reaching a quest's goal gives its exp and the quest starts over
-- until its repeats are used up (5 a day); the reset brings a new set of quests.
-- The quests are read from the window (opened once if the game never built it), the save
-- (tables with "battlepass" / "bp" in their name) and the GetBPdata remote. Each picked quest is
-- done with the hub's own features - Dungeon = Auto Dungeon, Portal = a Gate run (Auto Gate
-- settings), Open Star / Divine = open the picked star - one after the other until its repeats
-- are full, then the hub goes back to the rest of the Priority list. The day reset starts it again.
do
local BP = {
    quests = {}, readAt = -math.huge, task = nil, since = 0, resetAt = nil, opened = 0,
    counts = {}, prev = {}, moved = {}, skipUntil = {}, data = nil, raw = nil, saveKeys = {},
}
Features.BattlePass = BP
BP.Repeats = 5   -- per quest per day (the window's "Repeats: x/5" wins when it can be read)
BP.StuckAfter = 15 * 60   -- a quest that doesn't move for this long is left alone for 30 min

-- the battle pass always has these 4 quests ("Portal" in the game = a Gate run)
BP.Kinds = {
    { "Complete Dungeon", { "dungeon" } },
    { "Complete Portal",  { "portal", "gate" } },
    { "Open Divine",      { "divine" } },
    { "Roll Passive",     { "passive", "reroll" }, optional = true },
    { "Open Star",        { "star", "egg", "open" } },
}
function BP.KindNames()
    local out = {}
    for _, k in ipairs(BP.Kinds) do out[#out + 1] = k[1] end
    return out
end
function BP.KindOf(name)
    local l = string.lower(tostring(name or ""))
    for _, k in ipairs(BP.Kinds) do
        for _, w in ipairs(k[2]) do
            if string.find(l, w, 1, true) then return k[1] end
        end
    end
    return nil
end

local function clean(s)
    s = string.gsub(tostring(s or ""), "<[^>]->", "")   -- rich text tags
    s = string.gsub(s, "%s+", " ")
    return string.match(s, "^%s*(.-)%s*$")
end
-- "CompleteDungeon" / "complete_dungeon" -> "Complete Dungeon"
local function pretty(s)
    s = string.gsub(tostring(s or ""), "[_%-]", " ")
    s = string.gsub(s, "(%l)(%u)", "%1 %2")
    return (string.gsub(clean(s), "^%l", string.upper))
end
local function num(s)
    if type(s) == "number" then return s end
    s = string.gsub(tostring(s or ""), ",", "")
    local n, suf = string.match(s, "^%s*([%d%.]+)%s*(%a?)%s*$")
    n = tonumber(n)
    if not n then return nil end
    local mult = ({ k = 1e3, m = 1e6, b = 1e9, t = 1e12 })[string.lower(suf or "")] or 1
    return n * mult
end
local function short(n)
    if not n then return "?" end
    if n >= 1e6 then return (string.gsub(string.format("%.1fM", n / 1e6), "%.0M", "M")) end
    if n >= 1e4 then return (string.gsub(string.format("%.1fK", n / 1e3), "%.0K", "K")) end
    return tostring(math.floor(n))
end
local function key(s) return string.lower((string.gsub(tostring(s or ""), "[%s_%-]", ""))) end
local function isText(o) return o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") end
local PROG = "^([%d%.,]+%a?)%s*/%s*([%d%.,]+%a?)$"
local REPS = "repeats?%s*:?%s*(%d+)%s*/%s*(%d+)"

function BP.Window()
    local mg = Data.MainGui()
    return mg and mg:FindFirstChild("BattlePass")
end

-- one quest row of the window: its name, the "x/y" progress and "Repeats: a/b"
local function readRow(row)
    local q = {}
    for _, o in ipairs(row:GetDescendants()) do
        if isText(o) then
            local t = clean(o.Text)
            local lt = string.lower(t)
            local ra, rb = string.match(lt, REPS)
            if ra then
                q.reps, q.max = tonumber(ra), tonumber(rb)
            elseif string.find(t, PROG) then
                if not q.goal then
                    local a, b = string.match(t, PROG)
                    q.prog, q.goal = num(a), num(b)
                end
            elseif string.find(t, "%a") and not string.find(lt, "exp", 1, true) and not string.find(lt, "reset", 1, true) then
                if not q.name or #t > #q.name then q.name = t end
            end
        end
    end
    return q
end

-- quests in the window + seconds until the reset (nil when not shown)
function BP.ReadGui()
    local win = BP.Window()
    if not win then return {}, nil end
    local out, seenRow, seenName, reset = {}, {}, {}, nil
    for _, o in ipairs(win:GetDescendants()) do
        if isText(o) then
            local t = clean(o.Text)
            local lt = string.lower(t)
            if not reset and string.find(lt, "reset", 1, true) then
                local clock = string.match(t, "(%d+:%d+:%d+)") or string.match(t, "(%d+:%d+)")
                local days = tonumber(string.match(lt, "(%d+)%s*d[%s%d]"))
                local secs = clock and parseClock(clock)
                if secs then reset = secs + (days or 0) * 86400 end
            elseif string.find(lt, REPS) then
                -- climb from the "Repeats" text to the row that also holds a name and an x/y
                local row = o.Parent
                for _ = 1, 4 do
                    if not row or row == win then break end
                    local q = readRow(row)
                    if q.name and q.goal then
                        local hidden = row:IsA("GuiObject") and not row.Visible
                        if not seenRow[row] and not hidden and not seenName[key(q.name)] then
                            seenRow[row], seenName[key(q.name)] = true, true
                            q.source = "window"
                            out[#out + 1] = q
                        end
                        break
                    end
                    row = row.Parent
                end
            end
        end
    end
    return out, reset
end

-- tables in the save that belong to the battle pass
function BP.SaveTables()
    local st = Data.StoreData and Data.StoreData()
    local out = {}
    if type(st) ~= "table" then return out end
    for k, v in pairs(st) do
        local lk = string.lower(tostring(k))
        if type(v) == "table" and (string.find(lk, "battlepass", 1, true) or string.find(lk, "battle_pass", 1, true)
            or string.sub(lk, 1, 2) == "bp") then
            out[tostring(k)] = v
        end
    end
    return out
end

-- quest-looking tables anywhere in `root`: a name (or its key) + progress / repeats
local function fieldOf(t, names) for _, n in ipairs(names) do if t[n] ~= nil then return t[n] end end return nil end
local function questsIn(root)
    local out, seen = {}, {}
    local function scan(t, k, depth)
        if type(t) ~= "table" or depth > 5 or seen[t] then return end
        seen[t] = true
        local name = fieldOf(t, { "Name", "DisplayName", "QuestName", "Quest", "Title", "Type", "Id" })
        local prog = tonumber(fieldOf(t, { "Progress", "Current", "Amount", "Count", "Value", "Done" }))
        local goal = tonumber(fieldOf(t, { "Goal", "Required", "Target", "Max", "Needed", "Requirement", "Total" }))
        local reps = tonumber(fieldOf(t, { "Repeats", "Repeat", "Completed", "Completions", "Times", "TimesCompleted" }))
        if type(name) ~= "string" and type(k) == "string" and (prog or reps) then name = k end
        if type(name) == "string" and (prog or reps) then
            out[#out + 1] = { name = pretty(name), prog = prog, goal = goal, reps = reps, source = "data" }
            return
        end
        for k2, v in pairs(t) do scan(v, k2, depth + 1) end
    end
    scan(root, nil, 0)
    return out
end

-- save + GetBPdata, in the background (the remote can take a few seconds to answer)
function BP.FetchData()
    if BP.fetching then return end
    BP.fetching = true
    task.spawn(function()
        local found, keys = {}, {}
        pcall(function()
            for k, t in pairs(BP.SaveTables()) do
                keys[#keys + 1] = k
                for _, q in ipairs(questsIn(t)) do found[#found + 1] = q end
            end
        end)
        -- GetBPdata (watched): { QuestData = { Dungeon = { Repeat = 2, Value = 0 }, Open = { Repeat = 1,
        --   Value = 291 }, Portal = { Repeat = 1, Value = 1 }, PassiveRoll = {...} }, QuestResetAt = <server
        --   time>, Exp = 375, CurrentSeason = 7, ClaimedRewards = {...} }. Repeat = times done today,
        --   Value = progress of the current repeat. This is the exact state, so it wins over the window.
        local ok, reply = pcall(Net.Raw, "GetBPdata", {})
        if ok and type(reply) == "table" then
            BP.raw = reply
            if type(reply.QuestData) == "table" then
                local exact = {}
                for name, v in pairs(reply.QuestData) do
                    if type(v) == "table" then
                        exact[#exact + 1] = { name = pretty(name), prog = tonumber(v.Value), reps = tonumber(v.Repeat), source = "server", exact = true }
                    end
                end
                found = exact
            else
                for _, q in ipairs(questsIn(reply)) do found[#found + 1] = q end
            end
            local resetAt = tonumber(reply.QuestResetAt)
            if resetAt then BP.serverReset = resetAt end
        end
        BP.data, BP.saveKeys, BP.fetching, BP.dataAt = found, keys, false, os.clock()
    end)
end

-- the window is only built after it was opened once: open it for a moment, then close it
function BP.OpenOnce()
    local win = BP.Window()
    local wasOpen = isShown(win)
