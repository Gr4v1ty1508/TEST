local Net = {}

local function invokeSafe(remote, args, timeout)
    local done, result = false, nil
    task.spawn(function()
        local ok, res = pcall(remote.InvokeServer, remote, table.unpack(args, 1, args.n or #args))
        if ok then result = res else warn("[" .. CFG.Name .. "] " .. remote.Name .. ": " .. tostring(res)) end
        done = true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < (timeout or 6) do task.wait() end
    return result
end

function Net.Raw(name, args)
    local r = Remotes:FindFirstChild(name)
    if not r then
        Net.Missing = Net.Missing or {}
        if not Net.Missing[name] then Net.Missing[name] = true warn("[" .. CFG.Name .. "] missing remote " .. name) end
        return nil
    end
    if r:IsA("RemoteFunction") then return invokeSafe(r, args) end
    pcall(r.FireServer, r, table.unpack(args, 1, args.n or #args))
    return nil
end

function Net.Call(key, ...)
    local e = CFG.Calls[key]
    if not e then warn("[" .. CFG.Name .. "] no CFG.Calls." .. tostring(key)) return nil end
    return Net.Raw(e[1], e[2](...))
end

function Net.Listen(name, fn)
    local r = Remotes:FindFirstChild(name)
    if r and r:IsA("RemoteEvent") then
        track(r.OnClientEvent:Connect(function(...)
            local ok, err = pcall(fn, ...)
            if not ok then warn(err) end
        end))
    end
end

-- LEARNED CALLS: when you do something by hand once (summon a dungeon, set
-- friend only, ...), the exact arguments the game sent are saved to
-- GravityHub/AFS/learned_calls.json and reused, so the script sends what the
-- game really expects instead of a guess.
local Learn = { data = nil }
Learn.Watch = { SummonDungeon = true, SetDungeonSetting = true, JoinDungeon = true, TrialShopPurchase = true, UpgradePotion = true, OpenEgg = true }
Learn.File = CFG.ConfigFolder .. "/learned_calls.json"
function Learn.Load()
    if Learn.data then return Learn.data end
    local ok, t = pcall(function()
        if not (isfile and readfile) or not isfile(Learn.File) then return {} end
        return HttpService:JSONDecode(readfile(Learn.File))
    end)
    Learn.data = (ok and type(t) == "table") and t or {}
    return Learn.data
end
-- values are saved as JSON: tables and Instances (as their path) are kept too,
-- so calls like SummonDungeon({ ... }) or SummonDungeon(worldFolder, ...) are learned
local function learnSer(v, depth)
    local t = typeof(v)
    if v == nil then return "__nil" end
    if t == "string" or t == "number" or t == "boolean" then return v end
    if t == "Instance" then return "__inst:" .. v:GetFullName() end
    if t == "EnumItem" then return "__enum:" .. tostring(v) end
    if t == "table" and depth < 4 then
        local o = {}
        for k, x in pairs(v) do
            if type(k) == "string" or type(k) == "number" then
                o[#o + 1] = { k = k, v = learnSer(x, depth + 1) }
            end
        end
        return { __tbl = o }
    end
    return "__nil"
end
local function learnDe(v)
    if v == "__nil" then return nil end
    if type(v) == "string" then
        local path = string.match(v, "^__inst:(.+)$")
        if path then
            local obj = game
            for part in string.gmatch(path, "[^%.]+") do
                obj = obj and obj:FindFirstChild(part)
            end
            return obj
        end
        local enum = string.match(v, "^__enum:Enum%.(.+)$")
        if enum then
            local ok, e = pcall(function()
                local a, b = string.match(enum, "^(.-)%.(.+)$")
                return Enum[a][b]
            end)
            return ok and e or nil
        end
        return v
    end
    if type(v) == "table" and v.__tbl then
        local o = {}
        for _, kv in ipairs(v.__tbl) do o[kv.k] = learnDe(kv.v) end
        return o
    end
    return v
end
Learn.Ser, Learn.De = learnSer, learnDe

function Learn.Record(name, args)
    local list = {}
    for i = 1, args.n do list[i] = learnSer(args[i], 0) end
    local entry = Learn.Load()[name] or {}
    entry.args, entry.n = list, args.n
    -- keep the last few different calls: what changes between them tells which
    -- argument is the artifact / size / world switch
    entry.hist = type(entry.hist) == "table" and entry.hist or {}
    local sig = HttpService:JSONEncode(list)
    local dup = false
    for _, h in ipairs(entry.hist) do if HttpService:JSONEncode(h) == sig then dup = true break end end
    if not dup then
        table.insert(entry.hist, 1, list)
        while #entry.hist > 8 do table.remove(entry.hist) end
    end
    Learn.data[name] = entry
    -- the dungeon window's "Friends Only" / "Public" button was clicked just before: remember
    -- what the game sent for it (first value), so later summons send exactly the same
    local tag = Learn.DungeonBtn
    if name == "SummonDungeon" and tag and os.clock() - tag.at < 5 and type(args[1]) == "boolean" then
        Learn.data.DungeonFlags = type(Learn.data.DungeonFlags) == "table" and Learn.data.DungeonFlags or {}
        Learn.data.DungeonFlags[tag.name] = args[1]
        Learn.DungeonBtn = nil
    end
    pcall(function()
        if not writefile then return end
        local cur = ""
        for part in string.gmatch(CFG.ConfigFolder, "[^/]+") do
            cur = cur == "" and part or (cur .. "/" .. part)
            if isfolder and makefolder and not isfolder(cur) then makefolder(cur) end
        end
        writefile(Learn.File, HttpService:JSONEncode(Learn.data))
    end)
    if Learn.OnRecord then pcall(Learn.OnRecord, name) end
end
-- returns a copy of the learned args (or nil)
function Learn.Get(name)
    local t = Learn.Load()[name]
    if type(t) ~= "table" or type(t.args) ~= "table" then return nil end
    local out, n = {}, tonumber(t.n) or #t.args
    for i = 1, n do out[i] = learnDe(t.args[i]) end
    return out, n
end
-- raw saved history (serialized form)
function Learn.History(name)
    local t = Learn.Load()[name]
    return type(t) == "table" and type(t.hist) == "table" and t.hist or {}
end

