-- Remote Spy (outgoing calls + return values, kept in SpyLog and GravityHub/AFS/spy_log.txt)
local function describe(a)
    local t = typeof(a)
    if t == "Instance" then return a:GetFullName() end
    if t == "table" then
        local ok, j = pcall(HttpService.JSONEncode, HttpService, a)
        return ok and j or tostring(a)
    end
    if t == "string" then return string.format("%q", a) end
    return t .. " " .. tostring(a)
end
local function spyWrite(line)
    SpyLog[#SpyLog + 1] = line
    if #SpyLog > 1000 then table.remove(SpyLog, 1) end
    print(line)
    if appendfile then
        pcall(function()
            Window.EnsureFolder(CFG.ConfigFolder)
            appendfile(CFG.ConfigFolder .. "/spy_log.txt", line .. "\n")
        end)
    end
end
if hookmetamethod and getnamecallmethod then
    local original
    original = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and typeof(self) == "Instance" and self.Name == "SetMounted"
           and self.Parent == Remotes and not (checkcaller and checkcaller()) then
            local state = ...
            task.defer(Features.OnGameMount, state)
        end
        if (method == "FireServer" or method == "InvokeServer") and typeof(self) == "Instance"
           and Learn.Watch[self.Name] and self.Parent == Remotes and not (checkcaller and checkcaller()) then
            local args = table.pack(...)
            task.spawn(Learn.Record, self.Name, args)
        end
        if method == "Fire" and typeof(self) == "Instance" and self.Name == "SummonDungeon"
           and self.Parent == Bindables and not (checkcaller and checkcaller()) then
            local args = table.pack(...)
            task.spawn(Learn.Record, "Bindable.SummonDungeon", args)
        end
        if Flags.RemoteSpy and Flags.RemoteSpy:Get() and not (checkcaller and checkcaller())
           and (method == "FireServer" or method == "InvokeServer") and typeof(self) == "Instance"
           and self.Parent == Remotes and not CFG.SpyIgnore[self.Name] then
            -- NOTHING that calls a method (GetFullName, IsA...) may run here before
            -- original(): it would overwrite the namecall method and the game's real
            -- call (e.g. an attack) would never be sent. Formatting happens later.
            local args, remote = table.pack(...), self
            local function head()
                local parts = {}
                for i = 1, args.n do parts[i] = "[" .. i .. "] " .. describe(args[i]) end
                return "[SPY] " .. remote.Name .. ":" .. method .. "(" .. table.concat(parts, ", ") .. ")"
            end
            if method == "InvokeServer" then
                if setnamecallmethod then setnamecallmethod(method) end
                local res = table.pack(original(self, ...))
                task.spawn(function()
                    local outs = {}
                    for i = 1, res.n do outs[i] = describe(res[i]) end
                    spyWrite(head() .. "  ->  " .. (res.n > 0 and table.concat(outs, ", ") or "nil"))
                end)
                return table.unpack(res, 1, res.n)
            end
            task.spawn(function() spyWrite(head()) end)
        end
        if setnamecallmethod then setnamecallmethod(method) end
        return original(self, ...)
    end)
end

