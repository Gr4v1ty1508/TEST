    local url = F("WebhookUrl") or ""
    if not send or url == "" then Util.Notify("No webhook / request function") return end
    local yen = "?"
    pcall(function()
        for _, s in ipairs(LP.leaderstats:GetChildren()) do if s.Name ~= "Rank" then yen = tostring(s.Value) break end end
    end)
    pcall(send, {
        Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" },
        Body = HttpService:JSONEncode({ embeds = { {
            title = title, color = 0x2B2B2F, description = "Player: ||" .. LP.Name .. "||",
            fields = {
                { name = "World", value = Util.World() ~= "" and Util.World() or "-", inline = true },
                { name = "Yen", value = yen, inline = true },
                { name = "Inf Tower Best", value = tostring(Stats.InfBest), inline = true },
