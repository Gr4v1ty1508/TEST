            if b:IsA("GuiButton") and (not win or not b:IsDescendantOf(win)) then
                local n = string.lower(b.Name .. " " .. (b.Parent and b.Parent.Name or ""))
                if string.find(n, "battlepass", 1, true) or string.find(n, "battle pass", 1, true) then
                    Features.FireGui(b, { "MouseButton1Down", "MouseButton1Click", "Activated" })
                    task.wait(1)
                    break
                end
            end
        end
    end
    local list, reset = BP.ReadGui()
    if not wasOpen then Features.OpenMenu("BattlePass", false) end
    return list, reset
end

-- the reset moment, rounded, names one "day" of quests (repeats counted by the hub live in it)
local function dayKey()
    if BP.resetAt then return tostring(math.floor((os.time() + (BP.resetAt - os.clock())) / 600)) end
    return os.date("!%Y-%m-%d")
end

-- when the window has no "Repeats" text: count a repeat each time the progress falls back
local function countRepeat(q)
    local day = dayKey()
    BP.counts[day] = BP.counts[day] or {}
    local c, k = BP.counts[day], key(q.name)
    local before = BP.prev[k]
    if before and q.prog and before.prog and q.prog < before.prog then c[k] = (c[k] or 0) + 1 end
    BP.prev[k] = { prog = q.prog }
    return c[k] or 0
end

function BP.Read(force)
    if not force and os.clock() - BP.readAt < 3 then return BP.quests end
    BP.readAt = os.clock()
    -- the day reset: forget the counts / skips, read everything again
    if BP.resetAt and os.clock() > BP.resetAt + 3 then
        BP.resetAt, BP.counts, BP.prev, BP.moved, BP.skipUntil, BP.opened, BP.allDone = nil, {}, {}, {}, {}, 0, false
        BP.serverReset, BP.data = nil, nil
        BP.FetchData()
        Util.Notify("Battle Pass: new day - new quests")
    end
    local list, reset = BP.ReadGui()
    if #list == 0 and (force or On("AutoBattlePass")) and BP.opened < 3 and (force or Util.Every("bp-open", 20)) then
        BP.opened = BP.opened + 1
        list, reset = BP.OpenOnce()
    end
    if force or Util.Every("bp-data", On("AutoBattlePass") and 10 or 30) then BP.FetchData() end
    -- the window gives names / goals / max repeats; the server data (GetBPdata) the exact progress.
    -- They're matched by kind ("Dungeon" = "Complete Dungeon", "Open" = "Open Star", ...)
    local data = BP.data or {}
    local byKind = {}
    for _, q in ipairs(list) do byKind[BP.KindOf(q.name) or key(q.name)] = q end
    for _, d in ipairs(data) do
        local kind = BP.KindOf(d.name)
        local q = kind and byKind[kind]
        if q then
            if d.exact or q.reps == nil then q.reps = d.reps or q.reps end
            if d.exact or q.prog == nil then q.prog = d.prog or q.prog end
            q.goal = q.goal or d.goal
        elseif kind then
            -- not in the window (it wasn't read): the server's entry under the hub's name
            d.name = kind
            list[#list + 1] = d
            byKind[kind] = d
        end
    end
    -- the battle pass always has its 4 quests; one the server hasn't counted yet is at 0
    if #list > 0 then
        for _, k in ipairs(BP.Kinds) do
            -- "Roll Passive" isn't in every day's set: only when the window / server shows it
            if not byKind[k[1]] and not k.optional then list[#list + 1] = { name = k[1], prog = 0, reps = 0, source = "default" } end
        end
    end
    if BP.serverReset then
        local left = BP.serverReset - serverNow()
        if left > 0 then BP.resetAt = os.clock() + left end
    elseif reset then
        BP.resetAt = os.clock() + reset
    end
    for _, q in ipairs(list) do
        q.name = pretty(q.name)
        q.kind = BP.KindOf(q.name)
        q.max = q.max or BP.Repeats
        if q.reps == nil then q.reps = countRepeat(q) end
        q.done = q.reps >= q.max
    end
    BP.quests = list
    return list
end

-- picked quests that still have repeats left today
function BP.Pending()
    local pick = F("BPQuests") or {}
    local out = {}
    for _, q in ipairs(BP.Read()) do
        if q.kind and pick[q.kind] and not q.done then out[#out + 1] = q end
    end
    return out
end

-- a quest that doesn't move for BP.StuckAfter (locked mode, no tokens ...) is skipped for 30 min
local function watch(q)
    local k = key(q.name)
    local sig = tostring(q.prog) .. ":" .. tostring(q.reps)
    local m = BP.moved[k]
    if not m or m.sig ~= sig then BP.moved[k] = { sig = sig, at = os.clock() } return end
    if os.clock() - m.at > BP.StuckAfter then
        BP.skipUntil[k] = os.clock() + 1800
        BP.moved[k] = nil
        Util.Notify("Battle Pass: " .. q.name .. " isn't moving - trying the other quests for 30 min")
    end
end
local function skipped(q)
    local u = BP.skipUntil[key(q.name)]
    return u ~= nil and os.clock() < u
end

local function force(...)
    table.clear(Forced)
    for _, f in ipairs({ ... }) do Forced[f] = true end
end
local function note(id, msg)
    if Util.Every("bp-note-" .. id, 120) then Util.Notify("Battle Pass: " .. msg) end
end

-- the star to open: Battle Pass star, else the Hatch tab's, else the first star of your farm world
function BP.Star()
    local pick = F("BPStar") or F("HatchStar")
    if type(pick) == "string" and pick ~= "" then return pick end
    local world = Data.IsFarmWorldName(Util.World()) and Util.World() or HomeWorld
    for _, s in ipairs(Data.Stars()) do
        if string.match(s, " | (.+)$") == world then return s end
    end
    return nil
end
Net.Listen("AttemptMultiOpen", function()
    BP.multiAnswerAt, BP.noMulti = os.clock(), nil
end)
function BP.Hatch()
    if BP.bagFullAt and os.clock() - BP.bagFullAt < 30 then return false end
    local pick = BP.Star()
    local starName, worldName = string.match(pick or "", "^(.-) | (.+)$")
    if not starName then note("star", "pick a star for Open Star / Divine") return false end
    if Util.World() ~= worldName then Travel.To(worldName) return true end
    local w = Worlds:FindFirstChild(worldName)
    local star = w and w:FindFirstChild(starName)
    local root = Util.Root()
    if star and root and (root.Position - star:GetPivot().Position).Magnitude > 12 then
        Util.MoveTo(star:GetPivot() * CFrame.new(0, 0, 7))
        task.wait(0.3)
    end
    -- Max Open, as Yuto Hub does it (recorded): in the star's world, AttemptMultiOpen("<StarName>")
    -- about once a second; the server answers (IN AttemptMultiOpen) every ~2 s and each answer
    -- moved the Open quest by ~5900. The game's own button also fires Bindable SetTargetEgg(star).
    -- No answer for 10 s (no Max Open) -> single opens (OpenEgg) for 5 min.
    if not (BP.noMulti and os.clock() < BP.noMulti) then
        BP.multiSince = BP.multiSince or os.clock()
        if os.clock() - math.max(BP.multiAnswerAt or 0, BP.multiSince) > 10 then
            BP.noMulti, BP.multiSince = os.clock() + 300, nil
            note("multi", "no answer to Max Open - opening one by one for 5 min")
        elseif os.clock() - (BP.multiSentAt or 0) >= 1 then
            BP.multiSentAt = os.clock()
            if BP.multiTarget ~= starName then
                BP.multiTarget = starName
                local ste = Bindables:FindFirstChild("SetTargetEgg")
                if ste and ste:IsA("BindableEvent") then pcall(ste.Fire, ste, starName) end
            end
            Net.Raw("AttemptMultiOpen", { starName, n = 1 })
        end
        return true
    end
    BP.multiSince = nil
    if Util.Every("bp-hatch", F("HatchDelay") or 1) then
        local amount = BP.MaxOpen()
        if amount <= 0 then
            local _, used, size = BP.BagSpace()
            note("bag", string.format("pet bag full (%s/%s) - Open Star / Divine waits for room", tostring(used), tostring(size)))
            BP.bagFullAt = os.clock()
            return false
        end
        Net.Call("OpenEgg", star or starName, amount)
    end
    return true
end
-- (fallback single opens) as many as still fit in your pet bag. Free space is read from:
--   1. the game's Pets window "123/500" (pets / bag size)
--   2. the save: pets in it vs. a bag-size number (a key named like Storage / MaxPets / Slots)
-- If neither can be read: the number on the game's Open button, else the most you opened by
-- hand in one go (OpenEgg is learned when you open a star yourself).
-- Bag full -> nothing is opened (the other quests go on) until there's room again.
function BP.BagSpace()
    local used, size
    pcall(function()
        local pets = mainChild("Pets")
        for _, l in ipairs(pets and pets:GetDescendants() or {}) do
            if l:IsA("TextLabel") then
                local a, b = string.match(string.gsub(l.Text, ",", ""), "^%s*(%d+)%s*/%s*(%d+)%s*$")
                a, b = tonumber(a), tonumber(b)
                if a and b and b >= 20 and a <= b + 50 and (not size or b > size) then used, size = a, b end
            end
        end
    end)
    if not size then
        pcall(function()
            local st = Data.StoreData()
            for k, v in pairs(st or {}) do
                local lk = string.lower(tostring(k))
                if type(v) == "number" and v >= 20 and (string.find(lk, "storage", 1, true) or string.find(lk, "maxpet", 1, true)
                    or string.find(lk, "petslot", 1, true) or string.find(lk, "capacity", 1, true)) then
                    size = math.max(size or 0, v)
                end
            end
            if size then used = #Data.Inventory() end
        end)
    end
    if used and size then return math.max(0, size - used), used, size end
    return nil
end
function BP.MaxOpen()
    local free = BP.BagSpace()
    if free then return math.min(free, 1000) end
    pcall(Extras.MaxHatch)
    local n = tonumber(CFG.HatchAmount.Max) or 1
    for _, h in ipairs(Learn.History("OpenEgg")) do
        local a = tonumber(h[2])
        if a and a > n and a <= 1000 then n = a end
    end
    return math.max(1, math.floor(n))
end

-- GATES (= the battle pass "Portal"), the way Yuto Hub does it (recorded):
--   AttemptTravel("TimeChamber") -> SummonGate("A", 1) -> IN GateCreated("<uuid>")
--   -> JoinGatesMode("<uuid>") + AttemptTravel("GatesMode", true, "<uuid>")
--   -> SkipGateWait() until IN GateStarted() -> clear the waves in Worlds.GatesMode.<uuid>.Enemies
--      (each wave ~150 studs further) -> IN GatesModeLost(nil, true) = over, the game sends you back
--   -> summon the next one. Every gate done = +1 on the battle pass Portal quest.
local Gate = { id = nil, createdAt = 0, started = false, overAt = 0, count = 0 }
Features.GateState = Gate
Net.Listen("GateCreated", function(id)
    Gate.id, Gate.createdAt, Gate.started = tostring(id), os.clock(), false
    Gate.count = Gate.count + 1
end)
Net.Listen("GateStarted", function()
    Gate.started = true
    for e in pairs(Combat.Skip) do Combat.Skip[e] = nil end   -- hittable now
end)
Net.Listen("GatesModeLost", function()
    Gate.id, Gate.started, Gate.overAt = nil, false, os.clock()
    if BP.data then BP.FetchData() end   -- the Portal quest just moved
end)
function Features.GateFolder()
    local gm = Worlds:FindFirstChild("GatesMode")
    return gm and Gate.id and gm:FindFirstChild(Gate.id) or nil
end
-- where the gate's room line starts: its Spawns.Spawn (seen in the recording), else its
-- PrimaryPart, else the spot we came in at
function Features.GateStart(folder)
    local sp = folder and folder:FindFirstChild("Spawns")
    sp = sp and (sp:FindFirstChild("Spawn") or sp:FindFirstChildWhichIsA("BasePart"))
    if sp and sp:IsA("BasePart") then return sp.Position end
    local pp = folder and (folder.PrimaryPart or folder:FindFirstChild("PrimaryPart"))
    if pp and pp:IsA("BasePart") then return pp.Position end
    if not Gate.inPos then local r = Util.Root() Gate.inPos = r and r.Position or Vector3.zero end
    return Gate.inPos
end
local function joinGate()
    Net.Raw("JoinGatesMode", { Gate.id, n = 1 })
    Net.Raw("AttemptTravel", { "GatesMode", true, Gate.id, n = 3 })
end
-- how many gates of a rank you have: save Items "<Rank>RankGate" (the drops are named
-- "CRankGate", "BRankGate" ...). nil = can't tell (then it's just tried)
function Features.GateItems(rank)
    local st = Data.StoreData and Data.StoreData()
    local items = type(st) == "table" and st.Items
    if type(items) ~= "table" then return nil end
    local n = items[rank .. "RankGate"] or items[rank .. "Gate"]
    if n ~= nil then return tonumber(n) or 0 end
    -- other gate items are listed but not this one: none of it (Anniversary may be named differently)
    if rank ~= "Anniversary" then
        for k in pairs(items) do if type(k) == "string" and string.find(k, "RankGate$") then return 0 end end
    end
    return nil
end
-- the picked ranks you still have, hardest first (bottom of the game's list). A rank that made
-- no gate is passed over for 10 min.
Gate.empty = {}
function Features.GateRankOrder()
    local picked = F("GateRanks") or {}
    local out = {}
    for i = #CFG.GateRanks, 1, -1 do
        local r = CFG.GateRanks[i]
        local have = Features.GateItems(r)
        if picked[r] and not (Gate.empty[r] and os.clock() < Gate.empty[r]) and (have == nil or have > 0) then out[#out + 1] = r end
    end
    return out
end
-- gate over: MainGui.GatesModeLose (results) -> press its Return button, the game sends you out
function Features.GateReturn()
    local g = mainChild("GatesModeLose")
    if not isShown(g) then return false end
    local pick
    for _, b in ipairs(g:GetDescendants()) do
        if b:IsA("GuiButton") then
            local t = string.lower(b.Name .. " " .. (b:IsA("TextButton") and b.Text or ""))
            for _, l in ipairs(b:GetDescendants()) do
                if l:IsA("TextLabel") then t = t .. " " .. string.lower(l.Text) end
            end
            if string.find(t, "return", 1, true) or string.find(t, "leave", 1, true) or string.find(t, "back", 1, true) then pick = b break end
            pick = pick or b
        end
    end
    if pick and Util.Every("gate-return", 1.5) then
        Combat.Log("gate", "gate over: pressing " .. pick.Name)
        Extras.Press(pick)
    end
    return true
end
-- one step; true = busy with a gate, false = no gate could be summoned
function Features.GateRun(amount, wanted)
    -- the end screen first (it's up while we're still in GatesMode)
    if Features.GateReturn() then return true end
    if Util.World() == "GatesMode" and not Gate.id and os.clock() - Gate.overAt < 20 then
        -- our gate is over but the Return screen didn't come / got closed: leave by ourselves
        if os.clock() - Gate.overAt > 4 and Util.Every("gate-leave", 5) then Travel.To("TimeChamber", true) end
        return true
    end
    if Util.World() == "GatesMode" then
        Gate.inAt = Gate.inAt or os.clock()
        -- the gate only takes damage after it started: hitting it before that made every enemy
        -- "no damage for 8 s -> skipped 30 s" and the character just stood there.
        -- Started = IN GateStarted, or (script loaded mid-gate) 6 s after we got in
        if not Gate.started then
            if Util.Every("gate-skip", 0.5) then Net.Raw("SkipGateWait", {}) end
            if os.clock() - Gate.inAt < 6 then
                Combat.Log("gate", "in gate " .. tostring(Gate.id) .. ", waiting for it to start")
                return true
            end
            Gate.started = true
        end
        if not Gate.cleared then
            Gate.cleared = true
            for e in pairs(Combat.Skip) do Combat.Skip[e] = nil end
        end
        -- A gate is a line of rooms; every room's enemies spawn at once, but a room only takes
        -- damage after the one before it is cleared (Yuto went room by room, ~150 studs each, away
        -- from the gate's spawn). So: always the living enemy closest to the gate's START, never
        -- the one closest to us. Only our own gate (other players' gates are in GatesMode too).
        local folder = Features.GateFolder()
        local start = Features.GateStart(folder)
        local root = Util.Root()
        local best, bestD
        for _, e in ipairs(Combat.List("GatesMode")) do
            if not folder or e:IsDescendantOf(folder) then
                local pos = Combat.Pos(e)
                if pos then
                    local d = (pos - start).Magnitude
                    -- no folder (loaded mid-gate): stay with enemies near where we came in
                    if (folder or (root and (pos - root.Position).Magnitude < 900)) and (not bestD or d < bestD) then
                        best, bestD = e, d
                    end
                end
            end
        end
        if best then
            Combat.Log("gate", string.format("gate %s: room enemy %s, %.0f studs from the start", tostring(Gate.id), Combat.Name(best), bestD))
            Combat.Attack(best, wanted)
        else
            Combat.Log("gate", "gate " .. tostring(Gate.id) .. (folder and "" or " (folder not found)") .. ": no enemy left to hit")
            -- anything skipped earlier ("no damage") gets another go
            if Util.Every("gate-unskip", 3) then for e in pairs(Combat.Skip) do Combat.Skip[e] = nil end end
        end
        return true
    end
    Gate.inAt, Gate.cleared, Gate.inPos = nil, nil, nil
    -- just over: the game is sending us back
    if os.clock() - Gate.overAt < 1.5 then return true end
    -- ours was made but we're not in yet
    if Gate.id and os.clock() - Gate.createdAt < 30 then
        if Util.Every("gate-join", 3) then joinGate() end
        return true
    end
    if not next(F("GateRanks") or {}) then
        if Util.Every("gate-pick", 60) then Util.Notify("Gate: pick the gate levels in Dungeon / Gate / Time") end
        return false
    end
    local ranks = Features.GateRankOrder()
    if #ranks == 0 then
        if Util.Every("gate-allempty", 120) then Util.Notify("Gate: no gates of the picked levels left (checking again in a few minutes)") end
        return false
    end
    if not Util.Every("gate-summon", 2) then return true end
    if Util.World() ~= "TimeChamber" then Travel.To("TimeChamber", true) end
    -- hardest rank that still makes a gate
    for _, rank in ipairs(ranks) do
        Gate.id = nil
        Net.Raw("SummonGate", { rank, amount or 1, n = 2 })
        local t0 = os.clock()
        while not Gate.id and os.clock() - t0 < 3 do task.wait(0.1) end
        if Gate.id then
            Gate.rank = rank
            task.wait(0.3)
            joinGate()
            return true
        end
        Gate.empty[rank] = os.clock() + 600
    end
    return false
end
-- Auto Gate on the same flow
function Features.Gates()
