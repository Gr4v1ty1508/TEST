-- ULTRA PERFORMANCE -------------------------------------------------------------------
-- only hides / disables visuals; nothing the script farms with (enemies, pickups,
-- prompts, timers) is destroyed, so every feature keeps working
local RunService = game:GetService("RunService")
local Perf = { on = false, conns = {}, saved = nil }

local function perfObject(o)
    if o:IsA("BasePart") then
        o.Material = Enum.Material.SmoothPlastic
        o.Reflectance = 0
        o.CastShadow = false
        if o:IsA("MeshPart") then pcall(function() o.RenderFidelity = Enum.RenderFidelity.Performance end) end
    elseif o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam") or o:IsA("Smoke")
        or o:IsA("Fire") or o:IsA("Sparkles") or o:IsA("Light") or o:IsA("Highlight") then
        o.Enabled = false
    elseif o:IsA("Explosion") then
        o.Visible = false
    elseif o:IsA("Decal") or o:IsA("Texture") then
        o.Transparency = 1
    elseif o:IsA("SurfaceAppearance") then
        o:Destroy()
    end
end

function Features.UltraPerformance(on)
    if on == Perf.on then return end
    Perf.on = on
    for _, c in ipairs(Perf.conns) do pcall(function() c:Disconnect() end) end
    Perf.conns = {}
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if on then
        Perf.saved = Perf.saved or { Shadows = Lighting.GlobalShadows, FogEnd = Lighting.FogEnd }
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
        pcall(function() if sethiddenproperty then sethiddenproperty(Lighting, "Technology", Enum.Technology.Compatibility) end end)
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 1e9
        for _, fx in ipairs(Lighting:GetChildren()) do
            pcall(function()
                if fx:IsA("PostEffect") then fx.Enabled = false
                elseif fx:IsA("Atmosphere") then fx.Density = 0 fx.Haze = 0 fx.Glare = 0 end
            end)
        end
        if terrain then
            pcall(function()
                terrain.WaterWaveSize, terrain.WaterWaveSpeed, terrain.WaterReflectance = 0, 0, 0
                terrain.Decoration = false
            end)
            local clouds = terrain:FindFirstChildOfClass("Clouds")
            if clouds then pcall(function() clouds.Enabled = false end) end
        end
        -- whole map in chunks so the game doesn't freeze while it runs
        task.spawn(function()
            local all = workspace:GetDescendants()
            for i, o in ipairs(all) do
                if not Perf.on then return end
                pcall(perfObject, o)
                if i % 1500 == 0 then task.wait() end
            end
        end)
        Perf.conns[#Perf.conns + 1] = track(workspace.DescendantAdded:Connect(function(o)
            if Perf.on then task.defer(function() pcall(perfObject, o) end) end
        end))
        Perf.conns[#Perf.conns + 1] = track(Lighting.ChildAdded:Connect(function(fx)
            pcall(function() if fx:IsA("PostEffect") then fx.Enabled = false end end)
        end))
        Util.Notify("Ultra Performance on")
    else
        if Perf.saved then
            Lighting.GlobalShadows = Perf.saved.Shadows
            Lighting.FogEnd = Perf.saved.FogEnd
        end
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic end)
        Util.Notify("Ultra Performance off - rejoin to bring back all textures / effects")
    end
end

