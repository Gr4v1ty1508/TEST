function Features.Raid()
    if Util.World() == "Raid" then
        Combat.Step("Raid", function() return On("AutoRaid") end)
        return true
    end
    if not Util.Every("raid-join", CFG.JoinCooldown) then return false end
    local active, mode
    pcall(function()
        local rd = Worlds.Raid.RaidData
        local w = rd:FindFirstChild("CurrentWorld") or rd:FindFirstChild("CurrentRaid")
        local m = rd:FindFirstChild("CurrentMode") or rd:FindFirstChild("Mode") or rd:FindFirstChild("Difficulty")
        active, mode = w and w.Value, m and m.Value
    end)
    local worlds, modes = worldsFrom("RaidWorlds"), F("RaidModes") or {}
    local worldOk = On("RaidAllWorlds") or contains(worlds, active)
    local modeOk = not next(modes) or mode == nil or modes[mode]
    if not modeOk and type(mode) == "string" then
        for m, on in pairs(modes) do
            if on and string.find(string.lower(mode), string.lower(m), 1, true) then modeOk = true break end
        end
    end
    if active and worldOk and modeOk then
        Net.Call("JoinRaid", active, mode)
        return true
    end
    return false
end

