local dungeonStep = "lobby"
function Features.Dungeon()
    if not Features.InDungeon() then
        if not Util.Every("dungeon-join", CFG.JoinCooldown) then return end
        -- 1. go to the dungeon lobby first (summon only works there)
        if Util.World() ~= "Dungeon" then
            Net.Call("DungeonLobby")
            local t0 = os.clock()
            while Util.World() ~= "Dungeon" and os.clock() - t0 < 4 do task.wait(0.1) end
            local cf = Travel.SpawnCFrame("Dungeon")
            if cf then Util.MoveTo(cf + Vector3.new(0, 4, 0)) end
            task.wait(1)
        end
        -- 2. summon with the chosen size / world, 3. join
        local size = F("DungeonSize") or "Small"
        local world = Data.FromLabel(F("DungeonWorld") or "")
        Net.Call("SummonDungeon", CFG.DungeonSizeArg[size] or size, world, On("DungeonArtifact"))
        task.wait(1.5)
        Net.Call("JoinDungeon")
        -- 4. if the game uses a prompt / portal to enter, use it too
        for _, p in ipairs(Prompt.Find(Worlds:FindFirstChild("Dungeon"), { "dungeon", "enter", "join", "start" })) do
            Prompt.Use(p)
            break
        end
        dungeonStep = "joining"
        return
    end
    dungeonStep = "inside"
    if Combat.Step(Util.World(), function() return On("AutoDungeon") end) then return end
    local root = Worlds:FindFirstChild("Dungeon") or Worlds:FindFirstChild(Util.World())
    if not On("DungeonIgnoreChest") then
        for _, p in ipairs(Prompt.Find(root, { "chest", "treasure" })) do
            Prompt.Use(p)
            Net.Call("OpenChest", p.Parent)
            task.wait(0.3)
        end
    end
    if Util.Every("dungeon-door", 3) then
        local door = Prompt.Find(root, { "door", "next", "open", "portal" })[1]
        if door then
            Prompt.Use(door)
            Net.Call("OpenDungeonDoor", door.Parent)
        end
    end
end
