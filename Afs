        PlaceholderColor3 = Theme.Dim, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.Text,
        ClearTextOnFocus = false, TextTruncate = Enum.TextTruncate.AtEnd, Parent = r },
        { corner(6), stroke(), padding(8, 8, 0, 0) })
    local obj = { Type = "Input" }
