    local r = row(self, 36)
    text({ Text = opt.Title, TextColor3 = Theme.Sub, Size = UDim2.new(0.45, 0, 1, 0), Parent = r })
    local btn = make("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0.55, -8, 0, 28), BackgroundColor3 = Theme.Window, Text = "", AutoButtonColor = false,
        Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.Text, Parent = r }, { corner(6), stroke() })
    local obj = { Type = "Keybind" }
