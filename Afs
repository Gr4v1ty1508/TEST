-- MainGui child by dotted path: "Pets.TeamsList.Main.Scroll"
local function mainChild(path)
    local obj = Data.MainGui()
    for part in string.gmatch(path, "[^%.]+") do
        if not obj then return nil end
        obj = obj:FindFirstChild(part)
    end
    return obj
end
local function isShown(g) return g ~= nil and g:IsA("GuiObject") and g.Visible end

-- press a game button ONCE (first handler only, like a real click)
local function pressOnce(btn)
    if not btn then return false end
    if not btn:IsA("GuiButton") then btn = btn:FindFirstChildWhichIsA("GuiButton", true) end
    if not btn then return false end
    for _, sig in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down" }) do
        local ok, signal = pcall(function() return btn[sig] end)
        if ok and signal then
            if getconnections then
                local okc, conns = pcall(getconnections, signal)
                if okc and conns and #conns > 0 then
                    pcall(function() conns[1]:Fire() end)
                    return true
                end
            elseif firesignal then
                pcall(firesignal, signal)
                return true
            end
        end
    end
    return false
end
