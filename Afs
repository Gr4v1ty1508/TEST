-- Remote Spy (outgoing calls + return values, kept in SpyLog and GravityHub/AFS/spy_log.txt)
local function describe(a)
    local t = typeof(a)
    if t == "Instance" then return a:GetFullName() end
    if t == "table" then
        local ok, j = pcall(HttpService.JSONEncode, HttpService, a)
        return ok and j or tostring(a)
    end
    if t == "string" then return string.format("%q", a) end
    return t .. " " .. tostring(a)
end
local function spyWrite(line)
    SpyLog[#SpyLog + 1] = line
    if #SpyLog > 400 then table.remove(SpyLog, 1) end
    print(line)
    if appendfile then
        pcall(function()
            Window.EnsureFolder(CFG.ConfigFolder)
            appendfile(CFG.ConfigFolder .. "/spy_log.txt", line .. "\n")
        end)
    end
end
if hookmetamethod and getnamecallmethod then
    local original
    original = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if Flags.RemoteSpy and Flags.RemoteSpy:Get() and not (checkcaller and checkcaller())
           and (method == "FireServer" or method == "InvokeServer") and typeof(self) == "Instance"
           and self.Parent == Remotes and self.Name ~= "ClickerDamage" then
            local args = table.pack(...)
            local parts = {}
            for i = 1, args.n do parts[i] = "[" .. i .. "] " .. describe(args[i]) end
            local head = "[SPY] " .. self.Name .. ":" .. method .. "(" .. table.concat(parts, ", ") .. ")"
            if method == "InvokeServer" then
                local res = table.pack(original(self, ...))
                local outs = {}
                for i = 1, res.n do outs[i] = describe(res[i]) end
                task.spawn(spyWrite, head .. "  ->  " .. (res.n > 0 and table.concat(outs, ", ") or "nil"))
                return table.unpack(res, 1, res.n)
            end
            task.spawn(spyWrite, head)
        end
        return original(self, ...)
    end)
end

