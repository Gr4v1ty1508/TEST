-- world + quest entry of the quest on screen
function Quest.Find()
    local title = Quest.Title()
    local qd = Data.Module("QuestData")
    if not title or not qd then return nil end
    for w, info in pairs(qd) do
        if type(info) == "table" and type(info.Quests) == "table" then
            for i, q in pairs(info.Quests) do
                if type(q) == "table" and q.DisplayName == title then return w, q, i end
            end
        end
    end
    return nil
end
function Quest.ReadyToTurnIn()
    local f = Quest.Frame()
    local b = f and f:FindFirstChild("TurnIn")
    if isShown(b) then return b end
    -- every objective box checked
    local obj = f and f:FindFirstChild("Objectives")
    local any, all = false, true
    for _, o in ipairs(obj and obj:GetChildren() or {}) do
        if o:IsA("TextLabel") then
            any = true
            local done, total = string.match(o.Text, "%[(%d+)/(%d+)%]")
            if not done or tonumber(done) < tonumber(total) then all = false end
        end
    end
    return (any and all) and true or nil
end
-- mobs to kill for the quest on screen (model names from QuestData + names from the text)
function Features.QuestTargets()
    if not Quest.Active() then return nil, nil end
    local w, q = Quest.Find()
    local set = {}
    for name in pairs(q and q.Targets or {}) do set[tostring(name)] = true end
    local obj = Quest.Frame():FindFirstChild("Objectives")
    for _, o in ipairs(obj and obj:GetChildren() or {}) do
        if o:IsA("TextLabel") then
            local done, total, what = string.match(o.Text, "%[(%d+)/(%d+)%]%s*Kill%s+%d+%s+(.-)s?$")
            if what and tonumber(done) < tonumber(total) then set[what] = true end
        end
    end
    return w, set
end

-- the quest NPC of a world (QuestData[world].DisplayName, e.g. "Birdie") and its prompt
function Quest.GiverPrompt(world)
    local qd = Data.Module("QuestData")
    local npcName = qd and type(qd[world]) == "table" and qd[world].DisplayName
    local folder = Worlds:FindFirstChild(world or "")
    if not folder then return nil end
    for _, p in ipairs(folder:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Enabled then
            local m = p:FindFirstAncestorOfClass("Model")
            local hay = string.lower((m and m.Name or "") .. " " .. p.ObjectText .. " " .. p.ActionText)
            if (npcName and m and (m.Name == npcName or string.find(hay, string.lower(npcName), 1, true)))
                or string.find(hay, "quest", 1, true) then
                return p
            end
        end
    end
    return nil
end

function Features.Quest()
    local world = Util.World()
    if not Data.IsFarmWorldName(world) then return end
    if Quest.lastWorld ~= world then Quest.lastWorld, Quest.startTries = world, 0 end

    if Quest.Active() then
        Quest.startTries = 0
        local ready = Quest.ReadyToTurnIn()
        if ready and Util.Every("quest-turnin", 3) then
            if typeof(ready) == "Instance" then Extras.Press(ready) end
            Net.Call("FinishQuest", world)
        elseif On("SkipQuest") and Util.Every("quest-skip", 15) then
            Net.Call("SkipQuest")
        end
        return
    end

    -- no quest on screen: ask for one (remote, then the NPC's prompt)
    if not Util.Every("quest-start", 6) then return end
    Quest.startTries = Quest.startTries + 1
    Net.Call("FinishQuest", world)
    Net.Call("StartQuest", world)
    if Quest.startTries >= 2 then
        local p = Quest.GiverPrompt(world)
        if p then Prompt.Use(p) end
    end
    -- nothing after several tries: this world's quests are done
    if Quest.startTries >= 5 and On("NextQuestWorld") then
        Quest.startTries = 0
        local order, discovered = Data.FarmWorlds(), LP:FindFirstChild("Discovered")
        for i, w in ipairs(order) do
            if w == world then
                local nxt = order[i + 1]
                if nxt then Travel.To(nxt) end
                break
            end
        end
    end
end

-- DUNGEON (open it like a player) -------------------------------------------------------------------
-- The dungeon door is in the Tower lobby: Worlds.Tower.DungeonDoor.MainDoor has the "Open"
-- prompt. It shows MainGui.DungeonSummon: ConfigButton -> Config.Main.Worlds.<world> ->
-- Close ("Confirm"), then "Public" or "Friends Only". MainGui.DungeonTravel then asks
-- "enter this dungeon?" -> Yes. Pressing the game's own buttons means we send exactly
-- what the game sends. If the window never shows up, the learned-remote way is used.
local DungeonGui = {}
function DungeonGui.Door()
    local tower = Worlds:FindFirstChild("Tower")
    return tower and tower:FindFirstChild("DungeonDoor")
end
function DungeonGui.Prompt()
    local door = DungeonGui.Door()
    if not door then return nil end
    for _, p in ipairs(door:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Enabled then return p end
    end
    return nil
end
-- stand in front of the door (toward the lobby spawn)
function DungeonGui.GoToDoor()
    if Util.World() ~= "Tower" then
        Travel.To("Tower", true)
        local t0 = os.clock()
        while Util.World() ~= "Tower" and os.clock() - t0 < 5 do task.wait(0.2) end
    end
    local door = DungeonGui.Door()
    local main = door and door:FindFirstChild("MainDoor")
    if not main then return false end
    local spawn = Worlds.Tower:FindFirstChild("Spawns") and Worlds.Tower.Spawns:FindFirstChildWhichIsA("BasePart")
    local toward = spawn and (spawn.Position - main.Position) or Vector3.new(1, 0, 0)
    toward = Vector3.new(toward.X, 0, toward.Z)
    if toward.Magnitude < 1 then toward = Vector3.new(1, 0, 0) end
    local pos = main.Position + toward.Unit * 9
    local y = spawn and spawn.Position.Y + 4 or main.Position.Y - 8
    Util.MoveTo(CFrame.new(Vector3.new(pos.X, y, pos.Z), Vector3.new(main.Position.X, y, main.Position.Z)))
    task.wait(0.4)
    return true
end
function DungeonGui.Window() return mainChild("DungeonSummon") end
function DungeonGui.WaitShown(g, secs)
    local t0 = os.clock()
    while os.clock() - t0 < (secs or 3) do
        if isShown(g) then return true end
        task.wait(0.1)
    end
    return false
end
function DungeonGui.PickWorld(world)
    local win = DungeonGui.Window()
    local cfgBtn = win and win:FindFirstChild("ConfigButton", true)
    if not cfgBtn then return false end
    Extras.Press(cfgBtn)
    local cfg = win:FindFirstChild("Config")
    if not DungeonGui.WaitShown(cfg, 2) then return false end
    local list = cfg:FindFirstChild("Worlds", true)
    local entry = list and list:FindFirstChild(world)
    if entry then Extras.Press(entry) task.wait(0.3) end
    local confirm = cfg:FindFirstChild("Close", true)
    if confirm then Extras.Press(confirm) end
    task.wait(0.3)
    return entry ~= nil
end

local baseOpenDungeon = Features.OpenDungeon
-- the Yuto Hub way (watched in game): EquipArtefact("Dungeon", "CurrentArtefact") then
-- SummonDungeon(true, { Size = <1-5>, Theme = <world> }), repeated until it opens.
-- The game's window (door prompt -> Public / Friends) is kept as a fallback.
function DungeonGui.SummonDirect()
    local world = Data.FromLabel(F("DungeonWorld") or "")
    if world == "" then
        if Util.Every("dungeon-world-pick", 60) then Util.Notify("Dungeon: pick a world first") end
        return false
    end
    local sizeIndex = table.find(CFG.DungeonSizes, F("DungeonSize") or "Small") or 1
    if On("DungeonArtifact") then Features.EquipOpenArtifact() end
    -- first value: Yuto Hub sends true; "Friend Only" off sends true too, on sends false
    local flag = not On("DungeonFriends")
    if CFG.DungeonSummonFlag ~= nil then flag = CFG.DungeonSummonFlag end
    Net.Call("SummonDungeon", flag, sizeIndex, world)
    Features.LastSummon = { source = "direct (Yuto Hub args)", artifact = "-", at = os.clock() }
    return true
end
function Features.OpenDungeon()
    -- a summon was just sent: only try to get in (DungeonTravel popup / JoinDungeon)
    if os.clock() < (DungeonGui.waitUntil or 0) then
        local dt = mainChild("DungeonTravel")
        if isShown(dt) then Extras.Press(dt:FindFirstChild("Yes", true)) end
        if Util.Every("dungeon-rejoin", 5) then
            Net.Raw("JoinDungeon", Learn.Get("JoinDungeon") or {})
            -- the door's teleporter (DungeonDoor.Teleporter.TriggerPart), like walking in
            local door = DungeonGui.Door()
            local trig = door and door:FindFirstChild("TriggerPart", true)
            local root = Util.Root()
            if trig and root and Util.World() == "Tower" then
                Util.MoveTo(trig.CFrame)
                if firetouchinterest then
                    pcall(firetouchinterest, root, trig, 0) task.wait(0.1) pcall(firetouchinterest, root, trig, 1)
                end
            end
        end
        return
    end
    -- 1. direct summon (every 1.5 s, like Yuto Hub) for up to 6 tries
    DungeonGui.directTries = DungeonGui.directTries or 0
    if DungeonGui.directTries < 6 then
        if not Util.Every("dungeon-direct", 1.5) then return end
        if Util.World() ~= "Tower" then Travel.To("Tower", true) end
        if DungeonGui.SummonDirect() then
            DungeonGui.directTries = DungeonGui.directTries + 1
            task.wait(0.8)
            local dt = mainChild("DungeonTravel")
            if isShown(dt) then
                Extras.Press(dt:FindFirstChild("Yes", true))
                DungeonGui.waitUntil, DungeonGui.directTries = os.clock() + 30, 0
            end
        end
        return
    end
    DungeonGui.directTries = 0
    -- 2. the game's window through the door
    if DungeonGui.failed and DungeonGui.failed >= 3 then DungeonGui.failed = 0 return baseOpenDungeon() end

    if On("DungeonArtifact") then Features.EquipOpenArtifact() end
    if not DungeonGui.GoToDoor() then DungeonGui.failed = (DungeonGui.failed or 0) + 1 return end
    local prompt = DungeonGui.Prompt()
    if prompt then Prompt.Use(prompt) end
    local win = DungeonGui.Window()
    if not DungeonGui.WaitShown(win, 3) then
        DungeonGui.failed = (DungeonGui.failed or 0) + 1
        if DungeonGui.failed >= 3 then Util.Notify("Dungeon window didn't open - using the remote way") end
        return
    end
    DungeonGui.failed = 0
    local world = Data.FromLabel(F("DungeonWorld") or "")
    if world ~= "" and not DungeonGui.PickWorld(world) and Util.Every("dungeon-world-note", 120) then
        Util.Notify("Dungeon: " .. world .. " isn't in the game's dungeon world list")
    end
    local btn = win:FindFirstChild(On("DungeonFriends") and "Friends" or "Public", true)
    if not btn then Util.Notify("Dungeon: Public / Friends button not found") return end
    Extras.Press(btn)
    Features.LastSummon = { source = "game window", artifact = "-", at = os.clock() }
    DungeonGui.waitUntil = os.clock() + 30
    task.wait(1)
    local dt = mainChild("DungeonTravel")
    if DungeonGui.WaitShown(dt, 4) then Extras.Press(dt:FindFirstChild("Yes", true)) end
end

