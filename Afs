-- HATCH / FUSE ------------------------------------------------------------------------------
function Features.Hatch()
    local pick = F("HatchStar")
    if not pick then return end
    local starName, worldName = string.match(pick, "^(.-) | (.+)$")
    if not starName then return end
    local modes = F("HatchModes") or {}
    local amount = modes["Summon Max Star"] and CFG.HatchAmount.Max
        or modes["Summon Multiple Star"] and CFG.HatchAmount.Multiple or CFG.HatchAmount.Single
    -- the game only opens a star in the world it's in. Moving there needs the character, so it
    -- waits for its turn in the Priority list (Brain sets Features.BrainOwner = "Hatch")
    local needMove = Util.World() ~= worldName
    if not needMove and On("HatchTp") then
        local w = Worlds:FindFirstChild(worldName)
        local star = w and w:FindFirstChild(starName)
        local root = Util.Root()
        needMove = star ~= nil and root ~= nil and (root.Position - star:GetPivot().Position).Magnitude > 12
    end
    if needMove then
        Features.HatchWantAt = os.clock()
        if Features.BrainOwner ~= "Hatch" then return end
    end
    if Util.World() ~= worldName then Travel.To(worldName) end
    if On("HatchTp") then
        local w = Worlds:FindFirstChild(worldName)
        local star = w and w:FindFirstChild(starName)
        local root = Util.Root()
        if star and root then
            local pivot = star:GetPivot()
            if (root.Position - pivot.Position).Magnitude > 12 then Util.MoveTo(pivot * CFrame.new(0, 0, 7)) task.wait(0.3) end
        end
    end
    Features.HatchWantAt = os.clock()
    local w = Worlds:FindFirstChild(worldName)
    -- "Summon Max Star" = the game's Max Open, the way Yuto Hub does it (recorded, same setting):
    -- AttemptMultiOpen("<StarName>") once per Delay; the game's own button also fires
    -- Bindable SetTargetEgg(star) first. Server answers ~every 2 s (thousands of stars each).
    if modes["Summon Max Star"] then
        if Features.HatchTarget ~= starName then
            Features.HatchTarget = starName
            local ste = Bindables:FindFirstChild("SetTargetEgg")
            if ste and ste:IsA("BindableEvent") then pcall(ste.Fire, ste, starName) end
        end
        Net.Raw("AttemptMultiOpen", { starName, n = 1 })
        return
    end
    Net.Call("OpenEgg", (w and w:FindFirstChild(starName)) or starName, amount)
end

function Data.PetTypes()
