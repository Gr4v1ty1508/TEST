-- in the middle of a run of this kind: finish it before switching quests
function BP.Inside(kind)
    local w = Util.World()
    if kind == "Complete Dungeon" then return Features.InDungeon() end
    if kind == "Complete Portal" then return w == "GatesMode" or (Gate.id ~= nil and os.clock() - Gate.createdAt < 30) end
    return false
