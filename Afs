local function loop(interval, fn)
    task.spawn(function()
        while true do
            local ok, err = pcall(fn)
            if not ok then warn("[" .. CFG.HubName .. "] " .. tostring(err)) task.wait(1) end
            task.wait(interval)
        end
    end)
end

