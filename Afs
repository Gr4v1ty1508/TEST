-- the team's UIDs from the save (GameData.PetTeams[i] = { Name, UIDs = { ... } })
-- (only pets you still own count: a fused / deleted pet can't go on)
function Extras.TeamUIDs(name)
    local st = Data.StoreData()
    local owned = nil
    if st and type(st.Pets) == "table" then
        owned = {}
        for _, p in pairs(st.Pets) do if type(p) == "table" and p.UID then owned[tostring(p.UID)] = true end end
    end
    for _, t in pairs(st and type(st.PetTeams) == "table" and st.PetTeams or {}) do
        if type(t) == "table" and t.Name == name and type(t.UIDs) == "table" then
            local set, n = {}, 0
            for _, uid in pairs(t.UIDs) do
                local k = tostring(uid)
                set[k] = true
                if not owned or owned[k] then n = n + 1 end
            end
            return set, n
        end
    end
    return nil, 0
end
-- did the team really go on? every equipped pet belongs to the team, and every pet of the team
-- is on. A team is saved with its own Title, and "Mystical Oracle" gives +1 pet slot
-- (TitleData EquipAmount): teams saved with it hold 23 pets, the others 22 - when the pets go
-- on before the title, the 23rd is missing and the second press puts it on.
-- Not right -> press the team again (2 more tries), then tell the player.
function Extras.CheckTeam()
    local c = Extras.TeamCheck
    if not c then return end
    local set, teamN = Extras.TeamUIDs(c.name)
    if not set then Extras.TeamCheck = nil return end   -- can't read the team: nothing to compare
    local pets, wrong = Data.EquippedPets(), 0
    for _, m in ipairs(pets) do
        local uid = Data.PetUID(m)
        if uid and not set[uid] then wrong = wrong + 1 end
    end
    local want = teamN
    if wrong == 0 and #pets >= want then
        Extras.TeamCheck = nil
        return true
    end
    if c.tries >= 2 then
        Extras.TeamCheck = nil
        Util.Notify(string.format("Team %s: %d/%d pets on (%d not in the team) after 3 tries", c.name, #pets - wrong, want, wrong))
        return false
    end
    c.tries, c.at = c.tries + 1, os.clock()
    local btn = Extras.TeamButtons()[c.name]
    if btn then pressOnce(btn) end
    return false
end
-- which saved team fits what we're doing right now
