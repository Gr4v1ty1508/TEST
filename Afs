                text({ Text = title, Font = Enum.Font.GothamMedium, TextSize = 16, Size = UDim2.new(1, 0, 0, 26),
                    LayoutOrder = 0, Parent = frame })
            end
            local card = setmetatable({ Body = frame, _order = 0 }, Elements)
