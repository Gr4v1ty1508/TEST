-- MOUNT -------------------------------------------------------------------------------
local MountAssets = RS:FindFirstChild("ReplicatedAssets") and RS.ReplicatedAssets:FindFirstChild("Mounts")
-- true / false when we can tell, nil when nothing tells us
function Features.IsMounted()
    local m = LP:FindFirstChild("Mounting")
    if m then
        if m:IsA("BoolValue") then return m.Value end
        -- a StringValue here is the EQUIPPED mount's name (e.g. "ReZero"), not "riding or not"
        if m:IsA("IntValue") or m:IsA("NumberValue") then return m.Value ~= 0 end
        if m:IsA("ObjectValue") then return m.Value ~= nil end
    end
    local hum, char = Util.Humanoid(), LP.Character
    if hum and (hum.Sit or hum.SeatPart) then return true end
    if char and MountAssets then
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Model") and MountAssets:FindFirstChild(c.Name) then return true end
        end
    end
    return nil
end

-- The game mounts you on YOUR side (its own client script) and then tells the
-- server with SetMounted(true / false). So we:
--   * read the real state from the game's own SetMounted calls (hooked below)
--   * mount the same way the mount button does (Bindable.ToggleMount), and only
--     when we know you're off, so it can't flip back and forth
Features.MountState = nil   -- true / false once the game has told us
local lastMountCall, mountBlockUntil, mountCalls = 0, 0, {}
local baseIsMounted = Features.IsMounted
function Features.IsMounted()
    if Features.MountState ~= nil then return Features.MountState end
    return baseIsMounted()
end
local function pressMount()
    local tm = Bindables:FindFirstChild("ToggleMount")
    if tm and tm:IsA("BindableEvent") then pcall(tm.Fire, tm) return end
    if tm and tm:IsA("BindableFunction") then task.spawn(pcall, tm.Invoke, tm) return end
    local mg = Data.MainGui()
    local frame = mg and mg:FindFirstChild("MountButtonFrame")
    local b = frame and frame:FindFirstChildWhichIsA("GuiButton", true)
    if b then fireGui(b, { "MouseButton1Down", "MouseButton1Click", "Activated" }) end
end
function Features.Mount()
    if not On("AutoMount") or os.clock() < mountBlockUntil then return end
    if Features.IsMounted() == true then return end
    local now = os.clock()
    if now - lastMountCall < 1.5 then return end          -- wait for the game to answer the last press
    for k = #mountCalls, 1, -1 do if now - mountCalls[k] > 20 then table.remove(mountCalls, k) end end
    if #mountCalls >= 4 then
        mountBlockUntil = now + 30
        Util.Notify("Auto Mount paused 30s (can't stay mounted here)")
        return
    end
    mountCalls[#mountCalls + 1] = now
    lastMountCall = now
    pressMount()
end
-- called by the hook whenever the game sends SetMounted
function Features.OnGameMount(state)
    Features.MountState = state == true
    if not Features.MountState then task.delay(0.3, Features.Mount) end   -- got off -> back on
end
pcall(function()
    track(LP.CharacterAdded:Connect(function() Features.MountState = false task.delay(2, Features.Mount) end))
    track(LP:WaitForChild("World", 5).Changed:Connect(function() task.delay(2, Features.Mount) end))
end)

-- TIME TRIAL / TOWER ----------------------------------------------------------------
local trialIndex = 0
local trialForm, lastTrialTry = nil, nil
local trialDoorId = nil   -- door number of the trial we joined
local trialJoinedAt = 0
function Features.TimeTrial()
    local world = Util.World()
    if world == "Tower" then
        if lastTrialTry and not trialForm then trialForm = lastTrialTry end
        local wanted = function() return On("AutoTrial") end
        local trialName = Stats.TrialName
        if On("AutoLeaveTrial") and trialName then
            local limit = F("Leave_" .. trialName)
            if limit and Stats.TrialFloor >= limit then
                Util.Notify("Leaving " .. trialName .. " at floor " .. Stats.TrialFloor)
                Travel.To(HomeWorld ~= "" and HomeWorld or Data.FarmWorlds()[1])
                return true
            end
        end
        -- our door just opened: walk into its teleporter to get into the run
        if Features.EnterTrialDoor() then return true end
        local tower = Worlds:FindFirstChild("Tower")
        local trials = Util.SetToList(F("Trials"))
        -- LOBBY (not in a run): only wait at / join the door. The Tower is also the lobby
        -- of the dungeon and Infinity Tower, so nothing else is done here.
        if not Features.InTrialRun() then
            if #trials > 0 then Features.TryJoinTrial(trials) end
            return os.clock() - trialJoinedAt < 75   -- waiting at our door, else let other modes run
        end
        -- 1. fight what's in our room (only near us: every player's run is in the same map)
        -- (Tower.Enemies only holds the enemies of YOUR run - seen in a dump taken in a run -
        --  so like Yuto Hub: warp to the nearest one, wherever it is)
        local noChest = On("TrialIgnoreChest") and function(e)
            return string.find(string.lower(e.Name .. " " .. Combat.Name(e)), "chest", 1, true) ~= nil
        end or nil
        if Combat.Step("Tower", wanted, nil, F("TrialTarget") or "Nearest", 3000, noChest) then return true end
        -- 2. every 5th room is a RestRoom: press its ConfirmPart "Clear Rooms" prompt ONCE
        --    (Yuto Hub does exactly this; ~10 s later the server opens the next room)
        if Features.PressNextRoom() then return true end
        -- 3. nothing to do: wait here. The server moves the run on by itself
        --    (SetTowerFloor) when a room's enemies are dead - no walking needed.
        Features.TrialLog("room " .. tostring(Stats.TrialFloor or "?") .. ": no enemies yet, waiting")
        Features.DumpTowerOnce()
        return true
    end
    local trials = Util.SetToList(F("Trials"))
    if #trials == 0 then return false end
    if CFG.ModeWorlds[world] == nil then HomeWorld = world end
    -- each trial door has its own countdown; join a selected one only in its last
    -- CFG.TrialGoAt seconds, keep farming elsewhere until then
    if os.clock() - trialJoinedAt < 75 then return true end   -- at the door, waiting for the start
    Features.TryJoinTrial(trials)
    return os.clock() - trialJoinedAt < 75
end

-- seconds until the next time trial starts, from the countdown board in the
-- Tower ("1:23", "01:02:03", "45s", "1m 5s"). Remembers the start time so it
-- still knows when the board isn't loaded (you're in another world).
local trialStartsAt = nil
local function parseClock(t)
    if type(t) ~= "string" then return nil end
    local h, m, sec = string.match(t, "(%d+):(%d+):(%d+)")
    if h then return tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(sec) end
    m, sec = string.match(t, "(%d+):(%d+)")
    if m then return tonumber(m) * 60 + tonumber(sec) end
    local mm, ss = string.match(t, "(%d+)%s*m"), string.match(t, "(%d+)%s*s")
    if mm or ss then return (tonumber(mm) or 0) * 60 + (tonumber(ss) or 0) end
    return nil
end
function Features.TrialCountdown()
    local ok, txt = pcall(function() return Worlds.Tower.Countdown.SurfaceGui.Background.Time.Text end)
    local secs = ok and parseClock(txt) or nil
    if secs then
        trialStartsAt = os.clock() + secs
        return secs
    end
    if trialStartsAt and trialStartsAt - os.clock() > -5 then return trialStartsAt - os.clock() end
    return nil
end

-- current trial room number, read from the "Room N" text on screen
-- the "Room N" label is found once (PlayerGui has thousands of objects) and then just read
local roomLabel, roomLabelScan = nil, -math.huge
function Features.CurrentRoom()
    -- the game's own counter: MainGui.TowerTimer.CurrentFloor ("Room") .Value ("7")
    local mg = Data.MainGui()
    local tt = mg and mg:FindFirstChild("TowerTimer")
    if tt and tt:IsA("GuiObject") and tt.Visible then
        local cf = tt:FindFirstChild("CurrentFloor")
        local v = cf and cf:FindFirstChild("Value")
        local n = v and v:IsA("TextLabel") and tonumber(string.match(v.Text, "(%d+)"))
        if n then return n end
    end
    if roomLabel and roomLabel.Parent then
        if roomLabel.Visible then
            local n = string.match(roomLabel.Text, "^%s*Room%s*(%d+)%s*$")
            if n then return tonumber(n) end
        end
        return nil
    end
    if os.clock() - roomLabelScan < 3 then return nil end
    roomLabelScan = os.clock()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return nil end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextLabel") then
            local n = string.match(d.Text, "^%s*Room%s*(%d+)%s*$")
            if n then
                roomLabel = d
                return d.Visible and tonumber(n) or nil
            end
        end
    end
    return nil
end

-- middle of the current room: a model / folder in the Tower named like "Room1",
-- "Room 1", "Room_1" or "1" inside a Rooms folder. nil if the map doesn't have one.
local roomCache = {}
local function centerOf(obj)
    if not obj then return nil end
    if obj:IsA("Model") then
        local ok, cf = pcall(obj.GetBoundingBox, obj)
        if ok and cf then return cf.Position end
        local ok2, pv = pcall(obj.GetPivot, obj)
        return ok2 and pv.Position or nil
    end
    if obj:IsA("BasePart") then return obj.Position end
    return nil
end
function Features.RoomCenter()
    local n = Features.CurrentRoom()
    local tower = Worlds:FindFirstChild("Tower")
    if not tower then return nil end
    -- room 1: the door we joined points at its run's first room (Door<n>.StartRoom)
    if n == 1 and trialDoorId then   -- only once the run has started (never from the lobby)
        local door = Features.DoorModel(trialDoorId)
        local sr = door and door:FindFirstChild("StartRoom")
        local c = sr and sr:IsA("ObjectValue") and centerOf(sr.Value)
        if c then return c end
    end
    if not n then return nil end
    local hit = roomCache[n]
    if hit == false and os.clock() - (roomCache["miss" .. n] or 0) < 15 then return nil end
    if not hit or not hit.Parent then
        hit = nil
        for _, d in ipairs(tower:GetDescendants()) do
            if d:IsA("Model") or d:IsA("Folder") then
                local num = string.match(d.Name, "^[Rr]oom[%s_]*(%d+)$")
                    or (d.Parent and string.find(string.lower(d.Parent.Name), "room", 1, true) and string.match(d.Name, "^(%d+)$"))
                if num and tonumber(num) == n then hit = d break end
            end
        end
        roomCache[n] = hit or false
        if not hit then roomCache["miss" .. n] = os.clock() end
    end
    if not hit then return nil end
    if hit:IsA("Model") then
        local ok, cf = pcall(hit.GetBoundingBox, hit)
        if ok and cf then return cf.Position end
        local ok2, pv = pcall(hit.GetPivot, hit)
        return ok2 and pv.Position or nil
    end
    local sum, count = Vector3.zero, 0
    for _, p in ipairs(hit:GetDescendants()) do
        if p:IsA("BasePart") then sum, count = sum + p.Position, count + 1 end
    end
    return count > 0 and sum / count or nil
end

-- TRIAL RUN WALKER --------------------------------------------------------------------------
-- What a run looks like (from a dump taken inside a run): Tower.Map holds the rooms
--   StartRoom  { Teleporter, Map }                       first room of every run
--   BattleRoom { EnemySpawners, Door, StageConnectorBack / Front, SafetyFloor, BasePart }
--   RestRoom   { Teleporter, StageConnectorBack, SafetyFloor, Map }   every 5th room
-- rooms of one run are chained (Back -> Front); enemies are in Tower.Enemies.
-- Start / rest rooms move the run on through their Teleporter (like the lobby doors);
-- a cleared battle room lets you on to the next room in front of it.
local trialVisited = setmetatable({}, { __mode = "k" })
local trialLogLast = nil
function Features.TrialLog(msg)
    if msg == trialLogLast then return end
    trialLogLast = msg
    local root = Util.Root()
    local line = os.date("%H:%M:%S") .. "  " .. msg .. (root and string.format("   @ (%.0f, %.0f, %.0f)", root.Position.X, root.Position.Y, root.Position.Z) or "")
    Features.TrialStatus = msg
    if appendfile then
        pcall(function()
            if isfolder and makefolder and not isfolder(CFG.ConfigFolder) then
                local cur = ""
                for part in string.gmatch(CFG.ConfigFolder, "[^/]+") do
                    cur = cur == "" and part or (cur .. "/" .. part)
                    if not isfolder(cur) then makefolder(cur) end
                end
            end
            appendfile(CFG.ConfigFolder .. "/trial_log.txt", line .. "\n")
        end)
    end
end
local function roomAnchor(m)
    local a = m:FindFirstChild("SafetyFloor") or m:FindFirstChild("BasePart") or m.PrimaryPart
    if a and a:IsA("BasePart") then return a.Position end
    local ok, cf = pcall(m.GetPivot, m)
    return ok and cf and cf.Position or nil
end
function Features.NearRooms(fromPos, maxDist)
    local tower = Worlds:FindFirstChild("Tower")
    local map = tower and tower:FindFirstChild("Map")
    local out = {}
    for _, m in ipairs(map and map:GetChildren() or {}) do
        if m.Name == "StartRoom" or m.Name == "BattleRoom" or m.Name == "RestRoom" then
            local pos = roomAnchor(m)
            if pos then
                local d = (pos - fromPos).Magnitude
                if d <= maxDist then out[#out + 1] = { room = m, pos = pos, dist = d } end
            end
        end
    end
    table.sort(out, function(a, b) return a.dist < b.dist end)
    return out
end
local function touchPart(part)
    local root = Util.Root()
    if not root or not part then return end
    Util.MoveTo(part.CFrame)
    if firetouchinterest then
        pcall(firetouchinterest, root, part, 0)
        task.wait(0.1)
        pcall(firetouchinterest, root, part, 1)
    end
end
function Features.TrialStep()
    local root = Util.Root()
    if not root then return false end
    local rooms = Features.NearRooms(root.Position, 1500)
    if #rooms == 0 then Features.TrialLog("no rooms near us") return false end
    local cur = rooms[1]
    trialVisited[cur.room] = true
    -- chests in our room
    if not On("TrialIgnoreChest") then
        for _, p in ipairs(Prompt.Find(cur.room, { "chest" })) do Prompt.Use(p) task.wait(0.2) end
    end
    -- start / rest room: step into its teleporter
    if cur.room.Name ~= "BattleRoom" then
        local tp = cur.room:FindFirstChild("Teleporter")
        local trig = tp and tp:FindFirstChild("TriggerPart", true)
        if trig and trig:IsA("BasePart") then
            Features.TrialLog("in " .. cur.room.Name .. ": touching its Teleporter")
            touchPart(trig)
            task.wait(0.5)
            return true
        end
    end
    -- next room: the nearest room we haven't been in, measured from the front of this one
    local front = cur.room:FindFirstChild("StageConnectorFront")
    local from = front and front:IsA("BasePart") and front.Position or root.Position
    local best
    for _, r in ipairs(Features.NearRooms(from, 1200)) do
        if not trialVisited[r.room] and r.room ~= cur.room then best = r break end
    end
    if best then
        Features.TrialLog("from " .. cur.room.Name .. " to next " .. best.room.Name .. " (" .. math.floor(best.dist) .. " studs)")
        pcall(function() LP:RequestStreamAroundAsync(best.pos) end)
        -- walk in over its back connector (the way a player enters), then to its floor
        local back = best.room:FindFirstChild("StageConnectorBack")
        if back and back:IsA("BasePart") then touchPart(back) task.wait(0.2) end
        Util.MoveTo(CFrame.new(best.pos + Vector3.new(0, 6, 0)))
        for _, n in ipairs({ "SafetyFloor", "BasePart" }) do
            local f = best.room:FindFirstChild(n)
            if f and f:IsA("BasePart") then touchPart(f) end
        end
        Util.MoveTo(CFrame.new(best.pos + Vector3.new(0, 6, 0)))
        task.wait(0.6)
        return true
    end
    Features.TrialLog("in " .. cur.room.Name .. ": no teleporter, no next room")
    return false
end

-- NEXT ROOM BUTTON: when a trial room is cleared the game puts a ProximityPrompt on a
-- part named "ConfirmPart" in Tower.Map. Pressing it sends you to the next room.
-- (Same as the old AFS scripts: stand on the ConfirmPart and press E until the prompt
-- is gone.) Parts are collected once and then kept up to date with DescendantAdded,
-- so the huge map isn't searched every tick.
local confirmParts, confirmWatch = {}, nil
local function watchConfirmParts()
    if confirmWatch then return end
    local tower = Worlds:FindFirstChild("Tower")
    local map = tower and tower:FindFirstChild("Map")
    if not map then return end
    for _, d in ipairs(map:GetDescendants()) do
        if d.Name == "ConfirmPart" then confirmParts[d] = true end
    end
    confirmWatch = track(map.DescendantAdded:Connect(function(d)
        if d.Name == "ConfirmPart" then confirmParts[d] = true
        elseif d:IsA("ProximityPrompt") and d.Parent and d.Parent.Name == "ConfirmPart" then confirmParts[d.Parent] = true end
    end))
end
-- nearest ConfirmPart that has its prompt (= our cleared room)
function Features.NextRoomButton(maxDist)
    watchConfirmParts()
    local root = Util.Root()
    if not root then return nil end
    local best, bestPrompt, bestDist
    for part in pairs(confirmParts) do
        if not part.Parent then
            confirmParts[part] = nil
        else
            local p = part:FindFirstChildWhichIsA("ProximityPrompt", true)
            local pos = part:IsA("BasePart") and part.Position or (part:IsA("Model") and part:GetPivot().Position)
            if p and p.Enabled and pos then
                local d = (pos - root.Position).Magnitude
                if d <= (maxDist or 1500) and (not bestDist or d < bestDist) then best, bestPrompt, bestDist = part, p, d end
            end
        end
    end
    return best, bestPrompt
end
Features.PressedPrompts = setmetatable({}, { __mode = "k" })   -- (a table field: the main chunk is near Luau's 200-local limit)
function Features.PressNextRoom()
    local part, prompt = Features.NextRoomButton(350)
    if not part then return false end
    local last = Features.PressedPrompts[prompt]
    if last and os.clock() - last < 15 then return false end   -- pressed already, the room is coming
    local cf = part:IsA("BasePart") and part.CFrame or part:GetPivot()
    Features.TrialLog("RestRoom: pressing \"" .. tostring(prompt.ActionText) .. "\"")
    Util.MoveTo(cf + Vector3.new(0, 3, 0))
    task.wait(0.4)
    if fireproximityprompt then
        pcall(fireproximityprompt, prompt)
    else
        pcall(function()
            VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(math.max(prompt.HoldDuration, 0.05))
            VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end)
    end
    Features.PressedPrompts[prompt] = os.clock()
    return true
end

-- TRIAL ROOMS: a run is built from models in Tower.Map named "BattleRoom" (fight)
-- and "RestRoom" (every 5th, has the ConfirmPart button); the first room is the
-- door's StartRoom. The game keeps adding the next room as the run goes on, so
-- the room to be in is the NEWEST one of our run.
-- (Tower.Map also holds ~600 spare "StartRoom" models; a run's own start room is
-- found through Door<n>.StartRoom instead)
local ROOM_TYPES = { BattleRoom = true, RestRoom = true }
local roomBoxes = setmetatable({}, { __mode = "k" })
local visitedRooms = setmetatable({}, { __mode = "k" })
local roomBorn = setmetatable({}, { __mode = "k" })
local roomWatch = nil
local function watchRooms(map)
    if roomWatch or not map then return end
    roomWatch = track(map.ChildAdded:Connect(function(m)
        if m.Name == "BattleRoom" or m.Name == "RestRoom" then roomBorn[m] = os.clock() end
    end))
end
local function roomBox(m)
    local b = roomBoxes[m]
    if not b then
        local ok, cf, size = pcall(m.GetBoundingBox, m)
        if not ok or not cf or size.Magnitude < 1 then
            local ok2, pv = pcall(m.GetPivot, m)
            if not ok2 then return nil end
            return { cf = pv, size = Vector3.new(80, 60, 80), temp = true }
        end
        b = { cf = cf, size = size }
        roomBoxes[m] = b
    end
    return b
end
function Features.TrialRooms(types)
    local tower = Worlds:FindFirstChild("Tower")
    local map = tower and tower:FindFirstChild("Map")
    watchRooms(map)
    local out = {}
    for _, m in ipairs(map and map:GetChildren() or {}) do
        if m:IsA("Model") and (types or ROOM_TYPES)[m.Name] then out[#out + 1] = m end
    end
    return out
end
local PLAY_ROOMS = { BattleRoom = true, RestRoom = true }
function Features.RoomAt(pos)
    for _, m in ipairs(Features.TrialRooms(PLAY_ROOMS)) do
        local b = roomBox(m)
        if b then
            local rel = b.cf:PointToObjectSpace(pos)
            if math.abs(rel.X) <= b.size.X / 2 + 3 and math.abs(rel.Z) <= b.size.Z / 2 + 3
                and math.abs(rel.Y) <= b.size.Y / 2 + 15 then
                return m
            end
        end
    end
    return nil
end
function Features.ResetTrialRooms()
    table.clear(visitedRooms)
    Features.TrialRooms()   -- start watching for new rooms before the run begins
end
function Features.AdvanceRoom()
    local root = Util.Root()
    if not root then return end
    -- in a run = the game shows "Room N"
    if not Features.CurrentRoom() then return end
    local cur = Features.RoomAt(root.Position)
    if cur then visitedRooms[cur] = true end
    -- newest room of our run (made after we joined, close to us), else nearest new one
    local best, bestBorn, near, nearDist
    for _, m in ipairs(Features.TrialRooms(PLAY_ROOMS)) do
        if m ~= cur and not visitedRooms[m] then
            local b = roomBox(m)
            if b then
                local dist = (b.cf.Position - root.Position).Magnitude
                if dist < 2500 then
                    local born = roomBorn[m]
                    if born and (not bestBorn or born > bestBorn) then best, bestBorn = m, born end
                    if not nearDist or dist < nearDist then near, nearDist = m, dist end
                end
            end
        end
    end
    local target = best or near
    if target then
        local c = roomBox(target).cf.Position
        pcall(function() LP:RequestStreamAroundAsync(c) end)
        Util.MoveTo(CFrame.new(c + Vector3.new(0, 5, 0)))
    end
end

-- positions of enemies in the Tower that exist but aren't loaded near us yet.
-- A model's pivot is known even while its parts are streamed out.
function Features.TowerEnemyTargets()
    local out, tower = {}, Worlds:FindFirstChild("Tower")
    if not tower then return out end
    for _, f in ipairs(Combat.EnemyFolders(tower)) do
        do
            for _, e in ipairs(f:GetChildren()) do
                if e:IsA("Model") and not e:FindFirstChild("HumanoidRootPart") then
                    local hp = e:FindFirstChild("Health")
                    if not hp or hp.Value > 0 then
                        local ok, cf = pcall(e.GetPivot, e)
                        if ok and cf and cf.Position.Magnitude > 1 then out[#out + 1] = cf.Position end
                    end
                end
            end
        end
    end
    local root = Util.Root()
    if root then
        for k = #out, 1, -1 do if (out[k] - root.Position).Magnitude > 600 then table.remove(out, k) end end
        table.sort(out, function(a, b) return (a - root.Position).Magnitude < (b - root.Position).Magnitude end)
    end
    return out
end

-- stuck in a trial with nothing to do: save the Tower's layout once to
-- GravityHub/AFS/tower_dump.txt so the room / door names can be checked
local towerDumped, roomDumped = false, false
function Features.DumpTowerOnce(force)
    if not writefile then return end
    local r = Util.Root()
    local inRoom = r and Features.RoomAt(r.Position) ~= nil
    -- once in the lobby and once more from inside a run room
    if not force and ((towerDumped and not (inRoom and not roomDumped)) or not Util.Every("tower-stuck", 15)) then return end
    towerDumped = true
    if inRoom then roomDumped = true end
    local tower = Worlds:FindFirstChild("Tower")
    if not tower then return end
    local lines = {}
    local function walk(o, depth)
        if #lines > 4000 or depth > 7 then return end
        local extra = ""
        if o:IsA("BasePart") then extra = "  @ " .. tostring(o.Position)
        elseif o:IsA("Model") then local ok, cf = pcall(o.GetPivot, o) extra = ok and ("  @ " .. tostring(cf.Position)) or ""
        elseif o:IsA("TextLabel") then extra = "  '" .. o.Text .. "'"
        elseif o:IsA("ValueBase") then extra = "  = " .. tostring(o.Value) end
        lines[#lines + 1] = string.rep("  ", depth) .. o.ClassName .. " " .. o.Name .. extra
        local kids = o:GetChildren()
        if #kids > 40 then
            local count, order = {}, {}
            for _, c in ipairs(kids) do
                local key = c.ClassName .. " " .. c.Name
                if not count[key] then count[key] = 0 order[#order + 1] = key end
                count[key] = count[key] + 1
            end
            for i2 = 1, math.min(#order, 60) do
                lines[#lines + 1] = string.rep("  ", depth + 1) .. order[i2] .. "  x" .. count[order[i2]]
            end
            return
        end
        for _, c in ipairs(kids) do walk(c, depth + 1) end
    end
    walk(tower, 0)
    local root = Util.Root()
    local cur = root and Features.RoomAt(root.Position)
    if cur then
        lines[#lines + 1] = "=== ROOM YOU ARE IN ==="
        walk(cur, 0)
    end
    lines[#lines + 1] = "PLAYER @ " .. tostring(root and root.Position)
    pcall(writefile, CFG.ConfigFolder .. "/tower_dump.txt", table.concat(lines, "\n"))
end

-- TRIAL DOORS -----------------------------------------------------------------------
-- The lobby has one door per trial (TowerDoor1..8), each with its own timer board.
-- Door positions come from the game's AttemptTravel answer (or a part named
-- TowerDoor<n>) and are saved to GravityHub/AFS/trial_doors.json; the timer
-- used for a door is the countdown board closest to it.
-- Start times are stored as SERVER time (workspace:GetServerTimeNow), so the
-- prediction matches the server even after you leave the lobby or rejoin; each
-- door's repeat time is learned from two readings (default CFG.TrialPeriod).
local doorPos, doorStarts, doorPeriod = {}, {}, {}
local DOOR_FILE = CFG.ConfigFolder .. "/trial_doors.json"
local function serverNow()
    local ok, t = pcall(function() return workspace:GetServerTimeNow() end)
    return ok and t or os.time()
end
pcall(function()
    if isfile and isfile(DOOR_FILE) then
        for k, v in pairs(HttpService:JSONDecode(readfile(DOOR_FILE))) do
            local id = tonumber(k)
            if id and type(v) == "table" then
                if type(v.pos) == "table" then doorPos[id] = Vector3.new(v.pos[1], v.pos[2], v.pos[3])
                elseif #v == 3 then doorPos[id] = Vector3.new(v[1], v[2], v[3]) end   -- old format
                doorStarts[id] = tonumber(v.start)
                doorPeriod[id] = tonumber(v.period)
            end
        end
    end
end)
local function saveDoors()
    pcall(function()
        if not writefile then return end
        local out = {}
        for id in pairs(doorPos) do
            local p = doorPos[id]
            out[tostring(id)] = { pos = { p.X, p.Y, p.Z }, start = doorStarts[id], period = doorPeriod[id] }
        end
        writefile(DOOR_FILE, HttpService:JSONEncode(out))
    end)
end

local boardCache, boardTime = {}, -math.huge
local function countdownBoards()
    if os.clock() - boardTime < 1 then return boardCache end
    boardTime, boardCache = os.clock(), {}
    local tower = Worlds:FindFirstChild("Tower")
    if not tower then return boardCache end
    for _, d in ipairs(tower:GetDescendants()) do
        if d:IsA("TextLabel") then
            local secs = parseClock(d.Text)
            if secs then
                local gui = d:FindFirstAncestorWhichIsA("SurfaceGui") or d:FindFirstAncestorWhichIsA("BillboardGui")
                local part = gui and (gui.Adornee or gui.Parent)
                local pos
                if part and part:IsA("BasePart") then pos = part.Position
                elseif part and part:IsA("Model") then pos = part:GetPivot().Position end
                if pos then boardCache[#boardCache + 1] = { pos = pos, secs = secs } end
            end
        end
    end
    return boardCache
end

function Features.DoorModel(id)
    local tower = Worlds:FindFirstChild("Tower")
    return tower and (tower:FindFirstChild("Door" .. id) or tower:FindFirstChild("TowerDoor" .. id, true))
end
function Features.DoorPosition(id)
    if doorPos[id] then return doorPos[id] end
    local door = Features.DoorModel(id)
    if door then
        doorPos[id] = door:IsA("BasePart") and door.Position or (door:IsA("Model") and door:GetPivot().Position) or nil
        if doorPos[id] then saveDoors() end
    end
    return doorPos[id]
end

-- seconds until door <id> opens its next run (nil = don't know yet)
function Features.DoorCountdown(id)
    -- 1) the door's own board: Tower.Door<n>.Countdown.SurfaceGui...
    local door = Features.DoorModel(id)
    local board = door and door:FindFirstChild("Countdown")
    if board then
        for _, d in ipairs(board:GetDescendants()) do
            if d:IsA("TextLabel") then
                local secs = parseClock(d.Text)
                if secs then
                    local start = serverNow() + secs
                    local old = doorStarts[id]
                    if old and start - old > 120 then
                        local gap = start - old
                        if gap >= 300 and gap <= 4 * 3600 then doorPeriod[id] = math.floor(gap / 30 + 0.5) * 30 end
                    end
                    if not old or math.abs(start - old) > 2 then
                        doorStarts[id] = start
                        if Util.Every("door-save", 30) then saveDoors() end
                    end
                    return secs
                end
            end
        end
    end
    -- 2) closest board to where the door is
    local dp = Features.DoorPosition(id)
    if dp then
        local best, bestDist
        for _, b in ipairs(countdownBoards()) do
            local dist = (b.pos - dp).Magnitude
            if dist < 90 and (not bestDist or dist < bestDist) then best, bestDist = b, dist end
        end
        if best then
            local start = serverNow() + best.secs
            local old = doorStarts[id]
            -- the board jumped to a new cycle: the gap is how often this door repeats
            if old and start - old > 120 then
                local gap = start - old
                if gap >= 300 and gap <= 4 * 3600 then doorPeriod[id] = math.floor(gap / 30 + 0.5) * 30 end
            end
            if not old or math.abs(start - old) > 2 then
                doorStarts[id] = start
                if Util.Every("door-save", 30) then saveDoors() end
            end
            return best.secs
        end
        -- board not loaded (you're far away): load the area around that door
        if Util.Every("door-stream-" .. id, 20) then
            task.spawn(pcall, LP.RequestStreamAroundAsync, LP, dp)
        end
    end
    -- board not readable: predict from the last server-time reading
    local start = doorStarts[id]
    if start then
        local now, period = serverNow(), doorPeriod[id] or CFG.TrialPeriod
        while start - now < -5 do start = start + period end
        return start - now
    end
    return nil
end

-- When the run starts the door opens (MainDoor lifts, Door<n>.StartRoom is set)
-- and you get in by stepping into Door<n>.Teleporter.TriggerPart - the same as
-- walking through the door. Keep touching it until we're up in the run.
function Features.EnterTrialDoor()
    if not trialDoorId or os.clock() - trialJoinedAt > 240 then return false end
    local root = Util.Root()
    local door = Features.DoorModel(trialDoorId)
    local tp = door and door:FindFirstChild("Teleporter")
    local trigger = tp and tp:FindFirstChild("TriggerPart")
    if not root or not trigger then return false end
    if (root.Position - trigger.Position).Magnitude > 400 then return false end   -- already up in the run
    local sr = door:FindFirstChild("StartRoom")
    local open = (sr and sr:IsA("ObjectValue") and sr.Value ~= nil)
    local secs = Features.DoorCountdown(trialDoorId)
    local main = door:FindFirstChild("MainDoor")
    if main and door:FindFirstChild("TimeSymbol") and main.Position.Y - door.TimeSymbol.Position.Y > 5 then open = true end
    if not open and not (secs and secs <= 1) then return false end
    Util.MoveTo(trigger.CFrame)
    if firetouchinterest then
        pcall(firetouchinterest, root, trigger, 0)
        pcall(firetouchinterest, root, trigger, 1)
    end
    task.wait(0.3)
    return true
end

-- in a run = the game's TowerTimer is on screen, or the "Room N" label, or we're
-- far above / away from the lobby
function Features.InTrialRun()
    local mg = Data.MainGui()
    local tt = mg and mg:FindFirstChild("TowerTimer")
    if tt and tt:IsA("GuiObject") and tt.Visible then return true end
    if Features.CurrentRoom() then return true end
    local tower = Worlds:FindFirstChild("Tower")
    local spawn = tower and tower:FindFirstChild("Spawns") and tower.Spawns:FindFirstChildWhichIsA("BasePart")
    local root = Util.Root()
    if not (spawn and root) then return false end
    local fromLobby = (root.Position - spawn.Position).Magnitude
    if fromLobby > 400 then return true end
    -- a cleared room's button right next to us also means we're in a run
    if fromLobby > 150 and Features.NextRoomButton(120) then return true end
    return false
end

-- join exactly like the game: JoinTimeTrial(n) -> AttemptTravel("TowerDoor<n>", true)
function Features.JoinTrial(name, id)
    Stats.TrialName, Stats.TrialFloor = name, 0
    trialDoorId = id
    Features.ResetTrialRooms()
    local root0 = Util.Root()
    local from = root0 and root0.Position
    Net.Raw("JoinTimeTrial", { id })
    local pos = Net.Raw("AttemptTravel", { "TowerDoor" .. id, true })
    -- the game itself teleports you into the trial's StartRoom (Yuto Hub sends these
    -- two and nothing else); only stand at the door ourselves if that didn't happen
    local t0 = os.clock()
    while from and os.clock() - t0 < 3 do
        local r = Util.Root()
        if r and (r.Position - from).Magnitude > 300 then
            trialJoinedAt = os.clock()
            Util.Notify("In " .. name .. " Time Trial - waiting for the start")
            return
        end
        task.wait(0.1)
    end
    local cf = toCFrame(pos)
    if not cf then
        -- no answer: be in the Tower and stand at the door's teleporter ourselves
        if Util.World() ~= "Tower" then Travel.To("Tower", true) end
        local door = Features.DoorModel(id)
        local trig = door and door:FindFirstChild("TriggerPart", true)
        if trig then cf = trig.CFrame * CFrame.new(0, 0, 6) end
    end
    if cf then
        if not doorPos[id] then doorPos[id] = cf.Position saveDoors() end
        pcall(function() LP:RequestStreamAroundAsync(cf.Position) end)
        Util.MoveTo(cf + Vector3.new(0, 4, 0))
        trialJoinedAt = os.clock()
        Util.Notify("Waiting for " .. name .. " Time Trial")
    end
end

-- pick the selected trial whose door opens soonest, within the last CFG.TrialGoAt seconds
function Features.TryJoinTrial(trials)
    if os.clock() - trialJoinedAt < 75 then return end
    local pick, pickId, pickSecs, unknown
    for _, name in ipairs(trials) do
        local id = CFG.TimeTrialIds[name]
        if id then
            local secs = Features.DoorCountdown(id)
            if secs == nil then unknown = unknown or { name, id }
            elseif secs > 0 and secs <= CFG.TrialGoAt and (not pickSecs or secs < pickSecs) then
                pick, pickId, pickSecs = name, id, secs
            end
        end
    end
    if pick then
        if Util.Every("trial-join", 5) then Features.JoinTrial(pick, pickId) end
    elseif unknown and not doorPos[unknown[2]] and Util.Every("trial-scout", 60) then
        -- first time only: we don't know where that door is yet; one try tells us
        -- (the game answers with the door position, saved for next time)
        Features.JoinTrial(unknown[1], unknown[2])
    end
end

