local passiveDone, passiveRolls = {}, {}
local PassiveStatus

local function readPassive(petId, slot, reply)
    local pet = Data.PetObject(petId)
    if pet then
        local v = Data.PetValue(pet, { "Passive" .. slot, "Passive_" .. slot, "PassiveSlot" .. slot })
        if v == nil and slot == 1 then v = Data.PetValue(pet, { "Passive", "PassiveName" }) end
        if v == nil then
            local folder = (pet:FindFirstChild("Data") and pet.Data:FindFirstChild("Passives")) or pet:FindFirstChild("Passives")
            local c = folder and (folder:FindFirstChild(tostring(slot)) or folder:GetChildren()[slot])
            if c then v = c:IsA("ValueBase") and c.Value or c.Name end
        end
        if v ~= nil then return tostring(v) end
    end
    if type(reply) == "table" then
        local r = reply[slot] or reply.Passive or reply.Name or reply[1]
        return r and tostring(r) or nil
    elseif reply ~= nil then
        return tostring(reply)
    end
    return nil
end

-- machines = the "Category" values in the game's PassiveStats ("Frieren2026", "Easter2026", ...)
-- passives without a category are the normal machine
function Data.PassiveMachines()
    local seen, out = {}, {}
    for _, t in pairs(Data.Module("PassiveStats") or {}) do
        if type(t) == "table" and type(t.Category) == "string" and not seen[t.Category] then
            seen[t.Category] = true
            out[#out + 1] = t.Category
        end
    end
    table.sort(out)
    table.insert(out, 1, "Normal")
    if #out == 1 then return CFG.PassiveMachines end
    return out
end

function Features.PassiveStatusText()
    local lines = {}
    local ready = next(F("PassivePets") or {}) and next(F("PassiveSlots") or {})
    lines[#lines + 1] = "Status [" .. (On("AutoPassive") and "<font color='#4ade80'>running</font>" or (ready and "<font color='#4ade80'>ready</font>" or "<font color='#f87171'>not ready</font>")) .. "]"
    lines[#lines + 1] = "[-] Pets : " .. Util.Count(F("PassivePets"))
    lines[#lines + 1] = "[-] Passive Slot : " .. table.concat(Util.SetToList(F("PassiveSlots")), ", ")
    lines[#lines + 1] = "[-] Reroll Mode : " .. tostring(F("PassiveMode") or "-")
    lines[#lines + 1] = "[-] Passive Selected :"
    for _, n in ipairs(Util.SetToList(F("PassiveNames"))) do lines[#lines + 1] = "    [+] " .. n end
    lines[#lines + 1] = "[-] Passive Rarity Selected :"
    for _, n in ipairs(Util.SetToList(F("PassiveRarity"))) do lines[#lines + 1] = "    [+] " .. n end
    lines[#lines + 1] = "[-] Passive Machine : " .. tostring(F("PassiveMachine") or "-")
    lines[#lines + 1] = "[-] Delayed " .. tostring(F("PassiveDelay") or 0.5)
    local done, total = 0, 0
    for _ in pairs(passiveRolls) do total = total + 1 end
    for _ in pairs(passiveDone) do done = done + 1 end
    lines[#lines + 1] = "[-] Slots done : " .. done .. " / " .. total
    return table.concat(lines, "\n")
end

local _, passiveRarityOf = Data.Passives()
local warnedRead = false
local function passiveWanted(got)
    if not got then return false end
    if (F("PassiveMode") or "Keep Selected Passive") == "Keep Selected Rarity" then
        return (F("PassiveRarity") or {})[passiveRarityOf[got] or ""] == true
    end
    for name in pairs(F("PassiveNames") or {}) do
        if string.lower(got) == string.lower(name) or string.find(string.lower(got), string.lower(name), 1, true) then return true end
    end
    return false
end
-- Yuto Hub (watched): every ~0.55 s ONE RollPassive per pet, always on the same slot of that
-- pet until it's good: RollPassive(uid, machine, true, slot). A slot that already holds a
-- wanted passive is never rolled.
function Features.Passive()
    local pets = Util.SetToList(F("PassivePets"))
    local slots = Util.SetToList(F("PassiveSlots"))
    if #pets == 0 or #slots == 0 then return end
    local machine = F("PassiveMachine") or "Normal"
    local sent = {}
    for _, label in ipairs(pets) do
        local id = Data.PetId(label)
        for _, slotText in ipairs(slots) do
            local slot = tonumber(slotText) or 1
            local key = id .. "#" .. slot
            if not passiveDone[key] then
                local now = readPassive(id, slot)
                if passiveWanted(now) then
                    passiveDone[key] = true            -- already good: keep it, never roll it
                else
                    passiveRolls[key] = (passiveRolls[key] or 0) + 1
                    Net.Call("RollPassive", id, machine, slot)
                    sent[#sent + 1] = { label = label, id = id, slot = slot, key = key }
                    break                              -- one slot per pet per round
                end
            end
        end
    end
    if #sent == 0 then
        Flags.AutoPassive:Set(false)
        Util.Notify("All selected slots have a kept passive")
        if PassiveStatus then PassiveStatus:Set(Features.PassiveStatusText()) end
        return
    end
    task.wait(F("PassiveDelay") or 0.5)
    for _, r in ipairs(sent) do
        local got = readPassive(r.id, r.slot)
        if passiveWanted(got) then
            passiveDone[r.key] = true
            Util.Notify(r.label .. " slot " .. r.slot .. " -> " .. got)
        elseif not got and not warnedRead then
            warnedRead = true
            Util.Notify("Can't read the pet's passive - send a Gravity Dumper report")
        end
    end
    if PassiveStatus then PassiveStatus:Set(Features.PassiveStatusText()) end
end
function Features.ResetPassive() passiveDone, passiveRolls, warnedRead = {}, {}, false end

