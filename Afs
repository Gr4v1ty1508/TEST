-- other players' characters (their pets / effects follow them) hidden on your screen only
local function setPlayerHidden(plr, hidden)
    local char = plr.Character
    if not char then return end
    for _, o in ipairs(char:GetDescendants()) do
        pcall(function()
            if o:IsA("BasePart") or o:IsA("Decal") then o.LocalTransparencyModifier = hidden and 1 or 0
            elseif o:IsA("BillboardGui") or o:IsA("ParticleEmitter") or o:IsA("Trail") then o.Enabled = not hidden end
        end)
    end
end
function Features.HideOthers(hidden)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then setPlayerHidden(plr, hidden) end
    end
end

function Features.Disable3D(off)
    pcall(function() RunService:Set3dRenderingEnabled(not off) end)
end

