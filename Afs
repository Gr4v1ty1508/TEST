        btn.MouseEnter:Connect(function() if W.Current ~= tab then tween(btn, { BackgroundTransparency = 0.6 }, 0.1) end end)
        btn.MouseLeave:Connect(function() if W.Current ~= tab then tween(btn, { BackgroundTransparency = 1 }, 0.1) end end)
        btn.MouseButton1Click:Connect(function() selectTab(tab) end)

