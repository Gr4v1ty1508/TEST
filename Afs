function Library:Window(opt)
    local parent = guiParent()
    for _, n in ipairs({ "RenHubV3", "RenHubUI" }) do
        local old = parent:FindFirstChild(n)
        if old then old:Destroy() end
    end

    local W = { Tabs = {}, Size = Vector2.new(opt.Width or 780, opt.Height or 520), Open = true, UserScale = 1 }
    local gui = make("ScreenGui", { Name = "RenHubV3", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 999, Parent = parent })
    W.Gui = gui

    local main = make("CanvasGroup", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(W.Size.X, W.Size.Y), BackgroundColor3 = Theme.Window, Parent = gui },
        { corner(14), stroke(Theme.Stroke) })
    local scale = make("UIScale", { Parent = main })
    W.Main = main

    local function fitScale()
        local cam = workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
        return math.min(1, (vp.X - 30) / W.Size.X, (vp.Y - 30) / W.Size.Y) * W.UserScale
    end
    scale.Scale = fitScale()
    if workspace.CurrentCamera then
        track(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            if W.Open then scale.Scale = fitScale() end
        end))
    end

    -- sidebar ----------------------------------------------------------------
    local side = make("Frame", { Size = UDim2.new(0, 236, 1, 0), BackgroundColor3 = Theme.Sidebar, BorderSizePixel = 0, Parent = main })
    make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 1, 1, 0),
        BackgroundColor3 = Theme.Stroke, BorderSizePixel = 0, Parent = side })

    local lights = make("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 14), Size = UDim2.fromOffset(60, 12), Parent = side },
        { list(8, Enum.FillDirection.Horizontal) })
    local lightButtons = {}
    for i, c in ipairs({ Color3.fromRGB(255, 95, 87), Color3.fromRGB(254, 188, 46), Color3.fromRGB(40, 200, 64) }) do
        lightButtons[i] = make("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = c,
