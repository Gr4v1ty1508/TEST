-- send exactly what the game sent when you did it by hand; fall back to a guess
-- SUMMON ARGUMENTS ---------------------------------------------------------------------------------
-- Built from the call the game made when you summoned by hand (learned_calls.json),
-- with size / world / artifact swapped for what's picked in the hub.
--   * a boolean slot that CHANGED between your hand-made summons = the artifact switch
--   * keys named like artifact / size / difficulty / world inside a table are swapped by name
--   * otherwise: a size word, a world name / folder, a lone boolean, a size number 1-5
local function summonRoles()
    local roles, hist = {}, Learn.History("SummonDungeon")
    if #hist < 2 then return roles end
    local n = 0
    for _, h in ipairs(hist) do n = math.max(n, #h) end
    for i = 1, n do
        local seen, count, allBool = {}, 0, true
        for _, h in ipairs(hist) do
            local v = h[i]
            if type(v) ~= "boolean" then allBool = false end
            if not seen[tostring(v)] then seen[tostring(v)] = true count = count + 1 end
        end
        if count > 1 and allBool then roles[i] = "artifact" end
    end
    return roles
end
local function fillSummon(v, key, ctx)
    local lk = type(key) == "string" and string.lower(key) or ""
    local t = typeof(v)
    if lk ~= "" then
        if string.find(lk, "artifact", 1, true) or string.find(lk, "artefact", 1, true) then
            ctx.artifactHit = true
            if t == "boolean" then return ctx.artifact end
            return ctx.artifact and v or nil
        end
        if string.find(lk, "size", 1, true) or string.find(lk, "difficult", 1, true) or string.find(lk, "tier", 1, true) then
            ctx.sizeHit = true
            if t == "number" then return ctx.sizeIndex end
            if t == "string" then return ctx.size end
        end
        if string.find(lk, "world", 1, true) or string.find(lk, "map", 1, true) then
            ctx.worldHit = true
            if t == "Instance" then return Worlds:FindFirstChild(ctx.world) or v end
            if t == "string" then
                if Worlds:FindFirstChild(v) then return ctx.world end
                return Data.WorldDisplay(ctx.world)
            end
        end
    end
    if t == "table" then
        local o = {}
        for k, x in pairs(v) do o[k] = fillSummon(x, k, ctx) end
        return o
    elseif t == "string" then
        local lv = string.lower(v)
        for _, sz in ipairs(CFG.DungeonSizes) do
            if lv == string.lower(sz) then ctx.sizeHit = true return (v == lv) and string.lower(ctx.size) or ctx.size end
        end
        if Worlds:FindFirstChild(v) and not CFG.ModeWorlds[v] then ctx.worldHit = true return ctx.world end
        for _, f in ipairs(Worlds:GetChildren()) do
            if Data.WorldDisplay(f.Name) == v and not CFG.ModeWorlds[f.Name] then
                ctx.worldHit = true
                return Data.WorldDisplay(ctx.world)
            end
        end
    elseif t == "Instance" and v.Parent == Worlds and not CFG.ModeWorlds[v.Name] then
        ctx.worldHit = true
        return Worlds:FindFirstChild(ctx.world) or v
    end
    return v
end
-- returns args, source ("learned" / "guess"), artifact slot text
local function summonArgs(size, world, artifact)
    -- the game numbers sizes from 0 (MainGui.DungeonSummon.Config.Sizes has "0".."4":
    -- Small 0, Medium 1, Large 2, Insane 3, Hellish 4) - sending 3 for Large opened Insane
    local sizeIndex = (table.find(CFG.DungeonSizes, size) or 1) - 1
    local tpl, n = Learn.Get("SummonDungeon")
    if not tpl then
        local a = { CFG.DungeonSizeArg[size] or size, world, artifact }
        a.n = 3
        return a, "guess", "3 (guess)"
    end
    local ctx = { size = size, sizeIndex = sizeIndex, world = world, artifact = artifact }
    local roles = summonRoles()
    local artSlot = nil
    for i = 1, n do
        if roles[i] == "artifact" then tpl[i] = artifact artSlot = tostring(i)
        else tpl[i] = fillSummon(tpl[i], nil, ctx) end
    end
    if ctx.artifactHit then artSlot = artSlot or "by name" end
    if not artSlot then
        local bools = {}
        for i = 1, n do if type(tpl[i]) == "boolean" then bools[#bools + 1] = i end end
        if #bools == 1 then tpl[bools[1]] = artifact artSlot = tostring(bools[1]) end
    end
    if CFG.DungeonArtifactSlot then tpl[CFG.DungeonArtifactSlot] = artifact artSlot = tostring(CFG.DungeonArtifactSlot) end
    -- the game sent the size as a number (1 = Small ... 5 = Hellish)
    if not ctx.sizeHit then
        for i = 1, n do
            local v = tpl[i]
            if type(v) == "number" and v >= 0 and v < #CFG.DungeonSizes and v % 1 == 0 then tpl[i] = sizeIndex break end
        end
    end
    tpl.n = n
    return tpl, "learned", artSlot or "not found"
end
Features.SummonArgs = summonArgs
