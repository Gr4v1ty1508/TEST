function Prompt.Find(root, words)
    local out = {}
    if not root then return out end
    for _, p in ipairs(root:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Enabled then
            local hay = string.lower((p.Parent and p.Parent.Name or "") .. " " .. p.ActionText .. " " .. p.ObjectText)
            for _, w in ipairs(words) do
                if string.find(hay, string.lower(w), 1, true) then out[#out + 1] = p break end
            end
        end
    end
    return out
end
function Prompt.Use(p)
    local part = p.Parent
    if part and part:IsA("BasePart") then Util.MoveTo(part.CFrame * CFrame.new(0, 3, 0)) end
    task.wait(0.25)
    if fireproximityprompt then pcall(fireproximityprompt, p)
    else
        pcall(function() p:InputHoldBegin() task.wait(p.HoldDuration + 0.05) p:InputHoldEnd() end)
    end
end

local Travel = { LoadEnemies = true }

local function toCFrame(v)
    local t = typeof(v)
    if t == "CFrame" then return v end
    if t == "Vector3" then return CFrame.new(v) end
    if t == "Instance" then
        if v:IsA("BasePart") then return v.CFrame end
        if v:IsA("Model") then return v:GetPivot() end
    end
    return nil
end

-- where to stand in a world: game's FindSpawn -> GetSpawn remote -> spawn part in the folder
function Travel.SpawnCFrame(world)
    local fs = Bindables:FindFirstChild("FindSpawn")
    if fs and fs:IsA("BindableFunction") then
        local ok, res = pcall(fs.Invoke, fs, world)
        local cf = ok and toCFrame(res)
        if cf then return cf end
    end
    local gs = Remotes:FindFirstChild("GetSpawn")
    if gs and gs:IsA("RemoteFunction") then
        local cf = toCFrame(Net.Raw("GetSpawn", { world }))
        if cf then return cf end
    end
    local folder = Worlds:FindFirstChild(world)
    if not folder then return nil end
    for _, d in ipairs(folder:GetDescendants()) do
        if d:IsA("BasePart") and string.find(string.lower(d.Name), "spawn", 1, true) then return d.CFrame end
    end
    local first = folder:FindFirstChildWhichIsA("BasePart", true)
    return first and first.CFrame or nil
end

-- force = true moves the character even when already in that world (Teleport button)
function Travel.To(world, force)
    if not world or world == "" then return false end
    local already = Util.World() == world
    if already and not force then return true end
    if not already then
        Net.Call("Travel", world)
        local t0 = os.clock()
        while Util.World() ~= world and os.clock() - t0 < 4 do task.wait(0.1) end
    end
    local arrived = Util.World() == world
    if arrived or force then
        local cf = Travel.SpawnCFrame(world)
        if cf then
            pcall(function() LP:RequestStreamAroundAsync(cf.Position) end)
            Util.MoveTo(cf + Vector3.new(0, 4, 0))
        end
        if Travel.LoadEnemies then task.wait(0.6) end
    end
    if not arrived then Util.Notify("Travel to " .. world .. " failed (locked?)") end
    return arrived
end

