-- send exactly what the game sent when you did it by hand; fall back to a guess
local function summonArgs(size, world, artifact)
    local tpl, n = Learn.Get("SummonDungeon")
    if not tpl then return { size, world, artifact } end
    local bools = 0
    for i = 1, n do if type(tpl[i]) == "boolean" then bools = bools + 1 end end
    for i = 1, n do
        local v = tpl[i]
        if type(v) == "string" then
            local lv = string.lower(v)
            for _, sz in ipairs(CFG.DungeonSizes) do
                if lv == string.lower(sz) then tpl[i] = (v == lv) and string.lower(size) or size break end
            end
            if tpl[i] == v then
                if Worlds:FindFirstChild(v) then tpl[i] = world
                else
                    for _, f in ipairs(Worlds:GetChildren()) do
                        if Data.WorldDisplay(f.Name) == v then tpl[i] = Data.WorldDisplay(world) break end
                    end
                end
            end
        elseif type(v) == "boolean" and bools == 1 then
            tpl[i] = artifact
        end
    end
    return tpl
end
local function friendArgs(on)
    local tpl, n = Learn.Get("SetDungeonSetting")
    if not tpl then return { "FriendsOnly", on } end
    for i = 1, n do if type(tpl[i]) == "boolean" then tpl[i] = on end end
    return tpl
end

function Features.OpenDungeon()
    if os.clock() < nextSummon then
        -- a dungeon was just summoned: keep trying to get in instead of summoning again
        if Util.Every("dungeon-rejoin", 5) then
            Net.Raw("JoinDungeon", Learn.Get("JoinDungeon") or {})
        end
        return
    end
    -- 1. dungeon lobby (summon only works there)
    if Util.World() ~= "Dungeon" then
        Net.Call("DungeonLobby")
        local t0 = os.clock()
        while Util.World() ~= "Dungeon" and os.clock() - t0 < 4 do task.wait(0.1) end
        local cf = Travel.SpawnCFrame("Dungeon")
        if cf then Util.MoveTo(cf + Vector3.new(0, 4, 0)) end
        task.wait(1)
    end
    -- 2. friend only, 3. summon, 4. join
    Net.Raw("SetDungeonSetting", friendArgs(On("DungeonFriends")))
    local size = F("DungeonSize") or "Small"
    local world = Data.FromLabel(F("DungeonWorld") or "")
    if world == "" then Util.Notify("Pick a dungeon world") nextSummon = os.clock() + 10 return end
    Net.Raw("SummonDungeon", summonArgs(CFG.DungeonSizeArg[size] or size, world, On("DungeonArtifact")))
    task.wait(1.5)
    Net.Raw("JoinDungeon", Learn.Get("JoinDungeon") or {})
    for _, p in ipairs(Prompt.Find(Worlds:FindFirstChild("Dungeon"), { "dungeon", "enter", "join", "start" })) do
        Prompt.Use(p)
        break
    end
    nextSummon = os.clock() + 45
    dungeonStep = "joining"
end

function Features.FarmDungeon()
    dungeonStep = "inside"
    nextSummon = 0
    local wanted = function() return On("AutoFarmDungeon") end
    local worldName = Features.DungeonRoot() and Features.DungeonRoot().Name or Util.World()
    if Combat.Step(worldName, wanted) then return end
    local root = Features.DungeonRoot()
    -- chests
    if not On("DungeonIgnoreChest") then
        for _, p in ipairs(Prompt.Find(root, { "chest", "treasure" })) do
            Prompt.Use(p)
            Net.Call("OpenChest", p.Parent)
            task.wait(0.3)
        end
    end
    -- doors
    local door = Prompt.Find(root, { "door", "next", "open", "portal", "gate" })[1]
    if door then
        Prompt.Use(door)
        Net.Call("OpenDungeonDoor", door.Parent)
        task.wait(0.5)
        return
    end
    -- nothing loaded near us: visit the rooms one by one so their enemies load in
    if On("DungeonLoadAll") then
        local rooms = Features.DungeonRooms()
        if #rooms > 0 then
            roomIndex = roomIndex % #rooms + 1
            local cf = rooms[roomIndex]:GetPivot()
            pcall(function() LP:RequestStreamAroundAsync(cf.Position) end)
            Util.MoveTo(cf + Vector3.new(0, 5, 0))
            task.wait(0.6)
        end
    end
end

function Features.Dungeon()
    if Features.InDungeon() then
