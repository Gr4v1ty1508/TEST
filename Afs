function Features.Fuse()
    local types, rarities = F("FusePets") or {}, F("FuseRarity") or {}
    if not next(types) then return end
    local folder = LP:FindFirstChild("Pets")
    local ids = {}
    for _, pet in ipairs(folder and folder:GetChildren() or {}) do
        local n = Util.Value(pet, { "PetName", "Name", "DisplayName", "Type" })
        n = type(n) == "string" and n or pet.Name
        local rarity = Util.Value(pet, { "Rarity", "Tier" })
        local shiny = Util.Value(pet, { "Shiny", "IsShiny" })
        local locked = Util.Value(pet, { "Locked", "Lock", "IsLocked" })
        local equipped = Util.Value(pet, { "Equipped", "IsEquipped" })
        if types[n] and not locked and not equipped
           and (not next(rarities) or rarity == nil or rarities[rarity])
           and (On("FuseShiny") or not shiny) then
            ids[#ids + 1] = pet.Name
        end
    end
    if #ids > 1 then Net.Call("FusePets", ids) end
end

