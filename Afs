do
    local p = TPassive:Card("Auto Reroll Passive", "Left")
    p:Paragraph({ Title = "Auto Reroll Passive Caution !", Body =
        "[-] Teleport To Reroll Machine on: goes to the machine first (like Yuto).\n" ..
        "[-] Use 0.5-0.7 delay when rolling more than 1 pet.\n" ..
        "[-] If your ping > 500ms use 0.8 - 1s to keep your passive safe.\n" ..
        "[-] Fewer pets selected = better performance." })
    local pets = p:Dropdown({ Title = "Select Pets To Roll", Items = Data.Pets(), Multi = true, CountOnly = true, Flag = "PassivePets" })
    Features.PetDrops = Features.PetDrops or {}
    table.insert(Features.PetDrops, pets)
    Features.PetDropFlags = Features.PetDropFlags or {}
    Features.PetDropFlags[pets] = "PassivePets"
    -- one refresh for every pet list (Auto Reroll Passive + Lunar vs Solar), keeps what was picked
    -- a picked pet is remembered by its label; labels can change (nickname, display name, an
    -- older hub version), so after every refresh the picks are matched again by UID "[...]":
    -- an old label becomes today's label for the same pet, doubles are merged, and picks of
    -- pets you don't have any more are dropped (only once the inventory is really loaded)
    function Features.RemapPetPicks(d, list)
        local byUid = {}
        for _, label in ipairs(list) do byUid[Data.PetId(label)] = label end
        local loaded = next(Data.InventoryIndex) ~= nil
        local cur = d:Get()
        if type(cur) ~= "table" then return end
        local new, changed = {}, false
        for label, on in pairs(cur) do
            if on then
                local now = byUid[Data.PetId(label)]
                if now then
                    if now ~= label then changed = true end
                    new[now] = true
                elseif loaded then
                    changed = true                       -- that pet is gone
                else
                    new[label] = true                    -- inventory not read yet: keep it
                end
            end
        end
        local n1, n2 = 0, 0
        for _ in pairs(cur) do n1 = n1 + 1 end
        for _ in pairs(new) do n2 = n2 + 1 end
        if changed or n1 ~= n2 then d:Set(new, true) end
    end
    -- THE GAME GIVES EVERY PET A NEW UID EACH TIME YOU JOIN (seen: the same "Lucky" Femto was
    -- 866728, then 757944 after a rejoin). So the Lunar picks are also kept as a fingerprint of
    -- the pet that doesn't change (PetId, nickname, FusedXP, BaseLevel, Shiny, Void, look) in
    -- CONFIG/<name>_pets.json, and after a join they're found again by that fingerprint.
    -- Identical fingerprints (same fodder pet twice) are handed out one per pick.
    Features.PicksReady = false
    local KEEP_PICKS = { EQPets = true }
    -- the fingerprints live in the normal config as a hidden flag "<flag>Sigs" (saved / loaded
    -- with everything else, no extra file)
    local pickSigs = {}
    for flag in pairs(KEEP_PICKS) do
        Library.Flags[flag .. "Sigs"] = { Type = "Hidden",
            Get = function() return pickSigs[flag] end,
            Set = function(_, v) if type(v) == "table" then pickSigs[flag] = v end end }
    end
    function Data.PetSig(raw)
        if type(raw) ~= "table" then return nil end
        return table.concat({ tostring(raw.PetId), tostring(raw.CustomName or ""), tostring(raw.FusedXP or 0),
            tostring(raw.BaseLevel or 0), tostring(raw.Shiny), tostring(raw.Void), tostring(raw.AppearanceId or ""),
            tostring(raw.Skin or "") }, "|")
    end
    -- uid -> the pet's record in the save (GameData.Pets), read fresh
    local function savedPets()
        local out = {}
        local st = Data.StoreData()
        for _, t in pairs(st and type(st.Pets) == "table" and st.Pets or {}) do
            if type(t) == "table" and t.UID ~= nil then out[tostring(t.UID)] = t end
        end
        return out
    end
    function Features.SavePetPicks(flag, set)
        if not KEEP_PICKS[flag] or not Features.PicksReady or not Features.ConfigLoaded then return end
        local pets, sigs = savedPets(), {}
        for label, on in pairs(set or {}) do
            local sig = on and Data.PetSig(pets[Data.PetId(label)])
            if sig then sigs[#sigs + 1] = sig end
        end
        pickSigs[flag] = sigs
    end
    -- after a join: today's labels for the saved fingerprints
    local function restorePicks(d, flag, list)
        local sigs = pickSigs[flag]
        local pets, bySig = savedPets(), {}
        for _, label in ipairs(list) do
            local sig = Data.PetSig(pets[Data.PetId(label)])
            if sig then bySig[sig] = bySig[sig] or {} table.insert(bySig[sig], label) end
        end
        local new, n, want = {}, 0, type(sigs) == "table" and #sigs or 0
        for _, sig in ipairs(type(sigs) == "table" and sigs or {}) do
            local pool = bySig[sig]
            if pool and #pool > 0 then new[table.remove(pool, 1)] = true n = n + 1 end
        end
        -- the labels in the config hold LAST game's UIDs (= other pets now): never keep those
        d:Set(new, true)
        if want > 0 then Util.Notify(string.format("Lunar pets: %d/%d picked again", n, want)) end
        return want > 0
    end
    function Features.RefreshPetLists(silent)
        Data.Inventory(true)
        local list = Data.Pets()
        local loaded = next(savedPets()) ~= nil
        for _, d in ipairs(Features.PetDrops) do
            pcall(d.Refresh, d, list)
            local flag = Features.PetDropFlags and Features.PetDropFlags[d]
            if not Features.PicksReady and loaded and Features.ConfigLoaded and flag and KEEP_PICKS[flag] then
                pcall(restorePicks, d, flag, list)
            else
                pcall(Features.RemapPetPicks, d, list)
            end
        end
        -- only after the config is loaded: before that the fingerprints aren't there yet, and
        -- loading the config afterwards would put last game's labels back over the restored picks
        if loaded and Features.ConfigLoaded and not Features.PicksReady then
            Features.PicksReady = true
            -- keep the old fingerprints if nothing matched (e.g. the save was half loaded):
            -- they're only replaced when you pick pets yourself
            for d, flag in pairs(Features.PetDropFlags or {}) do
                if KEEP_PICKS[flag] and next(d:Get() or {}) then Features.SavePetPicks(flag, d:Get()) end
            end
        end
        if not silent then Util.Notify(#list .. " pets ( equipped + inventory )") end
        return list
    end
    p:Button({ Title = "Refresh Pets", Callback = function() Features.RefreshPetLists() end })
    local names = Data.Passives()
    p:Dropdown({ Title = "Select Passive To Roll", Items = names, Multi = true, Flag = "PassiveNames" })
    p:Dropdown({ Title = "Select Passive Rarity", Items = Data.PassiveRarities(), Multi = true, Flag = "PassiveRarity" })
    p:Dropdown({ Title = "Select Passive Slot", Items = { "1", "2", "3" }, Multi = true, Default = { ["1"] = true }, Flag = "PassiveSlots" })
    p:Dropdown({ Title = "Select Passive Reroll Mode", Items = { "Keep Selected Rarity", "Keep Selected Passive" }, Default = "Keep Selected Passive", Required = true, Flag = "PassiveMode" })
    p:Dropdown({ Title = "Select Passive Machine", Items = Data.PassiveMachines(), Default = "Normal", Required = true, Flag = "PassiveMachine" })
    p:Dropdown({ Title = "Reroll With", Items = CFG.RerollMethods, Default = "Token", Required = true, Flag = "PassiveMethod" })
    p:Slider({ Title = "Delayed [seconds]", Min = 0.1, Max = 2, Default = 0.5, Decimals = 1, Flag = "PassiveDelay" })
    p:Toggle({ Title = "Teleport To Reroll Machine", Default = true, Flag = "PassiveGoMachine" })
    p:Toggle({ Title = "Auto Reroll Passive !", Flag = "AutoPassive", Callback = function(v) if v then Features.ResetPassive() end end })
    if #names == 0 then
        p:Paragraph({ Body = "PassiveStats module could not be read. Type a passive name below instead." })
        p:Input({ Title = "Passive Name", Placeholder = "e.g. Demon", Callback = function(v)
            if v ~= "" then Flags.PassiveNames:Refresh({ v }) Flags.PassiveNames:Set({ [v] = true }) end
        end })
    end
    Refreshers[#Refreshers + 1] = function() pets:Refresh(Data.Pets()) end

    local s = TPassive:Card(nil, "Right")
    PassiveStatus = s:Paragraph({ Body = "Status : -" })
end

