-- Webhook -------------------------------------------------------------------
function Features.Webhook(header)
    local send = (syn and syn.request) or (http and http.request) or http_request or request
    if not send or State.Webhook == "" then return end
    local yen = "?"
    pcall(function()
        for _, stat in ipairs(LP.leaderstats:GetChildren()) do
            if stat.Name ~= "Rank" then yen = tostring(stat.Value) break end
        end
    end)
    local fields = {
        { name = "World",           value = Util.World() ~= "" and Util.World() or "-", inline = true },
        { name = "Yen",             value = yen,                                       inline = true },
        { name = "Inf Tower Best",  value = tostring(State.InfBest),                   inline = true },
        { name = "Dungeon Runs",    value = tostring(State.DungeonRuns),               inline = true },
        { name = "Gate Runs",       value = tostring(State.GateRuns),                  inline = true },
    }
    pcall(send, {
        Url = State.Webhook, Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = HttpService:JSONEncode({
            embeds = { {
                title = header, color = 0x7269DA,
                description = "Player: ||" .. LP.Name .. "||",
                fields = fields,
                footer = { text = CFG.HubName },
                timestamp = DateTime.now():ToIsoDate(),
            } },
        }),
    })
end

-- FPS boost -------------------------------------------------------------------
function Features.FpsBoost()
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 1e9
    for _, fx in ipairs(Lighting:GetChildren()) do
        if fx:IsA("PostEffect") then fx.Enabled = false end
    end
    local terrain = workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        terrain.WaterWaveSize, terrain.WaterWaveSpeed = 0, 0
        terrain.WaterReflectance, terrain.WaterTransparency = 0, 1
    end
    local function lighten(obj)
        if obj:IsA("BasePart") then
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
            obj.CastShadow = false
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
            obj.Enabled = false
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 1
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do pcall(lighten, obj) end
    workspace.DescendantAdded:Connect(function(obj) pcall(lighten, obj) end)
    Util.Notify("FPS boost on")
end

