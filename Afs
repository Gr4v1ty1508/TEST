function Features.Raid()
    if Util.World() == "Raid" then
        Combat.Step("Raid", function() return On("AutoRaid") end, nil, F("RaidTarget") or "Nearest")
        return true
    end
    if not Util.Every("raid-join", CFG.JoinCooldown) then return false end
    -- Worlds.Raid.RaidData: CurrentWorld / CurrentRaid (StringValue, "" = none),
    -- Giant / Massive (BoolValue) = the mode; each world's RaidBeacon has @Active
    local active, mode
    pcall(function()
        local rd = Worlds.Raid.RaidData
        for _, n in ipairs({ "CurrentWorld", "CurrentRaid" }) do
            local v = rd:FindFirstChild(n)
            if v and v.Value ~= nil and tostring(v.Value) ~= "" then active = tostring(v.Value) break end
        end
        local massive, giant = rd:FindFirstChild("Massive"), rd:FindFirstChild("Giant")
        mode = (massive and massive.Value and "Massive") or (giant and giant.Value and "Giant") or "Normal"
    end)
    if not active then
        for _, f in ipairs(Worlds:GetChildren()) do
            local b = f:FindFirstChild("RaidBeacon")
            if b and b:GetAttribute("Active") == true then active = f.Name break end
        end
    end
    local worlds, modes = worldsFrom("RaidWorlds"), F("RaidModes") or {}
    local worldOk = On("RaidAllWorlds") or contains(worlds, active)
    local modeOk = not next(modes) or mode == nil or modes[mode]
    if not modeOk and type(mode) == "string" then
        for m, on in pairs(modes) do
            if on and string.find(string.lower(mode), string.lower(m), 1, true) then modeOk = true break end
        end
    end
    if active and worldOk and modeOk then
        Net.Call("JoinRaid", active, mode)
        task.wait(1.5)
        -- still outside: walk into the active world's raid beacon like a player
        if Util.World() ~= "Raid" then
            local w = Worlds:FindFirstChild(active)
            local beacon = w and w:FindFirstChild("RaidBeacon")
            if beacon then
                if Util.World() ~= active then Travel.To(active) end
                local p = beacon:FindFirstChildWhichIsA("ProximityPrompt", true)
                if p then Prompt.Use(p) else
                    local part = beacon:FindFirstChildWhichIsA("BasePart", true)
                    local root = Util.Root()
                    if part and root then
                        Util.MoveTo(part.CFrame)
                        if firetouchinterest then
                            pcall(firetouchinterest, root, part, 0) task.wait(0.1) pcall(firetouchinterest, root, part, 1)
                        end
                    end
                end
            end
        end
        return true
    end
    return false
end

