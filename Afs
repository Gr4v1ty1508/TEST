    })
end

function Features.FpsBoost()
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 1e9
    for _, fx in ipairs(Lighting:GetChildren()) do if fx:IsA("PostEffect") then fx.Enabled = false end end
    local function lighten(o)
        if o:IsA("BasePart") then o.Material = Enum.Material.SmoothPlastic o.Reflectance = 0 o.CastShadow = false
        elseif o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Beam") then o.Enabled = false
        elseif o:IsA("Decal") or o:IsA("Texture") then o.Transparency = 1 end
    end
    for _, o in ipairs(workspace:GetDescendants()) do pcall(lighten, o) end
    track(workspace.DescendantAdded:Connect(function(o) pcall(lighten, o) end))
    Util.Notify("FPS boost on")
end

