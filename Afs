-- FEATURES
------------------------------------------------------------------------
local Flags = Library.Flags
local function F(flag)
    local el = Flags[flag]
    if not el then return nil end
    return el:Get()
end
local function On(flag) return F(flag) == true end
local function worldsFrom(flag)
    local out = {}
    for _, label in ipairs(Util.SetToList(F(flag))) do out[#out + 1] = Data.FromLabel(label) end
    return out
end
local function contains(t, v) for _, x in ipairs(t) do if x == v then return true end end return false end

local Features = {}
local Stats = { InfFloor = 1, InfBest = 0, DungeonRuns = 0, GateRuns = 0, TrialFloor = 0, TrialName = nil, Rebirths = 0 }
local HomeWorld = Util.World()

-- MAIN ------------------------------------------------------------------------
function Features.Farm()
    local world = Util.World()
    local selectedWorlds = worldsFrom("FarmWorlds")
    if On("OnlySelectedWorld") and #selectedWorlds > 0 and not contains(selectedWorlds, world) then
        Travel.To(selectedWorlds[1])
        return
    end
    local wanted = function() return On("AutoFarm") end

    if On("FocusRebirthBoss") then
        local bosses = Data.RebirthBosses()
        if next(bosses) and Combat.Step(world, wanted, bosses, "Nearest") then return end
    end

    local mode = F("FarmMode") or "Nearest"
    if mode == "Mobs Selected" then
        local mobs = F("FarmMobs") or {}
        if not next(mobs) then return end
        Combat.Step(world, wanted, mobs, "Nearest")
    else
        Combat.Step(world, wanted, nil, mode)
    end
end

function Features.Monsters()
    local worlds = worldsFrom("FarmWorlds")
    if #worlds == 0 then worlds = { Util.World() } end
    local seen, out = {}, {}
    for _, w in ipairs(worlds) do
        for _, e in ipairs(Combat.List(w)) do
            local n = Combat.Name(e)
            if not seen[n] then seen[n] = true out[#out + 1] = n end
        end
    end
    table.sort(out)
    return out
end

function Features.Quest()
    local world = Util.World()
    if Util.Every("quest", 10) then
        local finished = Net.Call("FinishQuest", world)
        if On("SkipQuest") then Net.Call("SkipQuest") end
        Net.Call("StartQuest", world)
        if finished and On("NextQuestWorld") then
            local order, discovered = Data.FarmWorlds(), LP:FindFirstChild("Discovered")
            for i, w in ipairs(order) do
                if w == world then
                    local nxt = order[i + 1]
                    if nxt and (not discovered or discovered:FindFirstChild(nxt)) then Travel.To(nxt) end
                    break
                end
            end
        end
    end
end

function Features.NextWorld()
    local order, world = Data.FarmWorlds(), Util.World()
    for i, w in ipairs(order) do
        if w == world then
            local nxt = order[i + 1]
            if not nxt then return end
            Net.Call("DiscoverWorld", nxt)
            task.wait(1)
            local discovered = LP:FindFirstChild("Discovered")
            if not discovered or discovered:FindFirstChild(nxt) then Travel.To(nxt) end
            return
        end
    end
end

-- fire every client handler hooked to a GUI signal (executor getconnections / firesignal)
local function fireGui(obj, signalNames)
    for _, sig in ipairs(signalNames) do
        local ok, signal = pcall(function() return obj[sig] end)
        if ok and signal then
            if firesignal then
                pcall(firesignal, signal)
            elseif getconnections then
                pcall(function() for _, c in ipairs(getconnections(signal)) do c:Fire() end end)
            end
        end
    end
end
Features.FireGui = fireGui

local PICKUP_WORDS = { "Yen", "Pickup", "Drop", "Coin", "Orb", "Gem", "Item", "Fruit", "Ticket", "Shard", "Boost", "Key" }
local function isPickup(name)
    for _, w in ipairs(PICKUP_WORDS) do if string.find(name, w, 1, true) then return true end end
    return false
end
local function touch(root, part)
    if firetouchinterest then
        pcall(firetouchinterest, root, part, 0)
        pcall(firetouchinterest, root, part, 1)
    end
    if not part.Anchored or firetouchinterest == nil then pcall(function() part.CFrame = root.CFrame end) end
end
function Features.Collect()
    local root = Util.Root()
    if not root then return end
    -- 1) drops in the world (workspace.Effects / any Pickups folder)
    local folders = {}
    local effects = workspace:FindFirstChild("Effects")
    if effects then folders[#folders + 1] = effects end
    for _, name in ipairs({ "Pickups", "Drops" }) do
        local f = workspace:FindFirstChild(name)
        if f then folders[#folders + 1] = f end
    end
    for _, folder in ipairs(folders) do
        for _, drop in ipairs(folder:GetChildren()) do
            if folder ~= effects or isPickup(drop.Name) then
                if drop:IsA("BasePart") then touch(root, drop)
                else
                    for _, part in ipairs(drop:GetDescendants()) do
                        if part:IsA("BasePart") then touch(root, part) end
                    end
                end
            end
        end
    end
    -- 2) on-screen pickups (PickupGui): run the game's own collect handlers
    local pg = LP:FindFirstChild("PlayerGui")
    local gui = pg and pg:FindFirstChild("PickupGui")
    local holder = gui and gui:FindFirstChild("Pickups")
    if holder then
        for _, b in ipairs(holder:GetDescendants()) do
            if b:IsA("GuiButton") then
                fireGui(b, { "MouseEnter", "MouseButton1Down", "MouseButton1Click", "Activated" })
            elseif b:IsA("GuiObject") and b.Parent == holder then
                fireGui(b, { "MouseEnter" })
            end
        end
    end
end

