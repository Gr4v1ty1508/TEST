            tab._cards = tab._cards + 1
            local col = tab.Columns[side or "Left"] or left
            local frame = make("Frame", { BackgroundColor3 = Theme.Card, Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = tab._cards, Parent = col },
