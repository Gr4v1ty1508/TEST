loop(1, function()
    if not State.CollectYen then return end
    local root, effects = Util.Root(), workspace:FindFirstChild("Effects")
    if not root or not effects then return end
    for _, drop in ipairs(effects:GetChildren()) do
        if drop.Name == "Yen" then
            local part = drop:FindFirstChild("Base") or drop:FindFirstChildWhichIsA("BasePart")
            if part then part.CFrame = root.CFrame end
        end
    end
end)

