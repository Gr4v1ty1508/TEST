function Elements:Slider(opt)
    local r = row(self, 36)
    local min, max, dec = opt.Min or 0, opt.Max or 100, opt.Decimals or 0
    text({ Text = opt.Title, TextColor3 = Theme.Sub, Size = UDim2.new(1, -150, 1, 0), Parent = r })
    local box = make("TextBox", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(54, 28), BackgroundColor3 = Theme.Window, Text = "", Font = Enum.Font.Gotham,
        TextSize = 12, TextColor3 = Theme.Text, ClearTextOnFocus = false, Parent = r }, { corner(6), stroke() })
    local bar = make("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -66, 0.5, 0),
        Size = UDim2.fromOffset(70, 4), BackgroundColor3 = Theme.Stroke, Parent = r }, { corner(2) })
    local fill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Sub, Parent = bar }, { corner(2) })
    local knob = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Theme.Accent, Parent = bar }, { corner(7) })

    local value
    local obj = { Type = "Slider" }
    local function round(v)
        local m = 10 ^ dec
        return math.floor(v * m + 0.5) / m
    end
    function obj:Set(v, silent)
        v = tonumber(v) or min
        value = math.clamp(round(v), min, max)
        local pct = (value - min) / math.max(max - min, 1e-9)
        fill.Size = UDim2.fromScale(pct, 1)
        knob.Position = UDim2.fromScale(pct, 0.5)
        box.Text = dec > 0 and string.format("%." .. dec .. "f", value) or tostring(value)
        if not silent and opt.Callback then pcall(opt.Callback, value) end
    end
    function obj:Get() return value end

    local sliding = false
    local function fromX(x)
        local pct = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        obj:Set(min + (max - min) * pct)
    end
    local hit = make("TextButton", { Text = "", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, -6, 0.5, 0), Size = UDim2.new(1, 12, 0, 24), Parent = bar })
    hit.InputBegan:Connect(function(input) if isPress(input) then sliding = true fromX(input.Position.X) end end)
    track(UIS.InputChanged:Connect(function(input) if sliding and isMove(input) then fromX(input.Position.X) end end))
    track(UIS.InputEnded:Connect(function(input) if isPress(input) then sliding = false end end))
    box.FocusLost:Connect(function() obj:Set(box.Text) end)

    obj:Set(opt.Default or min, opt.Silent)
    return register(opt.Flag, obj)
end

