-- TIME TRIAL / TOWER ----------------------------------------------------------------
local trialIndex = 0
function Features.TimeTrial()
    local world = Util.World()
    if world == "Tower" then
        local wanted = function() return On("AutoTrial") end
        local trialName = Stats.TrialName
        if On("AutoLeaveTrial") and trialName then
            local limit = F("Leave_" .. trialName)
            if limit and Stats.TrialFloor >= limit then
                Util.Notify("Leaving " .. trialName .. " at floor " .. Stats.TrialFloor)
                Travel.To(HomeWorld ~= "" and HomeWorld or Data.FarmWorlds()[1])
                return true
            end
        end
        if Combat.Step("Tower", wanted, nil, F("TrialTarget") or "Nearest") then return true end
        local tower = Worlds:FindFirstChild("Tower")
        if not On("TrialIgnoreChest") then
            for _, p in ipairs(Prompt.Find(tower, { "chest" })) do Prompt.Use(p) task.wait(0.2) end
        end
        for _, obj in ipairs(tower and tower:GetDescendants() or {}) do
            if obj.Name == "ConfirmPart" then
                local p = obj:FindFirstChildOfClass("ProximityPrompt")
                if p and p.Enabled and Util.Every("trial-room", 2) then
                    Prompt.Use(p)
                    Stats.TrialFloor = Stats.TrialFloor + 1
                end
            end
        end
        return true
    end
    local trials = Util.SetToList(F("Trials"))
    if #trials == 0 then return false end
    if Util.Every("trial-join", 15) then
        if CFG.ModeWorlds[world] == nil then HomeWorld = world end
        trialIndex = trialIndex % #trials + 1
        Stats.TrialName, Stats.TrialFloor = trials[trialIndex], 0
        Net.Call("JoinTimeTrial", trials[trialIndex])
    end
    return false
end

function Features.InfinityTower()
    if Util.World() == "InfinityTower" then
        local fought = Combat.Step("InfinityTower", function() return On("AutoInf") end, nil, F("InfTarget") or "Nearest")
        if not fought and not On("InfAllTiers") and Util.Every("inf-stop", 5) then
            Flags.AutoInf:Set(false)
            Util.Notify("Floor cleared - Climb All Tiers is off")
        end
    elseif Util.Every("inf-join", CFG.JoinCooldown) then
        Net.Call("SetInfFloor", Stats.InfFloor)
        task.wait(0.5)
        Net.Call("JoinInfTower")
    end
end

-- RAID / DEFENSE / METEOR ------------------------------------------------------------
function Features.Raid()
    if Util.World() == "Raid" then
        Combat.Step("Raid", function() return On("AutoRaid") end)
        return true
    end
    if not Util.Every("raid-join", CFG.JoinCooldown) then return false end
    local active, mode
    pcall(function()
        local rd = Worlds.Raid.RaidData
        local w = rd:FindFirstChild("CurrentWorld") or rd:FindFirstChild("CurrentRaid")
        local m = rd:FindFirstChild("CurrentMode") or rd:FindFirstChild("Mode") or rd:FindFirstChild("Difficulty")
        active, mode = w and w.Value, m and m.Value
    end)
    local worlds, modes = worldsFrom("RaidWorlds"), F("RaidModes") or {}
    local worldOk = On("RaidAllWorlds") or contains(worlds, active)
    local modeOk = not next(modes) or mode == nil or modes[mode]
    if active and worldOk and modeOk then
        Net.Call("JoinRaid", active, mode)
        return true
    end
    return false
end

local defenseActive = false
function Features.Defense()
    local world = Util.World()
    if defenseActive then
        if Data.IsFarmWorldName(world) then
            defenseActive = false
        else
            Combat.Step(world, function() return On("AutoDefense") end)
            return true
        end
    end
    local target = F("DefenseWorld")
    if target and Util.Every("defense-join", 15) then
        Net.Call("JoinDefense", Data.FromLabel(target), On("DefenseFriends"))
        task.wait(2)
        if Util.World() ~= world then defenseActive = true end
    end
    return false
end

function Features.Meteor()
    local worlds = On("MeteorAllWorlds") and Data.FarmWorlds() or worldsFrom("MeteorWorlds")
    local current = Util.World()
    if contains(worlds, current) or #worlds == 0 then
        if Combat.Step(current, function() return On("AutoMeteor") end, CFG.MeteorNames) then return true end
    end
    for _, w in ipairs(worlds) do
        if w ~= current and #Combat.List(w, CFG.MeteorNames) > 0 then
            Travel.To(w)
            return true
        end
    end
    return false
end

