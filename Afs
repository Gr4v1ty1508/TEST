local Util = {}

function Util.Notify(text)
    pcall(StarterGui.SetCore, StarterGui, "SendNotification", {
        Title = CFG.HubName, Text = tostring(text), Duration = 4,
    })
end

local cooldowns = {}
function Util.Every(key, seconds)
    local now = os.clock()
    if not cooldowns[key] or now - cooldowns[key] >= seconds then
        cooldowns[key] = now
        return true
    end
    return false
end
function Util.ResetCooldown(key) cooldowns[key] = nil end

function Util.Root()
    local char = LP.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

function Util.Humanoid()
    local char = LP.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

function Util.MoveTo(cframe)
    local root = Util.Root()
    if root and cframe then root.CFrame = cframe end
end

function Util.World()
    local value = LP:FindFirstChild("World")
    return value and value.Value or ""
end

-- remote layer ---------------------------------------------------------
local Net = {}

local function invokeSafe(remote, args, timeout)
    local finished, result = false, nil
    task.spawn(function()
        local ok, res = pcall(remote.InvokeServer, remote, table.unpack(args))
        if ok then result = res else warn("[" .. CFG.HubName .. "] " .. remote.Name .. ": " .. tostring(res)) end
        finished = true
    end)
    local started = os.clock()
    while not finished and os.clock() - started < (timeout or 6) do task.wait() end
    return result
end

function Net.Raw(name, args)
    local remote = Remotes:FindFirstChild(name)
    if not remote then
        warn("[" .. CFG.HubName .. "] missing remote " .. name)
        return nil
    end
    if remote:IsA("RemoteFunction") then
        return invokeSafe(remote, args)
    end
    pcall(remote.FireServer, remote, table.unpack(args))
    return nil
end

function Net.Call(key, ...)
    local entry = CFG.Calls[key]
    if not entry then warn("[" .. CFG.HubName .. "] no CFG.Calls." .. tostring(key)) return nil end
    return Net.Raw(entry[1], entry[2](...))
end

function Net.Listen(name, handler)
    local remote = Remotes:FindFirstChild(name)
    if remote and remote:IsA("RemoteEvent") then
        remote.OnClientEvent:Connect(function(...)
            local ok, err = pcall(handler, ...)
            if not ok then warn(err) end
        end)
    end
end

-- enemies ---------------------------------------------------------------
local Combat = {}
local SendPet = Bindables:FindFirstChild("SendPet")

function Combat.IsAlive(enemy)
    if not enemy or not enemy.Parent or not enemy:FindFirstChild("HumanoidRootPart") then return false end
    local hp = enemy:FindFirstChild("Health")
    return hp == nil or hp.Value > 0
end

function Combat.Name(enemy)
    local tag = enemy:FindFirstChild("DisplayName")
    return tag and tag.Value or enemy.Name
end

function Combat.List(worldName, onlyName)
    local out = {}
    local world = Worlds:FindFirstChild(worldName or "")
    if not world then return out end
    local usedFolders = false
    for _, obj in ipairs(world:GetDescendants()) do
        if obj.Name == "Enemies" and obj:IsA("Folder") then
            usedFolders = true
            for _, enemy in ipairs(obj:GetChildren()) do
                if Combat.IsAlive(enemy) and (not onlyName or Combat.Name(enemy) == onlyName) then
                    out[#out + 1] = enemy
                end
            end
        end
    end
    if not usedFolders then
        for _, enemy in ipairs(world:GetDescendants()) do
            if enemy:FindFirstChild("DisplayName") and Combat.IsAlive(enemy)
               and (not onlyName or Combat.Name(enemy) == onlyName) then
                out[#out + 1] = enemy
            end
        end
    end
    return out
end

function Combat.Closest(list)
    local root = Util.Root()
    if not root then return list[1] end
    local best, bestDist = nil, math.huge
    for _, enemy in ipairs(list) do
        local part = enemy:FindFirstChild("HumanoidRootPart")
        if part then
            local dist = (part.Position - root.Position).Magnitude
            if dist < bestDist then best, bestDist = enemy, dist end
        end
    end
    return best
end

function Combat.Attack(enemy, stillWanted)
    local started = os.clock()
    while Combat.IsAlive(enemy) and stillWanted() and os.clock() - started < CFG.KillTimeout do
        local root, part = Util.Root(), enemy:FindFirstChild("HumanoidRootPart")
        if root and part and (root.Position - part.Position).Magnitude > 12 then
            root.CFrame = part.CFrame * CFrame.new(0, 0, 4)
        end
        if SendPet then pcall(SendPet.Fire, SendPet, enemy, true) end
        task.wait()
    end
end

-- attacks the closest enemy; returns false when the world has none left
function Combat.Step(worldName, stillWanted, onlyName)
    local target = Combat.Closest(Combat.List(worldName, onlyName))
    if not target then return false end
    Combat.Attack(target, stillWanted)
    return true
end

-- prompts ---------------------------------------------------------------
local Prompt = {}

function Prompt.Find(root, keywords)
    local found = {}
    if not root then return found end
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local text = string.lower((obj.Parent and obj.Parent.Name or "") .. " " .. obj.ActionText .. " " .. obj.ObjectText)
            for _, word in ipairs(keywords) do
                if string.find(text, word, 1, true) then found[#found + 1] = obj break end
            end
        end
    end
    return found
end

function Prompt.Use(prompt)
    local holder = prompt.Parent
    if holder and holder:IsA("BasePart") then Util.MoveTo(holder.CFrame * CFrame.new(0, 3, 0)) end
    task.wait(0.25)
    if fireproximityprompt then
        pcall(fireproximityprompt, prompt)
    else
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration + 0.05)
            prompt:InputHoldEnd()
        end)
    end
end

