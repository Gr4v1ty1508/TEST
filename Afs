-- Infinity Tower ----------------------------------------------------------
function Features.InfinityTower()
    if Util.World() == "InfinityTower" then
        local fought = Combat.Step("InfinityTower", function() return State.Inf end)
        if not fought and not State.InfAllTiers then
            State.Inf = false
            if InfToggle then InfToggle:Set(false, true) end
            Util.Notify("Floor cleared - stopped (All Tiers is off)")
        end
    elseif Util.Every("inf-join", CFG.JoinCooldown) then
        Net.Call("SetInfFloor", State.InfFloor)
        task.wait(0.5)
        Net.Call("JoinInfTower")
    end
end

-- Dungeon -----------------------------------------------------------------
function Features.Dungeon()
    if Util.World() ~= "Dungeon" then
        if Util.Every("dungeon-join", CFG.JoinCooldown) then
            Net.Call("DungeonSetting", "Difficulty", State.DungeonDiff)
            Net.Call("SummonDungeon", State.DungeonDiff)
            task.wait(1)
            Net.Call("JoinDungeon")
        end
        return
    end
    if Combat.Step("Dungeon", function() return State.Dungeon end) then return end

    local root = Worlds:FindFirstChild("Dungeon")
    if State.DungeonChests then
        for _, p in ipairs(Prompt.Find(root, { "chest", "treasure" })) do
            Prompt.Use(p)
            Net.Call("OpenChest", p.Parent)
            task.wait(0.3)
        end
    end
    if State.DungeonDoors and Util.Every("dungeon-door", 3) then
        local door = Prompt.Find(root, { "door", "next", "open" })[1]
        if door then
            Prompt.Use(door)
            Net.Call("OpenDungeonDoor", door.Parent)
        end
    end
end

-- Gates -------------------------------------------------------------------
function Features.Gates()
    if Util.World() ~= "GatesMode" then
        if Util.Every("gates-join", CFG.JoinCooldown) then
            Net.Call("SummonGate", State.GateRank)
            task.wait(1)
            Net.Call("JoinGates")
        end
        return
    end
    local fought = Combat.Step("GatesMode", function() return State.Gates end)
    if not fought and State.GateSkip and Util.Every("gates-skip", 3) then
        Net.Call("SkipGateWait")
    end
end

-- Raid --------------------------------------------------------------------
function Features.Raid()
    if Util.World() == "Raid" then
        Combat.Step("Raid", function() return State.Raid end)
        return
    end
    if not State.RaidWorld or not Util.Every("raid-join", CFG.JoinCooldown) then return end
    local active
    pcall(function()
        local data = Worlds.Raid.RaidData
        local v = data:FindFirstChild("CurrentWorld") or data:FindFirstChild("CurrentRaid")
        active = v and v.Value
    end)
    if active == State.RaidWorld then Net.Call("JoinRaid") end
end

-- Time Trial --------------------------------------------------------------
function Features.TimeTrial()
    if Util.World() == "Tower" then
        local fought = Combat.Step("Tower", function() return State.Trial end)
        if not fought and State.TrialSkip then
            local tower = Worlds:FindFirstChild("Tower")
            for _, obj in ipairs(tower and tower:GetDescendants() or {}) do
                if obj.Name == "ConfirmPart" then
                    local p = obj:FindFirstChildOfClass("ProximityPrompt")
                    if p then Prompt.Use(p) end
                end
            end
        end
        return true
    end
    if State.TrialJoin and Util.Every("trial-join", 15) then
        Net.Call("JoinTimeTrial")
        return true
    end
    return false
end

-- Normal farm -------------------------------------------------------------
function Features.Farm()
    local only = (State.FarmTarget ~= "Nearest") and State.FarmTarget or nil
    Combat.Step(Util.World(), function() return State.Farm end, only)
end

-- one brain: highest-priority mode that is on gets the character
local function Brain()
    if State.Inf then return Features.InfinityTower() end
    if State.Dungeon then return Features.Dungeon() end
    if State.Gates then return Features.Gates() end
    if State.Raid then return Features.Raid() end
    if State.Trial and Features.TimeTrial() then return end
    if State.Meteor and Combat.Step(Util.World(), function() return State.Meteor end, "Meteor") then return end
    if State.Farm then Features.Farm() end
end

-- Eggs --------------------------------------------------------------------
function Features.OpenEgg()
    if Util.World() ~= State.EggWorld then
        Net.Call("Travel", State.EggWorld)
        task.wait(2)
    end
    local world = Worlds:FindFirstChild(State.EggWorld)
    local egg = world and world:FindFirstChild(State.Egg, true)
    if not egg then return end
    local root = Util.Root()
    local pivot = egg:GetPivot()
    if root and (root.Position - pivot.Position).Magnitude > 12 then
        Util.MoveTo(pivot * CFrame.new(0, 0, 7))
        task.wait(0.4)
    end
    Net.Call("OpenEgg", egg, CFG.EggAmount[State.EggMode] or 1)
end

-- Passive -----------------------------------------------------------------
local passiveRolls, passiveDone = {}, {}

local function readPassive(petId, serverReply)
    local folder = LP:FindFirstChild("Pets")
    local pet = folder and folder:FindFirstChild(petId)
    if pet then
        for _, key in ipairs({ "Passive", "PassiveName", "CurrentPassive" }) do
            local attr = pet:GetAttribute(key)
            if attr ~= nil then return tostring(attr) end
            local child = pet:FindFirstChild(key)
            if child and child:IsA("ValueBase") then return tostring(child.Value) end
        end
    end
    if serverReply ~= nil then
        if type(serverReply) == "table" then
            local ok, json = pcall(HttpService.JSONEncode, HttpService, serverReply)
            return ok and json or nil
        end
        return tostring(serverReply)
    end
    return nil
end

local PassiveStatus
local function updatePassiveStatus()
    if not PassiveStatus then return end
    local total, done = 0, 0
    for id in pairs(State.PassivePets) do
        total = total + 1
        if passiveDone[id] then done = done + 1 end
    end
    PassiveStatus:Set("Pets: " .. total .. "   Done: " .. done)
end

local cantReadWarned = false
function Features.PassiveRound()
    local remaining = 0
    local target = string.lower(State.PassiveTarget)
    for petId in pairs(State.PassivePets) do
        if not State.Passive then return end
        if not passiveDone[petId] then
            remaining = remaining + 1
            passiveRolls[petId] = (passiveRolls[petId] or 0) + 1
            local reply = Net.Call("RollPassive", petId)
            if State.PassiveConfirm then Net.Call("PickPassive", petId, true) end
            task.wait(State.PassiveDelay)

            local got = readPassive(petId, reply)
            if target ~= "" and got and string.find(string.lower(got), target, 1, true) then
                passiveDone[petId] = true
                Util.Notify(petId .. " -> " .. State.PassiveTarget)
            elseif target ~= "" and not got and not cantReadWarned then
                cantReadWarned = true
                Util.Notify("Can't read passive. Use Remote Spy (F9).")
            end
            if passiveRolls[petId] >= State.PassiveMax then
                passiveDone[petId] = true
            end
            updatePassiveStatus()
        end
    end
    if remaining == 0 then
        State.Passive = false
        if PassiveToggle then PassiveToggle:Set(false, true) end
        Util.Notify("Passive rolling finished")
    end
end

