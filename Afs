local Net = {}

local function invokeSafe(remote, args, timeout)
    local done, result = false, nil
    task.spawn(function()
        local ok, res = pcall(remote.InvokeServer, remote, table.unpack(args))
        if ok then result = res else warn("[" .. CFG.Name .. "] " .. remote.Name .. ": " .. tostring(res)) end
        done = true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < (timeout or 6) do task.wait() end
    return result
end

function Net.Raw(name, args)
    local r = Remotes:FindFirstChild(name)
    if not r then warn("[" .. CFG.Name .. "] missing remote " .. name) return nil end
    if r:IsA("RemoteFunction") then return invokeSafe(r, args) end
    pcall(r.FireServer, r, table.unpack(args))
    return nil
end

function Net.Call(key, ...)
    local e = CFG.Calls[key]
    if not e then warn("[" .. CFG.Name .. "] no CFG.Calls." .. tostring(key)) return nil end
    return Net.Raw(e[1], e[2](...))
end

function Net.Listen(name, fn)
    local r = Remotes:FindFirstChild(name)
    if r and r:IsA("RemoteEvent") then
        track(r.OnClientEvent:Connect(function(...)
            local ok, err = pcall(fn, ...)
            if not ok then warn(err) end
        end))
    end
end

