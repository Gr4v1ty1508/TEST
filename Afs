local Data = {}
local moduleCache = {}

function Data.Module(name)
    if moduleCache[name] ~= nil then return moduleCache[name] or nil end
    local m = Modules and Modules:FindFirstChild(name)
    local ok, res = false, nil
    if m then ok, res = pcall(require, m) end
    moduleCache[name] = (ok and type(res) == "table") and res or false
    return moduleCache[name] or nil
end

local function sortedKeys(tbl)
    local out = {}
    for k in pairs(tbl or {}) do if type(k) == "string" then out[#out + 1] = k end end
    table.sort(out)
    return out
end

-- a farm world is listed in WorldData; mode maps added in future updates
-- (no WorldData entry) are skipped automatically. Falls back to name rules
-- when WorldData can't be read.
local worldDataHits = nil
local function worldDataUsable()
    if worldDataHits == nil then
        worldDataHits = 0
        local wd = Data.Module("WorldData")
        if wd then
            for _, f in ipairs(Worlds:GetChildren()) do
                if type(wd[f.Name]) == "table" then worldDataHits = worldDataHits + 1 end
            end
        end
    end
    return worldDataHits >= 10
end
function Data.IsFarmWorld(folder)
    if not folder:IsA("Folder") or CFG.ModeWorlds[folder.Name] or string.find(folder.Name, "Gamemode", 1, true) then return false end
    if worldDataUsable() then
        local wd = Data.Module("WorldData")
        return type(wd[folder.Name]) == "table"
    end
    return true
end

function Data.IsFarmWorldName(name)
    local f = Worlds:FindFirstChild(name or "")
    return f ~= nil and Data.IsFarmWorld(f)
end

function Data.WorldInfo(name)
    local wd = Data.Module("WorldData")
    return wd and type(wd[name]) == "table" and wd[name] or nil
end

function Data.WorldDisplay(name)
    local info = Data.WorldInfo(name)
    local display = info and (info.Name or info.DisplayName or info.Title or info.WorldName)
    return type(display) == "string" and display or name
end

-- world number as shown in the game's travel list ("22 Icy Wastes").
-- 1) a number field in WorldData, 2) the travel GUI (badge text / LayoutOrder)
local worldNumCache, worldNumTime = nil, 0
local orderCache = {}
local NUMBER_FIELDS = { "WorldNumber", "Number", "Num", "Order", "Index", "LayoutOrder", "WorldIndex", "Id", "ID" }
local function shortNumber(text)
    if type(text) ~= "string" or #text > 14 then return nil end
    local n = string.match(text, "^%D*(%d+)%D*$")
    return n and tonumber(n) or nil
end
-- remembered world positions (GravityHub/AFS/world_order.json) so a
-- favourited world keeps its real place in the list
local ORDER_FILE = CFG.ConfigFolder .. "/world_order.json"
function Data.LoadWorldOrderCache()
    local ok, t = pcall(function()
        if not (isfile and readfile) or not isfile(ORDER_FILE) then return {} end
        return HttpService:JSONDecode(readfile(ORDER_FILE))
    end)
    return (ok and type(t) == "table") and t or {}
end
function Data.SaveWorldOrderCache(t)
    pcall(function()
        if not writefile then return end
        if isfolder and makefolder then
            local cur = ""
            for part in string.gmatch(CFG.ConfigFolder, "[^/]+") do
                cur = cur == "" and part or (cur .. "/" .. part)
                if not isfolder(cur) then makefolder(cur) end
            end
        end
        writefile(ORDER_FILE, HttpService:JSONEncode(t))
    end)
end
local function buildWorldNumbers()
    local map, byDisplay = {}, {}
    for _, f in ipairs(Worlds:GetChildren()) do
        if f:IsA("Folder") then
            local info = Data.WorldInfo(f.Name)
            if info then
                for _, k in ipairs(NUMBER_FIELDS) do
                    if type(info[k]) == "number" then map[f.Name] = info[k] break end
                end
            end
            byDisplay[string.lower(Data.WorldDisplay(f.Name))] = f.Name
            byDisplay[string.lower(f.Name)] = f.Name
        end
    end
    if next(map) then return map end
    -- fallback: read the in-game travel list
    local pg = LP:FindFirstChild("PlayerGui")
    local roots = {}
    if pg then
        local mg = pg:FindFirstChild("MainGui")
        if mg and mg:FindFirstChild("Travel") then roots[#roots + 1] = mg.Travel end
        if pg:FindFirstChild("Travel") then roots[#roots + 1] = pg.Travel end
    end
    local entries = {}
    for _, root in ipairs(roots) do
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("GuiObject") and not d:IsA("TextLabel") then
                local key = byDisplay[string.lower(d.Name)]
                local num
                for _, t in ipairs(d:GetChildren()) do
                    if t:IsA("TextLabel") or t:IsA("TextButton") then
                        key = key or byDisplay[string.lower(t.Text)]
                        num = num or shortNumber(t.Text)
                    end
                end
                if key and not entries[key] then
                    if not num then
                        for _, t in ipairs(d:GetDescendants()) do
                            if t:IsA("TextLabel") then num = shortNumber(t.Text) if num then break end end
                        end
                    end
                    entries[key] = { text = num, layout = d.LayoutOrder }
                end
            end
        end
    end
    -- favourited worlds (star) get a different LayoutOrder so the game can pin
    -- them to the top. Normal rows share a step (e.g. 10, 20, 30 ...); a row
    -- that breaks the pattern is treated as favourited and its real position
    -- comes from the saved cache instead.
    local total, tens = 0, 0
    for _, e in pairs(entries) do
        if not e.text and e.layout > 0 then
            total = total + 1
            if e.layout % 10 == 0 then tens = tens + 1 end
        end
    end
    local stepTen = total >= 10 and tens / total >= 0.6
    local cache, changed = Data.LoadWorldOrderCache(), false
    for key, e in pairs(entries) do
        local num = e.text
        if not num then
            local ok = e.layout > 0 and (not stepTen or e.layout % 10 == 0)
            if ok then num = e.layout end
        end
        if num then
            if cache[key] ~= num then cache[key], changed = num, true end
            map[key] = num
        else
            map[key] = cache[key]
        end
    end
    if changed then Data.SaveWorldOrderCache(cache) end
    return map
end
function Data.ResetWorldCache()
    table.clear(orderCache)
    worldNumCache = nil
    worldDataHits = nil
end
function Data.WorldNumber(name)
    if not worldNumCache or os.clock() - worldNumTime > 10 then
        local ok, res = pcall(buildWorldNumbers)
        worldNumCache, worldNumTime = ok and res or {}, os.clock()
    end
    return worldNumCache[name]
end

-- worlds the game hasn't released yet show a placeholder name ("Locked?", "???")
function Data.IsHiddenWorld(name)
    local d = string.lower(Data.WorldDisplay(name))
    if string.find(d, "lock", 1, true) or string.match(d, "^[%?%s]*$") then return true end
    for _, h in ipairs(CFG.HiddenWorlds) do
        local hl = string.lower(h)
        if string.sub(d, 1, #hl) == hl or string.lower(name) == hl then return true end
    end
    return false
end

-- dropdown label -> world key (label = the world's name, sorted by game order)
local labelToWorld = {}
function Data.WorldLabel(name)
    local label = Data.WorldDisplay(name)
    if labelToWorld[label] and labelToWorld[label] ~= name then label = label .. " (" .. name .. ")" end
    labelToWorld[label] = name
    return label
end

function Data.FromLabel(label)
    if type(label) ~= "string" then return label end
    if labelToWorld[label] then return labelToWorld[label] end
    if Worlds:FindFirstChild(label) then return label end
    local old = string.match(label, "| (.+)$") or string.match(label, "%((.-)%)$")  -- old config labels
    if old then return old end
    -- "22 Icy Wastes" saved before the game renumbered its worlds -> match by name
    local display = string.match(label, "^%d+ (.+)$") or label
    for _, f in ipairs(Worlds:GetChildren()) do
        if f:IsA("Folder") and Data.WorldDisplay(f.Name) == display then return f.Name end
    end
    return label
end

-- refresh a world dropdown and keep what was selected even if labels changed
function Data.RefreshWorldDrop(drop, labels)
    local cur = drop:Get()
    drop:Refresh(labels)
    local function relabel(l)
        local key = Data.FromLabel(l)
        return Worlds:FindFirstChild(key or "") and Data.WorldLabel(key) or l
    end
    if type(cur) == "table" then
        local set = {}
        for l, on in pairs(cur) do if on then set[relabel(l)] = true end end
        drop:Set(set, true)
    elseif type(cur) == "string" then
        drop:Set(relabel(cur), true)
    end
end

-- event world = name has "Event" / "Gamemode", or WorldData marks it as an event
function Data.IsEventWorld(name)
    if string.find(name, "Event", 1, true) or string.find(name, "Gamemode", 1, true) then return true end
    local info = Data.WorldInfo(name)
    return info ~= nil and (info.Event == true or info.IsEvent == true or info.Type == "Event")
end

-- position of a name in a CFG list (exact name, or the list entry is the start of it)
local function listIndex(listTbl, name)
    local d, k = string.lower(Data.WorldDisplay(name)), string.lower(name)
    for i, entry in ipairs(listTbl) do
        local e = string.lower(entry)
        if d == e or k == e or (#e >= 6 and string.sub(d, 1, #e) == e) then return i end
    end
    return nil
end
function Data.OrderRank(name)
    local r = orderCache[name]
    if r == nil then
        local idx = listIndex(CFG.WorldOrder, name)
        r = idx or (10000 + (Data.WorldNumber(name) or 1e6))
        orderCache[name] = r
    end
    return r
end

-- game order: CFG.WorldOrder first, then new worlds by the game's own number, then A-Z
local function byNumber(a, b)
    local na, nb = Data.OrderRank(a), Data.OrderRank(b)
    if na ~= nb then return na < nb end
    return a < b
end

function Data.FarmWorlds()
    local list = {}
    for _, f in ipairs(Worlds:GetChildren()) do
        if Data.IsFarmWorld(f) and not Data.IsHiddenWorld(f.Name) then list[#list + 1] = f.Name end
    end
    table.sort(list, byNumber)
    return list
end

-- position in CFG.PinnedWorlds (nil = not pinned)
function Data.PinIndex(name)
    return listIndex(CFG.PinnedWorlds, name)
end

-- display order for dropdowns: CFG.PinnedWorlds first (in that order),
-- then other event worlds, then world 1, 2, 3 ...
function Data.SortForDisplay(list)
    table.sort(list, function(a, b)
        local pa, pb = Data.PinIndex(a) or math.huge, Data.PinIndex(b) or math.huge
        if pa ~= pb then return pa < pb end
        local ea, eb = Data.IsEventWorld(a), Data.IsEventWorld(b)
        if ea ~= eb then return ea end
        return byNumber(a, b)
    end)
    return list
end

function Data.FarmWorldLabels()
    local out = {}
    for _, n in ipairs(Data.SortForDisplay(Data.FarmWorlds())) do out[#out + 1] = Data.WorldLabel(n) end
    return out
end

function Data.EventWorlds()
    local out = {}
    for _, f in ipairs(Worlds:GetChildren()) do
        if f:IsA("Folder") and (string.find(f.Name, "Gamemode", 1, true) or string.find(f.Name, "Event", 1, true))
            and not Data.IsHiddenWorld(f.Name) then
            out[#out + 1] = f.Name
        end
    end
    return Data.SortForDisplay(out)
end

function Data.AllWorlds()
    local out = {}
    for _, f in ipairs(Worlds:GetChildren()) do if f:IsA("Folder") then out[#out + 1] = f.Name end end
    return Data.SortForDisplay(out)
end

-- stars / eggs: every model named ...Egg or ...Star in any world -> "Name | World"
function Data.Stars()
    local out, seen = {}, {}
    for _, world in ipairs(Worlds:GetChildren()) do
        for _, obj in ipairs(world:GetChildren()) do
            local n = obj.Name
            if (string.sub(n, -3) == "Egg" or string.sub(n, -4) == "Star") and not seen[world.Name .. n] then
                seen[world.Name .. n] = true
                out[#out + 1] = n .. " | " .. world.Name
            end
        end
    end
    table.sort(out)
    return out
end

function Data.Passives()
    local ps = Data.Module("PassiveStats")
    local names, rarityOf = {}, {}
    if ps then
        for name, info in pairs(ps) do
            if type(name) == "string" and type(info) == "table" then
                names[#names + 1] = name
                rarityOf[name] = info.Rarity or info.rarity or info.Tier
            end
        end
        table.sort(names)
    end
    return names, rarityOf
end

function Data.PassiveRarities()
    local _, rarityOf = Data.Passives()
    local seen, out = {}, {}
    for _, r in pairs(rarityOf) do
        if type(r) == "string" and not seen[r] then seen[r] = true out[#out + 1] = r end
    end
    if #out == 0 then return CFG.FallbackPassiveRarities end
    table.sort(out)
    return out
end

function Data.RebirthBosses()
    local set = {}
    local rb = Data.Module("RebirthBossData")
    if rb then
        for k, v in pairs(rb) do
            if type(k) == "string" then set[k] = true end
            if type(v) == "table" then
                local n = v.Name or v.Boss or v.Enemy
                if type(n) == "string" then set[n] = true end
            end
        end
    end
    return set
end

-- pets: "Name [id]" when the pet has a readable name, else the id
function Data.PetId(label) return string.match(label, "%[(.-)%]$") or label end
function Data.Pets()
    local out = {}
    local folder = LP:FindFirstChild("Pets")
    if not folder then return out end
    for _, pet in ipairs(folder:GetChildren()) do
        local n = Util.Value(pet, { "PetName", "Name", "DisplayName", "Type" })
