end
function Util.World()
    local v = LP:FindFirstChild("World")
    return v and v.Value or ""
end
function Util.SetToList(set)
    local out = {}
    for k, on in pairs(set or {}) do if on then out[#out + 1] = k end end
    table.sort(out, function(a, b) return tostring(a) < tostring(b) end)
    return out
end
function Util.Count(set)
    local n = 0
    for _, on in pairs(set or {}) do if on then n = n + 1 end end
    return n
end
function Util.Value(obj, names)
    if not obj then return nil end
    for _, n in ipairs(names) do
        local a = obj:GetAttribute(n)
        if a ~= nil then return a end
        local c = obj:FindFirstChild(n)
        if c and c:IsA("ValueBase") then return c.Value end
    end
    return nil
end

