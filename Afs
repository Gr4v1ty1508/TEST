-- DEFENSE: the game's way - in the picked world, stand at its TitanSummon and press its prompt
-- -> MainGui.TitanSummon ("Defense Mode": Public / Friends Only, costs Defense Tokens)
-- -> MainGui.TitanTravel ("join this battle?" Yes) -> you're in world "Titan"
Features.DefenseState = { at = 0 }
function Features.Defense()
    if Util.World() == "Titan" then
        Combat.Step("Titan", function() return On("AutoDefense") end, nil, F("DefenseTarget") or "Nearest")
        return true
    end
    -- popups of a summon that's already going
    local travel = mainChild("TitanTravel")
    if isShown(travel) then Extras.Press(travel:FindFirstChild("Yes", true)) task.wait(1) return true end
    local win = mainChild("TitanSummon")
    if isShown(win) then
        Extras.Press(win:FindFirstChild(On("DefenseFriends") and "Friends" or "Public", true))
        Features.DefenseState.at = os.clock()
        task.wait(1)
        return true
    end
    -- just summoned: give the travel popup a moment
    if os.clock() - Features.DefenseState.at < 8 then return false end
    local world = Data.FromLabel(F("DefenseWorld") or "")
    if world == "" then
        if Util.Every("defense-pick", 60) then Util.Notify("Defense: pick a world first") end
        return false
    end
    if not Util.Every("defense-join", 10) then return false end
    if Util.World() ~= world then Travel.To(world) task.wait(1) end
    local w = Worlds:FindFirstChild(world)
    local spot = w and w:FindFirstChild("TitanSummon")
    local prompt = spot and spot:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then
        Util.Notify("Defense: no summon point in " .. Data.WorldDisplay(world))
        return false
    end
    local part = spot:FindFirstChild("Trigger") or spot:FindFirstChildWhichIsA("BasePart", true)
    if part then
        pcall(function() LP:RequestStreamAroundAsync(part.Position) end)
        Util.MoveTo(part.CFrame * CFrame.new(0, 3, 6))
        task.wait(0.4)
    end
    -- what the game sends for its buttons (watched): SummonTitan(<TitanSummon.Trigger>, true)
    -- = "Private Defense Mode" (Friends Only); Public = false. Then AttemptTravel("Titan").
    local trig = spot:FindFirstChild("Trigger")
    if trig and Remotes:FindFirstChild("SummonTitan") then
        local flags = Learn.Load().DefenseFlags or {}
        local private = On("DefenseFriends")
        local v
        if private then v = flags.Friends else v = flags.Public end
        if v == nil then v = private end
        Features.DefenseSent = { v = v, private = private, at = os.clock() }
        Net.Raw("SummonTitan", { trig, v, n = 2 })
        Features.DefenseState.at = os.clock()
        task.wait(1.5)
        local tr = mainChild("TitanTravel")
        if isShown(tr) then Extras.Press(tr:FindFirstChild("Yes", true)) else Travel.To("Titan") end
        return true
    end
    Prompt.Use(prompt)
    -- the Defense Mode window opens -> pressed on the next tick
    task.wait(1)
    return true
end

