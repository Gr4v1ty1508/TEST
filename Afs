local Combat = {}
local SendPet = Bindables:FindFirstChild("SendPet")

-- Enemies far from you are streamed out: the model, its DisplayName / Health values
-- and its pivot exist, but its parts (HumanoidRootPart) don't until you get close.
-- So an enemy is alive by its Health value, and found by its pivot position.
Combat.Skip = setmetatable({}, { __mode = "k" })   -- enemy -> skip until (os.clock)
function Combat.Alive(e)
    if not e or not e.Parent then return false end
    if Combat.Skip[e] and os.clock() < Combat.Skip[e] then return false end
    local hp = e:FindFirstChild("Health")
    if hp then return hp.Value > 0 end
    return e:FindFirstChild("HumanoidRootPart") ~= nil
end
-- where an enemy is. With StreamingEnabled a far enemy is only an empty Model (no parts,
-- seen in the dumps), so: HumanoidRootPart -> any other part of it (CombatBorder, ...)
-- -> the model's pivot (only if it isn't the empty-model default at 0,0,0)
function Combat.Pos(e)
    if not e then return nil, nil end
    local part = e:FindFirstChild("HumanoidRootPart")
    if part and part:IsA("BasePart") then return part.Position, part end
    part = e:FindFirstChild("CombatBorder") or e:FindFirstChildWhichIsA("BasePart", true)
    if part then return part.Position, part end
    local ok, cf = pcall(e.GetPivot, e)
    if ok and cf and cf.Position.Magnitude > 5 then return cf.Position, nil end
    return nil, nil
end
-- GravityHub/AFS/combat_log.txt: what the attack loop picked and why it did / didn't teleport
Combat.LogLast = {}
function Combat.Log(key, msg)
    local now = os.clock()
    if Combat.LogLast[key] == msg then return end
    Combat.LogLast[key] = msg
    Combat.Status = msg
    if not appendfile then return end
    pcall(function()
        if isfolder and makefolder and not isfolder(CFG.ConfigFolder) then
            local cur = ""
            for seg in string.gmatch(CFG.ConfigFolder, "[^/]+") do
                cur = cur == "" and seg or (cur .. "/" .. seg)
                if not isfolder(cur) then makefolder(cur) end
            end
        end
        local root = Util.Root()
        appendfile(CFG.ConfigFolder .. "/combat_log.txt", os.date("%H:%M:%S") .. string.format(" %.1f  ", now % 1000) .. msg
            .. (root and string.format("   me @ (%.0f, %.0f, %.0f)", root.Position.X, root.Position.Y, root.Position.Z) or "   (no character)") .. "\n")
    end)
end
function Combat.Name(e)
    local t = e:FindFirstChild("DisplayName")
    return t and t.Value or e.Name
end
function Combat.HP(e)
    local hp = e:FindFirstChild("Health")
    return hp and hp.Value or 0
end

-- the "Enemies" folders of a world. Big maps (the Tower has hundreds of rooms) are only
-- searched every 5 s instead of on every attack step.
local enemyFolderCache = {}
function Combat.EnemyFolders(world)
    local c = enemyFolderCache[world]
    if c and os.clock() - c.at < 5 then
        local alive = {}
        for _, f in ipairs(c.list) do if f.Parent then alive[#alive + 1] = f end end
        return alive
    end
    local list = {}
    local direct = world:FindFirstChild("Enemies")
    if direct then list[1] = direct end
    for _, obj in ipairs(world:GetDescendants()) do
        if obj.Name == "Enemies" and obj ~= direct and obj:IsA("Folder") then list[#list + 1] = obj end
    end
    enemyFolderCache[world] = { at = os.clock(), list = list }
    return list
end

-- names = set of names to keep (nil = all)
function Combat.List(worldName, names)
    local out = {}
    local world = Worlds:FindFirstChild(worldName or "")
    if not world then return out end
    local function consider(e)
        if Combat.Alive(e) and (not names or names[Combat.Name(e)] or names[e.Name]) then out[#out + 1] = e end
    end
    -- every world keeps its enemies in <World>.Enemies (dungeon / trial rooms may nest more)
    local folders = Combat.EnemyFolders(world)
    for _, f in ipairs(folders) do
        for _, e in ipairs(f:GetChildren()) do consider(e) end
    end
    if #folders == 0 then
        for _, e in ipairs(world:GetDescendants()) do
            if e:FindFirstChild("DisplayName") then consider(e) end
        end
    end
    return out
end

function Combat.MaxHP(e)
    local m = e:FindFirstChild("MaxHealth")
    return (m and m.Value) or Combat.HP(e)
end
-- Nearest   = closest one
-- Weakest   = the weakest KIND of mob (lowest MaxHealth); same kind -> least HP left, then closest
-- Strongest = the strongest kind (highest MaxHealth, = the boss); same kind -> closest
function Combat.Pick(list, mode)
    if #list == 0 then return nil end
    local root = Util.Root()
    local best, k1, k2, k3
    for _, e in ipairs(list) do
        local pos = Combat.Pos(e)
        local dist = (root and pos) and (pos - root.Position).Magnitude or math.huge
        local a, b, c
        if mode == "Weakest" then a, b, c = Combat.MaxHP(e), Combat.HP(e), dist
        elseif mode == "Strongest" then a, b, c = -Combat.MaxHP(e), dist, 0
        else a, b, c = dist, 0, 0 end
        if not best or a < k1 or (a == k1 and (b < k2 or (b == k2 and c < k3))) then
            best, k1, k2, k3 = e, a, b, c
        end
    end
    return best
end

Combat.Options = { Teleport = true, PetTP = false, Ult = false }
-- "Teleport While Farm" is for the normal world farm only. Every mode (Time Trial,
-- Infinity Tower, Dungeon, Raid, Gate, Defense, ...) always warps to its mobs, like Yuto Hub.
Combat.InFarm = false
function Combat.CanTP() return Combat.Options.Teleport or not Combat.InFarm end

function Combat.Attack(e, wanted)
    local t0 = os.clock()
    if Combat.Options.PetTP then
        -- RequestPetTeleport(pet): each of YOUR equipped pet models
        for _, pet in ipairs(Data.EquippedPets()) do task.spawn(Net.Call, "PetTeleport", pet) end
    end
    local streamedAt = 0
    local hp0, hpAt = Combat.HP(e), nil
    do
        local pos, part = Combat.Pos(e)
        local root = Util.Root()
        local where = pos and string.format("(%.0f, %.0f, %.0f) %s", pos.X, pos.Y, pos.Z, part and part.Name or "pivot") or "NO POSITION"
        Combat.Log("atk", "target " .. e.Name .. " [" .. Combat.Name(e) .. "] hp " .. string.format("%.3g", Combat.HP(e))
            .. " at " .. where .. (root and pos and string.format("  dist %.0f", (pos - root.Position).Magnitude) or "")
            .. (Combat.CanTP() and "" or "  | Teleport While Farm is OFF"))
        if not pos then
            -- nothing to go to (not streamed in, no pivot): try the next one for a few seconds
            Combat.Skip[e] = os.clock() + 5
            return
        end
    end
    while Combat.Alive(e) and wanted() and os.clock() - t0 < CFG.KillTimeout do
        -- no damage at all for 8 s once we're next to it (room not started, out of reach):
        -- skip it for 30 s so the rest of the hub can move on
        if e:FindFirstChild("HumanoidRootPart") then
            hpAt = hpAt or os.clock()
            if Combat.HP(e) < hp0 then hp0, hpAt = Combat.HP(e), os.clock() end
            if os.clock() - hpAt > 8 then
                Combat.Log("atk", "no damage on " .. e.Name .. " for 8 s -> skipped 30 s")
                Combat.Skip[e] = os.clock() + 30
                break
            end
        end
        local root = Util.Root()
        local pos, part = Combat.Pos(e)
        if Combat.CanTP() and root and pos and (root.Position - pos).Magnitude > 12 then
            if part then
                root.CFrame = part.CFrame * CFrame.new(0, 0, 4)
            else
                -- not loaded yet: go to where it is and ask the game to load that area
                root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 4))
                if os.clock() - streamedAt > 2 then
                    streamedAt = os.clock()
                    task.spawn(pcall, function() LP:RequestStreamAroundAsync(pos) end)
                end
            end
        end
        -- pets need the enemy's parts to walk to it
        -- the game's own attack call is SendPet:Fire(enemy, true, true) (seen while watching)
        if SendPet and e:FindFirstChild("HumanoidRootPart") then pcall(SendPet.Fire, SendPet, e, true, true) end
        task.wait()
    end
end

-- one attack step; false when nothing is left
function Combat.Step(worldName, wanted, names, mode, maxDist, skip)
    local list = Combat.List(worldName, names)
    if skip then
        local keep = {}
        for _, e in ipairs(list) do if not skip(e) then keep[#keep + 1] = e end end
        list = keep
    end
    if maxDist then
        -- only enemies near us (the Tower holds every player's trial run in one map)
        local root = Util.Root()
        local near, far, unknown = {}, 0, 0
        for _, e in ipairs(list) do
            local pos = Combat.Pos(e)
            if not pos then unknown = unknown + 1
            elseif root and (pos - root.Position).Magnitude <= maxDist then near[#near + 1] = e
            else far = far + 1 end
        end
        if #near == 0 and #list > 0 then
            Combat.Log("near", #list .. " enemies in " .. tostring(worldName) .. ": " .. far .. " farther than " .. maxDist .. ", " .. unknown .. " without a position")
        end
        list = near
    end
    local target = Combat.Pick(list, mode or "Nearest")
    if not target then
        Combat.Log("step", "no enemy in " .. tostring(worldName) .. (maxDist and (" within " .. maxDist) or "") .. " (found " .. #list .. ")")
        return false
    end
    Combat.LogLast.step = nil
    Combat.Attack(target, wanted)
    return true
end

