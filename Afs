    if not tpl then return { "FriendsOnly", on } end
    for i = 1, n do if type(tpl[i]) == "boolean" then tpl[i] = on end end
    return tpl
end

-- ARTIFACT FOR OPENING DUNGEONS ------------------------------------------------------------------
-- EquipArtefact(name, "CurrentArtefact" / "CurrentSecondArtefact"), sent before summoning.
-- Labels are "Key | Dungeon" (shown name | game name); a plain label is both.
function Data.ArtifactLabels()
    local out, seen = {}, {}
    for _, a in ipairs(CFG.Artifacts) do
        out[#out + 1] = a[1] == a[2] and a[1] or (a[1] .. " | " .. a[2])
        seen[a[2]] = true
    end
    -- artifacts a game update added (ArtefactData keys not in the list above)
    local extra = {}
    for k, v in pairs(Data.Module("ArtefactData") or {}) do
        if type(k) == "string" and type(v) == "table" and not seen[k] then extra[#extra + 1] = k end
    end
    table.sort(extra)
    for _, k in ipairs(extra) do out[#out + 1] = k end
    return out
end

function Features.EquipOpenArtifact()
    -- "Use Dungeon Artifact To Open": Yuto Hub sends EquipArtefact("Dungeon", "CurrentArtefact")
    -- right before every SummonDungeon (the dungeon artifact cuts the opening time)
    Net.Call("EquipArtifact", "Dungeon", "CurrentArtefact")
    task.wait(0.3)
    return true
end

function Features.OpenDungeon()
    if os.clock() < nextSummon then
        -- a dungeon was just summoned: keep trying to get in instead of summoning again
        if Util.Every("dungeon-rejoin", 5) then
            Net.Call("DungeonLobby")
            Net.Raw("JoinDungeon", Learn.Get("JoinDungeon") or {})
        end
        return
    end
    -- 1. dungeon lobby (summon only works there)
    if Util.World() ~= "Dungeon" then
        Net.Call("DungeonLobby")
        local t0 = os.clock()
        while Util.World() ~= "Dungeon" and os.clock() - t0 < 4 do task.wait(0.1) end
        local cf = Travel.SpawnCFrame("Dungeon")
        if cf then Util.MoveTo(cf + Vector3.new(0, 4, 0)) end
        task.wait(1)
    end
    -- 2. artifact that cuts the opening time, 3. friend only, 4. summon, 5. join
    if On("DungeonArtifact") then Features.EquipOpenArtifact() end
    Net.Raw("SetDungeonSetting", friendArgs(On("DungeonFriends")))
    local size = F("DungeonSize") or "Small"
    local world = Data.FromLabel(F("DungeonWorld") or "")
    if world == "" then Util.Notify("Pick a dungeon world") nextSummon = os.clock() + 10 return end
    local artifact = On("DungeonArtifact")
    local args, source, artSlot = summonArgs(size, world, artifact)
    local answer
    if source == "guess" and Learn.Get("Bindable.SummonDungeon") then
        -- only the game's own summon button was learned: fire it the same way,
        -- the game's client then sends the real SummonDungeon call itself
        local b = Bindables:FindFirstChild("SummonDungeon")
        local bargs = Learn.Get("Bindable.SummonDungeon")
        local ctx = { size = size, sizeIndex = (table.find(CFG.DungeonSizes, size) or 1) - 1, world = world, artifact = artifact }
        for i, v in pairs(bargs) do bargs[i] = fillSummon(v, nil, ctx) end
        if b and b:IsA("BindableEvent") then pcall(b.Fire, b, table.unpack(bargs, 1, #bargs)) end
        source = "game button"
    else
        answer = Net.Raw("SummonDungeon", args)
    end
    Features.LastSummon = { source = source, artifact = artSlot, answer = answer, at = os.clock() }
    if source == "guess" and Util.Every("summon-guess-note", 120) then
        Util.Notify("Dungeon: summon ONE dungeon by hand so the hub learns the real call")
    end
    if answer ~= nil and answer ~= true then
        local txt = type(answer) == "table" and select(2, pcall(HttpService.JSONEncode, HttpService, answer)) or tostring(answer)
        Util.Notify("Summon answer: " .. tostring(txt))
    end
    if artifact and artSlot == "not found" and Util.Every("summon-art-note", 120) then
        Util.Notify("Artifact slot unknown: summon by hand once WITH and once WITHOUT artifact")
    end
    task.wait(1.5)
    -- the game may ask "go to dungeon?" first
    local dt = Data.MainGui() and Data.MainGui():FindFirstChild("DungeonTravel")
    if dt and dt:IsA("GuiObject") and dt.Visible then
        local yes = dt:FindFirstChild("Yes", true)
        if yes and yes:IsA("GuiButton") then Features.FireGui(yes, { "Activated" }) end
    end
    Net.Raw("JoinDungeon", Learn.Get("JoinDungeon") or {})
    for _, p in ipairs(Prompt.Find(Worlds:FindFirstChild("Dungeon"), { "dungeon", "enter", "join", "start" })) do
        Prompt.Use(p)
        break
    end
    nextSummon = os.clock() + 45
    dungeonStep = "joining"
end

Features.DungeonActivated = setmetatable({}, { __mode = "k" })
-- true = there are living mobs but none of them is loaded -> we went to load them
function Features.DungeonFindHidden(worldName, skip)
    if (Features.DungeonHiddenPause or 0) > os.clock() then return false end
    local world = Worlds:FindFirstChild(worldName or "")
    if not world then return false end
    local hidden, visible = 0, 0
    for _, f in ipairs(Combat.EnemyFolders(world)) do
        for _, e in ipairs(f:GetChildren()) do
            local hp = e:FindFirstChild("Health")
            if (not hp or hp.Value > 0) and not (skip and skip(e)) then
                if Combat.Pos(e) then visible = visible + 1 else hidden = hidden + 1 end
            end
        end
    end
    if hidden == 0 or visible > 0 then Features.DungeonHiddenSince = nil return false end
    -- left-over models that never load: give up for a while, open/walk rooms normally
    Features.DungeonHiddenSince = Features.DungeonHiddenSince or os.clock()
    if os.clock() - Features.DungeonHiddenSince > 25 then
        Features.DungeonHiddenSince = nil
        Features.DungeonHiddenPause = os.clock() + 20
        return false
    end
    local list = {}
    for cp, info in pairs(Features.DungeonActivated) do
        if cp.Parent then list[#list + 1] = { cp = cp, at = info.at } end
    end
    if #list == 0 then return false end
    table.sort(list, function(a, b) return a.at > b.at end)
    Features.DungeonLoadIdx = (Features.DungeonLoadIdx or 0) % #list + 1
    local cp = list[Features.DungeonLoadIdx].cp
    Combat.Log("dng", hidden .. " mobs alive but not loaded: back to an opened room to load them")
    pcall(function() LP:RequestStreamAroundAsync(cp.Position) end)
    Util.MoveTo(cp.CFrame * CFrame.new(0, 4, 0))
    task.wait(0.8)
    -- what was loaded can be attacked again right away
    for e in pairs(Combat.Skip) do if Combat.Pos(e) then Combat.Skip[e] = nil end end
    return true
end

-- the "x, y" room model a part belongs to, and whether the minimap shows it yet
function Features.DungeonRoomOf(inst)
    local o = inst
    while o and o ~= workspace do
        if o:IsA("Model") and string.match(o.Name, "^%d+, %d+$") then return o end
        o = o.Parent
    end
    return nil
end
function Features.RoomRevealed(room)
    if not room then return true end
    -- the game's own minimap first (MainGui.DungeonMinimap.MapFrame["x, y"].Visible): always
    -- right, also in a dungeon someone else opened (we may never get UpdateMap there, or keep
    -- the grid of the previous run)
    local mg = Data.MainGui()
    local mm = mg and mg:FindFirstChild("DungeonMinimap")
    local frame = mm and mm:FindFirstChild("MapFrame")
    if frame and mm.Visible then
        local cell = frame:FindFirstChild(room.Name)
        if cell and cell:IsA("GuiObject") then return cell.Visible end
    end
    local grid = Features.DungeonMap
    if not grid then return true end                            -- no map yet: don't block
    local x, y = string.match(room.Name, "^(%d+), (%d+)$")
    local col = grid[tonumber(x)] or grid[tostring(x)]
    if type(col) ~= "table" then return false end
    return (col[tonumber(y)] or col[tostring(y)]) == true
end
-- DUNGEON LAYOUT -----------------------------------------------------------------------------------
-- JoinDungeon(data): data.Map[x][y] = false | { door+x, door+y, door-x, door-y, type }
-- type (the order of data.Config.RoomModels): 1 Normal, 2 Treasure (chest room), 3 Boss,
-- 4 FinalTreasure, 5 Start. Door N of room "x, y" leads to 1 -> x+1, 2 -> y+1, 3 -> x-1, 4 -> y-1
-- (checked on a recorded run: start "1, 3" has only Door4 -> "1, 2"; Yuto opened "7, 1".Door2 and
-- fought the chest in "7, 2", "8, 7".Door4 -> EpicChest in "8, 6", "6, 8".Door2 -> boss "6, 9").
Features.DungeonDirs = { { 1, 0 }, { 0, 1 }, { -1, 0 }, { 0, -1 } }
Features.DungeonOpened = {}                     -- "x, y" of chest / boss rooms whose door we opened
function Features.DungeonCell(x, y)
    local m = Features.DungeonLayout
    if type(m) ~= "table" or not x or not y then return nil end
    local col = m[x] or m[tostring(x)]
    local c = type(col) == "table" and (col[y] or col[tostring(y)]) or nil
    return type(c) == "table" and c or nil
end
function Features.DungeonRoomType(name)
    local x, y = string.match(name or "", "^(%d+), (%d+)$")
    local c = x and Features.DungeonCell(tonumber(x), tonumber(y))
    return c and tonumber(c[5]) or nil
end
-- the room ("x, y") a door part leads into, from its Door1..Door4 model
function Features.DoorTarget(doorPart)
    local room = doorPart and Features.DungeonRoomOf(doorPart)
    local dm = doorPart and doorPart.Parent
    local k = dm and tonumber(string.match(dm.Name, "^Door(%d)$"))
    local x, y = string.match(room and room.Name or "", "^(%d+), (%d+)$")
    local d = k and Features.DungeonDirs[k]
    if not (x and d) then return nil end
    return (tonumber(x) + d[1]) .. ", " .. (tonumber(y) + d[2])
end
-- what Auto Farm Dungeon heads for: chest rooms not opened yet, then the boss room (until the boss
-- is dead), then the last treasure room behind the boss; nil = nothing special (nearest first)
-- the layout only comes once, when you enter (JoinDungeon). Saved to a file so a script started
-- again inside the same run (re-execute) still has it: read back when it matches the rooms there.
Features.DungeonLayoutFile = CFG.ConfigFolder .. "/dungeon_layout.json"
function Features.SaveDungeonLayout(map)
    pcall(function()
        if not writefile then return end
        local plain = {}
        for x, col in pairs(map) do
            if type(col) == "table" then
                local pc = {}
                for y, c in pairs(col) do
                    if type(c) == "table" then pc[tostring(y)] = { c[1] == true, c[2] == true, c[3] == true, c[4] == true, tonumber(c[5]) } end
                end
                plain[tostring(x)] = pc
            end
        end
        writefile(Features.DungeonLayoutFile, HttpService:JSONEncode(plain))
    end)
end
function Features.LoadDungeonLayout()
    if Features.DungeonLayout or Features.DungeonLayoutTried then return end
    local root = Features.DungeonRoot()
    local model = root and root:FindFirstChild("Map") and root.Map:FindFirstChild("Model")
    if not model or #model:GetChildren() == 0 then return end
    Features.DungeonLayoutTried = true
    local function matches(m)
        local rooms, bad = 0, 0
        for _, r in ipairs(model:GetChildren()) do
            local x, y = string.match(r.Name, "^(%d+), (%d+)$")
            if x then
                rooms = rooms + 1
                local col = m[tonumber(x)]
                if not (type(col) == "table" and type(col[tonumber(y)]) == "table") then bad = bad + 1 end
            end
        end
        return rooms > 0 and bad == 0
    end
    -- the game's own copy: its dungeon script keeps the JoinDungeon data { Seed, Config, Map, ... }
    -- in memory for the whole run (no file needed, also when the script started inside the run)
    if getgc then
        local okg, found = pcall(function()
            for _, t in ipairs(getgc(true)) do
                if type(t) == "table" and type(rawget(t, "Map")) == "table" and rawget(t, "Seed") ~= nil
                   and type(rawget(t, "Config")) == "table" and matches(t.Map) then
                    return t.Map
                end
            end
        end)
        if okg and found then
            Features.DungeonLayout = found
            Combat.Log("dng", "dungeon map found in the game's memory")
            return
        end
    end
    local ok, map = pcall(function()
        if not (isfile and readfile and isfile(Features.DungeonLayoutFile)) then return nil end
        return HttpService:JSONDecode(readfile(Features.DungeonLayoutFile))
    end)
    if not ok or type(map) ~= "table" then return end
    -- every room of this dungeon must be a room in the saved map (else it's an older run)
    local rooms, bad = 0, 0
    for _, r in ipairs(model:GetChildren()) do
        local x, y = string.match(r.Name, "^(%d+), (%d+)$")
        if x then
            rooms = rooms + 1
            local col = map[x]
            if not (type(col) == "table" and type(col[y]) == "table") then bad = bad + 1 end
        end
    end
    if rooms > 0 and bad == 0 then
        local fixed = {}
        for x, col in pairs(map) do
            fixed[tonumber(x)] = {}
            for y, c in pairs(col) do fixed[tonumber(x)][tonumber(y)] = c end
        end
        Features.DungeonLayout = fixed
        Combat.Log("dng", "dungeon map read back from the file (script started inside the run)")
    else
        Combat.Log("dng", "no dungeon map for this run (script started inside it): chest / boss rooms first can't be used")
    end
end
function Features.DungeonGoals()
    if not Features.DungeonLayout then Features.LoadDungeonLayout() end
    local m = Features.DungeonLayout
    if type(m) ~= "table" then return nil end
    local byType = { [2] = {}, [3] = {}, [4] = {} }
    for x, col in pairs(m) do
        if type(col) == "table" then
            for y, c in pairs(col) do
                local t = type(c) == "table" and tonumber(c[5])
                if t and byType[t] then
                    local name = tostring(tonumber(x)) .. ", " .. tostring(tonumber(y))
                    if not Features.DungeonOpened[name] then table.insert(byType[t], name) end
                end
            end
        end
    end
    if #byType[2] > 0 then return byType[2], "chest rooms" end
    if not Features.DungeonBossAt and #byType[3] > 0 then return byType[3], "boss room" end
    if #byType[4] > 0 then return byType[4], "last treasure room" end
    return nil
end
-- rooms between every room and the nearest goal room (walking through the layout's doors)
function Features.DungeonDistances(goals)
    local dist, queue, head = {}, {}, 1
    for _, g in ipairs(goals or {}) do dist[g] = 0 queue[#queue + 1] = g end
    while head <= #queue do
        local name = queue[head]
        head = head + 1
        local x, y = string.match(name, "^(%d+), (%d+)$")
        x, y = tonumber(x), tonumber(y)
        local c = Features.DungeonCell(x, y)
        for k, d in ipairs(Features.DungeonDirs) do
            if c and c[k] == true then
                local nx, ny = x + d[1], y + d[2]
                local n = nx .. ", " .. ny
                if dist[n] == nil and Features.DungeonCell(nx, ny) then
                    dist[n] = dist[name] + 1
                    queue[#queue + 1] = n
                end
            end
        end
    end
    return dist
end
-- steps from a room (model or name) to the current goal; math.huge = no goal / not connected
function Features.DungeonGoalCost(room, dist)
    if not dist then return 0 end
    local name = type(room) == "string" and room or (room and room.Name)
    return (name and dist[name]) or math.huge
end

function Features.DungeonActivate()
    local root = Features.DungeonRoot()
    local map = root and root:FindFirstChild("Map")
    local me = Util.Root()
    if not (map and me) then return false end
    -- chest rooms first, then the boss room: the altar on the shortest way there is next
    local goals, goalName = Features.DungeonGoals()
    local dist = goals and Features.DungeonDistances(goals) or nil
    local best, bestD, bestC
    for _, cp in ipairs(map:GetDescendants()) do
        if cp.Name == "ConfirmPart" and cp:IsA("BasePart") then
            local pp = cp:FindFirstChildWhichIsA("ProximityPrompt")
            -- pressed already: again only if its prompt is still on 15 s later (the press
            -- didn't take, e.g. not loaded yet), at most 3 presses per altar
            local done = Features.DungeonActivated[cp]
            -- 3 presses 15 s apart; still on after that -> try again every 30 s (never given up:
            -- a press can fail while the server doesn't see us there yet)
            local again = done == nil or (done.n < 3 and os.clock() - done.at > 15) or os.clock() - done.at > 30
            if pp and pp.Enabled and string.find(string.lower(pp.ActionText), "activ", 1, true)
               and again and Features.RoomRevealed(Features.DungeonRoomOf(cp)) then
                local d = (cp.Position - me.Position).Magnitude
                local c = Features.DungeonGoalCost(Features.DungeonRoomOf(cp), dist)
                if not bestD or c < bestC or (c == bestC and d < bestD) then best, bestD, bestC = { cp = cp, pp = pp }, d, c end
            end
        end
    end
    if not best then return false end
    local room = Features.DungeonRoomOf(best.cp)
    Combat.Log("dng", "activate altar of room " .. (room and room.Name or "?")
        .. (goalName and bestC < math.huge and (" (" .. bestC .. " rooms from the " .. goalName .. ")") or ""))
    pcall(function() LP:RequestStreamAroundAsync(best.cp.Position) end)
    Util.MoveTo(best.cp.CFrame * CFrame.new(0, 5, 0))
    task.wait(1)
    if fireproximityprompt then pcall(fireproximityprompt, best.pp) else Prompt.Use(best.pp) end
    local prev = Features.DungeonActivated[best.cp]
    Features.DungeonActivated[best.cp] = { at = os.clock(), n = (prev and prev.n or 0) + 1 }
    -- up to 1 s for this room's mobs to appear (the caller stops opening rooms as soon as they do)
    local t0, worldName = os.clock(), root.Name
    while os.clock() - t0 < 1 and #Combat.List(worldName) == 0 do task.wait(0.1) end
    return true
end

-- Yuto Hub, a whole run watched (Easter2026, size 2, ~5.5 min):
--   no enemies -> next room's altar "Activate" (Map.Model["x, y"].ConfirmPart), ~3 s per room
--   room doors: prompt "Open" (Door1..4.Door.DungeonRoomDoorRemotePrompt) -> OpenDungeonDoor(<Door part>)
--   the key room gives the boss key ("... has found the boss key!"), the boss door opens with it,
--   "THE BOSS HAS BEEN DEFEATED" -> the last door -> RareChest / CommonChest (they're enemies) -> done
Features.DungeonDoorTried = setmetatable({}, { __mode = "k" })
Features.DungeonRoomDone = setmetatable({}, { __mode = "k" })   -- room model -> nothing left in it
Features.DungeonRoomSeen = setmetatable({}, { __mode = "k" })   -- room model -> last looked at (os.clock)
-- room doors ("Open"). Yuto (watched): teleport onto the door (+5 up), wait 1 s, press "Open" -
-- the game then sends OpenDungeonDoor(<Door part>) itself; ~2 s later the room behind is fought.
-- Each door again every 20 s at most (a boss door waits for the key; all doors are tried again
-- at once when the key drops). Order: door into a chest room, into the boss room (with the key),
-- into the last treasure room (boss dead), then any other - nearest first.
-- important = true: only those first three kinds
function Features.DungeonOpenDoor(important)
    local root = Features.DungeonRoot()
    local me = Util.Root()
    local best, bestD, bestP
    for _, door in ipairs(Prompt.Find(root, { "door", "next", "open", "portal", "gate" })) do
        local t = Features.DungeonDoorTried[door]
        local part = door.Parent
        if (not t or os.clock() - t.at > 20) and part and part:IsA("BasePart") then
            local target = Features.DoorTarget(part)
            local kind = Features.DungeonRoomType(target)
            local prio = 9
            if target and not Features.DungeonOpened[target] then
                if kind == 2 then prio = 1
                elseif kind == 3 and Features.DungeonHasKey then prio = 2
                elseif kind == 4 and Features.DungeonBossAt then prio = 3 end
            end
            -- important: everything but a door into the boss room while we have no key
            -- (Yuto opens the chest-room doors as soon as it sees them, the boss door after the key)
            if not important or not (kind == 3 and not Features.DungeonHasKey) then
                local d = me and (part.Position - me.Position).Magnitude or 0
                if not bestD or prio < bestP or (prio == bestP and d < bestD) then best, bestD, bestP = door, d, prio end
            end
        end
    end
    if not best then return false end
    local part = best.Parent
    local t = Features.DungeonDoorTried[best] or { n = 0 }
    Features.DungeonDoorTried[best] = { at = os.clock(), n = t.n + 1 }
    Features.DungeonIdleSince = nil
    local room = Features.DungeonRoomOf(part)
    local target = Features.DoorTarget(part)
    local kind = Features.DungeonRoomType(target)
    Combat.Log("dng", "open door " .. (room and room.Name or "?") .. "/" .. (part.Parent and part.Parent.Name or "?")
        .. " -> " .. tostring(target) .. " (" .. (({ "normal", "chest room", "boss room", "last treasure", "start" })[kind or 0] or "?")
        .. ", try " .. (t.n + 1) .. ")")
    pcall(function() LP:RequestStreamAroundAsync(part.Position) end)
    Util.MoveTo(part.CFrame + Vector3.new(0, 5, 0))
    task.wait(1)
    if fireproximityprompt then pcall(fireproximityprompt, best) else Prompt.Use(best) end
    Net.Call("OpenDungeonDoor", part)
    task.wait(1)
    -- the prompt went away = open: that chest / boss room is no longer a goal
    if target and (not best.Parent or not best.Enabled) then Features.DungeonOpened[target] = true end
    return true
end

function Features.FarmDungeon()
    if not Features.DungeonLayout then Features.LoadDungeonLayout() end
    dungeonStep = "inside"
    nextSummon = 0
    local wanted = function() return On("AutoFarmDungeon") end
    local worldName = Features.DungeonRoot() and Features.DungeonRoot().Name or Util.World()
    -- Weakest / Strongest only choose among the mobs of the room we're in (~300 studs):
    -- the strongest mob of the whole dungeon is the boss in the last, still-closed room.
    -- Nothing near -> go to the nearest mob anywhere (= the next room).
    local mode = F("DungeonTarget") or "Nearest"
    local noChest = On("DungeonIgnoreChest") and function(e)
        return string.find(string.lower(e.Name .. " " .. Combat.Name(e)), "chest", 1, true) ~= nil
    end or nil
    -- mobs of a room we opened can be "invisible" (not loaded: the room is far, they spawned
    -- after we left for the next altar). They block the next rooms, but can't be attacked until
    -- loaded: go back to the rooms we opened (newest first) until they show up.
    -- only fight mobs that are loaded (have a position) - the rest are handled above
    -- mobs alive but none loaded (their room is far): back to the rooms we opened to load them
    if Features.DungeonFindHidden(worldName, noChest) then return true end
    local chestSkip = noChest
    noChest = function(e) return Combat.Pos(e) == nil or (chestSkip ~= nil and chestSkip(e)) end
    -- like Yuto (seen in game): open the next room(s), come back and fight every mob until it's
    -- dead, then open the next ones
    if mode ~= "Nearest" and Combat.Step(worldName, wanted, nil, mode, 300, noChest) then Features.DungeonIdleSince = nil return true end
    if Combat.Step(worldName, wanted, nil, "Nearest", nil, noChest) then Features.DungeonIdleSince = nil return true end
    -- no enemies: open the next room (stand on its altar ~1 s, fire "Activate"; its enemies spawn)
    -- keep opening the nearest room, one after another, until mobs show up - then stop and
    -- fight them first (the next tick comes back here once they're dead). Also after the boss is
    -- dead (its key can drop early): like Yuto, the rest of the rooms are still cleared.
    -- Yuto (full Large run watched): a door that can be opened comes before the next altar -
    -- chest rooms right away, the boss room once the key dropped
    if Features.DungeonOpenDoor(true) then return true end
    -- then two altars in a row (Yuto: altar, 2 s, next altar, then back to fight both rooms);
    -- the second one only while the first room's mobs haven't shown up yet
    do
        local opened = 0
        while opened < 2 and On("AutoFarmDungeon") and Features.DungeonActivate() do
            opened = opened + 1
            if #Combat.List(worldName) > 0 then break end
        end
        if opened > 0 then Features.DungeonIdleSince = nil return true end
    end
    local root = Features.DungeonRoot()
    -- chests with a prompt (older dungeons)
    if not On("DungeonIgnoreChest") then
        for _, p in ipairs(Prompt.Find(root, { "chest", "treasure" })) do
            Prompt.Use(p)
            Net.Call("OpenChest", p.Parent)
            task.wait(0.3)
        end
    end
    -- any other door (each again every 20 s)
    if Features.DungeonOpenDoor(false) then return true end
    -- nothing to fight / press / open here: go and look at the rooms (far rooms aren't loaded,
    -- so their altar / door / mobs can't be seen from here). Big dungeons have 100+ rooms, so
    -- not all of them in a row: a room we've looked at that had nothing left (no altar or door
    -- to press, no living mob in it) is "done" and skipped; the nearest room not done (and not
    -- looked at in the last 60 s) is next. All done -> start over, one room a second like Yuto.
    local rooms = {}
    for _, r in ipairs(Features.DungeonRooms()) do
        if Features.RoomRevealed(Features.DungeonRoomOf(r) or r) then rooms[#rooms + 1] = r end
    end
    if #rooms == 0 then Combat.Log("dng", "no room of this dungeon found / shown on the minimap") end
    if #rooms > 0 then
        local done, seen = Features.DungeonRoomDone, Features.DungeonRoomSeen
        local me = Util.Root()
        local goals = Features.DungeonGoals()
        local dist = goals and Features.DungeonDistances(goals) or nil
        local pick, pickD, pickC
        for _, r in ipairs(rooms) do
            if not done[r] and os.clock() - (seen[r] or -99) > 60 then
                local ok, cf = pcall(r.GetPivot, r)
                local d = (ok and me) and (cf.Position - me.Position).Magnitude or 0
                local c = Features.DungeonGoalCost(Features.DungeonRoomOf(r) or r, dist)
                if not pickD or c < pickC or (c == pickC and d < pickD) then pick, pickD, pickC = r, d, c end
            end
        end
        local left = 0
        for _, r in ipairs(rooms) do if not done[r] then left = left + 1 end end
        if not pick then
            -- every room looked at: go round all of them again
            roomIndex = roomIndex % #rooms + 1
            pick = rooms[roomIndex]
            if roomIndex == #rooms then table.clear(done) end
        end
        Combat.Log("dng", "nothing to do here: checking room " .. pick.Name .. " (" .. left .. " of " .. #rooms .. " not cleared yet)")
        local cf = pick:GetPivot()
        pcall(function() LP:RequestStreamAroundAsync(cf.Position) end)
        Util.MoveTo(cf + Vector3.new(0, 5, 0))
        task.wait(1)                                            -- Yuto: one room a second
        seen[pick] = os.clock()
        -- loaded now: anything left in it?
        local busy = false
        for _, p in ipairs(pick:GetDescendants()) do
            if p:IsA("ProximityPrompt") and p.Enabled then
                local t = string.lower(p.ActionText)
                if string.find(t, "activ", 1, true) or string.find(t, "open", 1, true) then busy = true break end
            end
        end
        if not busy then
            local world = Worlds:FindFirstChild(worldName)
            for _, f in ipairs(world and Combat.EnemyFolders(world) or {}) do
                for _, e in ipairs(f:GetChildren()) do
                    local pos = Combat.Alive(e) and Combat.Pos(e)
                    if pos and math.abs(pos.X - cf.Position.X) < 110 and math.abs(pos.Z - cf.Position.Z) < 110 then busy = true break end
                end
                if busy then break end
            end
        end
        if not busy then done[pick] = true end
    end
    return true
end

-- false = nothing to do here (lets the next feature in the Priority list run)
function Features.Dungeon()
    if Features.InDungeon() then
        if On("AutoFarmDungeon") and Features.FarmDungeon() ~= false then return true end
        -- run finished: leave (Time Chamber), the next one is summoned from outside like Yuto
        -- does it - summoning from inside would look "already in a dungeon" and repeat
        if On("AutoOpenDungeon") then
            if Util.Every("dungeon-leave", 8) then Travel.To("TimeChamber", true) end
            return true
        end
        return false
    end
    Features.DungeonBossAt, Features.DungeonIdleSince = nil, nil
    dungeonStep = "lobby"
    if On("AutoOpenDungeon") then
        -- the next dungeon can't be opened yet: don't try (and don't hold the character -
        -- the next feature in the Priority list runs meanwhile)
        local cd = Features.DungeonCooldown()
        if cd > 0 then
            dungeonStep = "cooldown"
            return false
        end
        Features.OpenDungeon()
        return true
    end
    return false
end
-- seconds before a new dungeon can be opened (0 = now), counted from LastDungeon in the save:
--   no artefact      ModuleScripts.ConfigValues.DungeonTime (39600 s = 11 h)
--   Dungeon artefact ArtefactData.Dungeon.Effects.DungeonCooldown hours (1 = 1 h)
-- Checked against the game's own timer: at the same moment it showed ~10 h without the
-- artefact and 4:14 with it (= about 56 min after the last one). The artefact is put on right
-- before every summon, so with "Use Dungeon Artifact To Open" the 1 h counts.
function Features.DungeonCooldownLength()
    local cfgv, arts = Data.Module("ConfigValues") or {}, Data.Module("ArtefactData") or {}
    local base = tonumber(cfgv.DungeonTime) or 39600
    if On("DungeonArtifact") then
        local eff = type(arts.Dungeon) == "table" and type(arts.Dungeon.Effects) == "table" and tonumber(arts.Dungeon.Effects.DungeonCooldown)
        return math.min(base, (eff or 1) * 3600)
    end
    return base
end
function Features.DungeonCooldown()
    local left = 0
    pcall(function()
        local last = tonumber(Data.StoreData().LastDungeon) or 0
        local now = workspace:GetServerTimeNow()
        local len = Features.DungeonCooldownLength()
        if last > 0 and last + len > now then left = last + len - now end
    end)
    return math.floor(left)
end
function Features.DungeonStep() return dungeonStep end

