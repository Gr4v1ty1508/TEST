local Combat = {}
local SendPet = Bindables:FindFirstChild("SendPet")

function Combat.Alive(e)
    if not e or not e.Parent or not e:FindFirstChild("HumanoidRootPart") then return false end
    local hp = e:FindFirstChild("Health")
    return hp == nil or hp.Value > 0
end
function Combat.Name(e)
    local t = e:FindFirstChild("DisplayName")
    return t and t.Value or e.Name
end
function Combat.HP(e)
    local hp = e:FindFirstChild("Health")
    return hp and hp.Value or 0
end

-- names = set of names to keep (nil = all)
function Combat.List(worldName, names)
    local out = {}
    local world = Worlds:FindFirstChild(worldName or "")
    if not world then return out end
    local function consider(e)
        if Combat.Alive(e) and (not names or names[Combat.Name(e)]) then out[#out + 1] = e end
    end
    local folders = false
    for _, obj in ipairs(world:GetDescendants()) do
        if obj.Name == "Enemies" and obj:IsA("Folder") then
            folders = true
            for _, e in ipairs(obj:GetChildren()) do consider(e) end
        end
    end
    if not folders then
        for _, e in ipairs(world:GetDescendants()) do
            if e:FindFirstChild("DisplayName") then consider(e) end
        end
    end
    return out
end

function Combat.Pick(list, mode)
    if #list == 0 then return nil end
    local root = Util.Root()
    local best, score = nil, nil
    for _, e in ipairs(list) do
        local s
        if mode == "Weakest" then s = Combat.HP(e)
        elseif mode == "Strongest" then s = -Combat.HP(e)
        else
            local p = e:FindFirstChild("HumanoidRootPart")
            s = (root and p) and (p.Position - root.Position).Magnitude or 0
        end
        if not score or s < score then best, score = e, s end
    end
    return best
end

Combat.Options = { Teleport = true, PetTP = false, Ult = false }

function Combat.Attack(e, wanted)
    local t0 = os.clock()
    if Combat.Options.PetTP then
        -- RequestPetTeleport(pet): each of YOUR pets in workspace.Pets
        local folder = workspace:FindFirstChild("Pets")
        for _, pet in ipairs(folder and folder:GetChildren() or {}) do
            local owner = pet:FindFirstChild("Owner") or pet:FindFirstChild("Player")
            local ov = owner and owner.Value
            if ov == nil or ov == LP or ov == LP.Name or ov == LP.UserId then
                task.spawn(Net.Call, "PetTeleport", pet)
            end
        end
    end
    while Combat.Alive(e) and wanted() and os.clock() - t0 < CFG.KillTimeout do
        local root, part = Util.Root(), e:FindFirstChild("HumanoidRootPart")
        if Combat.Options.Teleport and root and part and (root.Position - part.Position).Magnitude > 12 then
            root.CFrame = part.CFrame * CFrame.new(0, 0, 4)
        end
        if SendPet then pcall(SendPet.Fire, SendPet, e, true) end
        task.wait()
    end
end

-- one attack step; false when nothing is left
function Combat.Step(worldName, wanted, names, mode)
    local target = Combat.Pick(Combat.List(worldName, names), mode or "Nearest")
    if not target then return false end
    Combat.Attack(target, wanted)
    return true
end

