    if On("AutoBoost") and Util.Every("boost", 60) then Net.Call("ClaimBoost") end
    Features.Shop()

    if On("WebhookOn") and os.clock() - lastWebhook >= (F("WebhookEvery") or 10) * 60 then
        lastWebhook = os.clock()
        Features.Webhook("Anime Fighters Simulator - Status")
    end

    local hum, speed = Util.Humanoid(), F("WalkSpeed") or 16
    if hum and speed > 16 and hum.WalkSpeed ~= speed then hum.WalkSpeed = speed end

    pcall(function()
        -- soonest selected trial door
        local best, bestName
        for _, name in ipairs(Util.SetToList(F("Trials"))) do
            local id = CFG.TimeTrialIds[name]
            local secs = id and Features.DoorCountdown(id)
            if secs and (not best or secs < best) then best, bestName = secs, name end
        end
        local txt = best and string.format("%s %d:%02d", bestName, math.floor(best / 60), math.floor(best % 60)) or "?"
        local left = Extras.TrialTimeLeft()
        if left then txt = "in run, " .. left .. " left" end
        Features.TrialTimer:Set("Trial time : " .. txt .. "   Floor : " .. Stats.TrialFloor
            .. (Features.TrialStatus and ("\n" .. Features.TrialStatus) or ""))
    end)
end)

