local function make(class, props, children)
    local obj = Instance.new(class)
    local parent
    for key, value in pairs(props or {}) do
        if key == "Parent" then parent = value else obj[key] = value end
    end
    for _, child in ipairs(children or {}) do child.Parent = obj end
    obj.Parent = parent
    return obj
end

local function corner(radius) return make("UICorner", { CornerRadius = UDim.new(0, radius or 6) }) end
local function pad(px) return make("UIPadding", {
    PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px),
    PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px),
}) end
local function tween(obj, props, t)
    TweenService:Create(obj, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad), props):Play()
end

local function guiParent()
    local ok, hui = pcall(function() return gethui and gethui() end)
    if ok and hui then return hui end
    local okCore, core = pcall(function() return game:GetService("CoreGui") end)
    if okCore and core then return core end
    return LP:WaitForChild("PlayerGui")
end

local function enableDrag(handle, target)
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, input.Position, target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- element builders for one page --------------------------------------------
local function buildPage(page)
    local Page = {}

    local function row(height)
        return make("Frame", {
            Size = UDim2.new(1, 0, 0, height or 34), BackgroundColor3 = Theme.Element,
            BorderSizePixel = 0, Parent = page,
        }, { corner(6) })
    end

    local function title(parent, text, xOffset)
        return make("TextLabel", {
            Text = text, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
            Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -(xOffset or 24), 0, 34), Parent = parent,
        })
    end

    function Page:Section(text)
        make("TextLabel", {
            Text = string.upper(text), Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Theme.Accent,
            TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 22), Parent = page,
        }, { make("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingTop = UDim.new(0, 6) }) })
    end

    function Page:Label(text)
        local r = row(30)
        r.BackgroundTransparency = 0.4
        local lbl = title(r, text)
        lbl.Size = UDim2.new(1, -24, 1, 0)
        lbl.TextColor3 = Theme.SubText
        return { Set = function(_, newText) lbl.Text = newText end }
    end

    function Page:Button(text, callback)
        local r = row()
        title(r, text)
        local btn = make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = r })
        btn.MouseEnter:Connect(function() tween(r, { BackgroundColor3 = Theme.Hover }) end)
        btn.MouseLeave:Connect(function() tween(r, { BackgroundColor3 = Theme.Element }) end)
        btn.MouseButton1Click:Connect(function()
            tween(r, { BackgroundColor3 = Theme.Accent }, 0.08)
            task.delay(0.12, function() tween(r, { BackgroundColor3 = Theme.Element }) end)
            task.spawn(function()
                local ok, err = pcall(callback)
                if not ok then warn(err) end
            end)
        end)
    end

    function Page:Toggle(text, default, callback)
        local r = row()
        title(r, text, 70)
        local track = make("Frame", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
            Size = UDim2.fromOffset(38, 20), BackgroundColor3 = Theme.Off, Parent = r,
        }, { corner(10) })
        local knob = make("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0),
            Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Theme.Text, Parent = track,
        }, { corner(7) })
        local value = false
        local obj = {}
        function obj:Set(v, silent)
            value = v and true or false
            tween(track, { BackgroundColor3 = value and Theme.Accent or Theme.Off })
            tween(knob, { Position = value and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) })
            if not silent then task.spawn(function() pcall(callback, value) end) end
        end
        function obj:Get() return value end
        make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = r })
            .MouseButton1Click:Connect(function() obj:Set(not value) end)
        obj:Set(default, true)   -- no callback on load (State already holds defaults)
        return obj
    end

    function Page:Slider(text, min, max, default, callback)
        local r = row(48)
        local lbl = title(r, text)
        lbl.Size = UDim2.new(1, -70, 0, 28)
        local valueText = make("TextLabel", {
            Text = tostring(default), Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Theme.Accent,
            BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 0),
            Size = UDim2.fromOffset(60, 28), TextXAlignment = Enum.TextXAlignment.Right, Parent = r,
        })
        local bar = make("Frame", {
            Position = UDim2.new(0, 12, 0, 32), Size = UDim2.new(1, -24, 0, 6),
            BackgroundColor3 = Theme.Off, Parent = r,
        }, { corner(3) })
        local fill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent, Parent = bar }, { corner(3) })

        local current = default
        local function apply(v, fire)
            current = math.clamp(math.floor(v + 0.5), min, max)
            fill.Size = UDim2.fromScale((current - min) / math.max(max - min, 1), 1)
            valueText.Text = tostring(current)
            if fire then pcall(callback, current) end
        end
        local sliding = false
        local function fromInput(input)
            local pct = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            apply(min + (max - min) * pct, true)
        end
        bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                fromInput(input)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                fromInput(input)
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = false
            end
        end)
        apply(default, true)
        return { Set = function(_, v) apply(v, true) end, Get = function() return current end }
    end

    function Page:TextBox(text, placeholder, clearAfter, callback)
        local r = row()
        title(r, text, 200)
        local box = make("TextBox", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
            Size = UDim2.new(0.5, -8, 0, 24), BackgroundColor3 = Theme.Background,
            Text = "", PlaceholderText = placeholder or "", PlaceholderColor3 = Theme.SubText,
            TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 12,
            ClearTextOnFocus = false, Parent = r,
        }, { corner(5) })
        box.FocusLost:Connect(function()
            if box.Text ~= "" then
                pcall(callback, box.Text)
                if clearAfter then box.Text = "" end
            end
        end)
    end

    -- multi = true gives checkboxes; callback gets a set table { [name] = true }
    function Page:Dropdown(text, items, callback, multi)
        local holder = make("Frame", {
            Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = Theme.Element,
            ClipsDescendants = true, Parent = page,
        }, { corner(6) })
        local header = title(holder, text, 40)
        local arrow = make("TextLabel", {
            Text = "v", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Theme.SubText,
            BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 0),
            Size = UDim2.fromOffset(20, 34), Parent = holder,
        })
        local list = make("ScrollingFrame", {
            Position = UDim2.fromOffset(6, 36), Size = UDim2.new(1, -12, 0, 0),
            BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = holder,
        }, { make("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }) })

        local open, selected, single, entries = false, {}, nil, {}
        local obj = {}

        local function headerText()
            if multi then
                local n = 0
                for _ in pairs(selected) do n = n + 1 end
                header.Text = text .. "  :  " .. n .. " selected"
            else
                header.Text = text .. (single and ("  :  " .. single) or "")
            end
        end

        local function resize()
            local rows = math.min(#entries, 6)
            local h = open and (40 + rows * 27) or 34
            list.Size = UDim2.new(1, -12, 0, rows * 27)
            tween(holder, { Size = UDim2.new(1, 0, 0, h) })
            arrow.Text = open and "^" or "v"
        end

        function obj:Refresh(newItems)
            for _, e in ipairs(entries) do e:Destroy() end
            entries = {}
            local keep = {}
            for i, name in ipairs(newItems) do
                if selected[name] then keep[name] = true end
                local btn = make("TextButton", {
                    Text = "  " .. tostring(name), Font = Enum.Font.Gotham, TextSize = 12,
                    TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundColor3 = (selected[name] or single == name) and Theme.Accent or Theme.Background,
                    Size = UDim2.new(1, -4, 0, 24), LayoutOrder = i, Parent = list,
                }, { corner(4) })
                btn.MouseButton1Click:Connect(function()
                    if multi then
                        selected[name] = not selected[name] or nil
                        btn.BackgroundColor3 = selected[name] and Theme.Accent or Theme.Background
                        headerText()
                        pcall(callback, selected)
                    else
                        single = name
                        for _, other in ipairs(entries) do other.BackgroundColor3 = Theme.Background end
                        btn.BackgroundColor3 = Theme.Accent
                        open = false
                        resize()
                        headerText()
                        pcall(callback, name)
                    end
                end)
                entries[#entries + 1] = btn
            end
            if multi then selected = keep end
            headerText()
            resize()
        end

        function obj:SelectAll(names)
            if not multi then return end
            for _, n in ipairs(names) do selected[n] = true end
            for _, e in ipairs(entries) do e.BackgroundColor3 = Theme.Accent end
            headerText()
            pcall(callback, selected)
        end

        function obj:ClearSelection()
            selected, single = {}, nil
            for _, e in ipairs(entries) do e.BackgroundColor3 = Theme.Background end
            headerText()
            if multi then pcall(callback, selected) end
        end

        make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), Parent = holder })
            .MouseButton1Click:Connect(function() open = not open resize() end)

        obj:Refresh(items or {})
        return obj
    end

    return Page
end

