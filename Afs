local running = true
local function loop(interval, fn)
    task.spawn(function()
        while running do
            local ok, err = pcall(fn)
            if not ok then
                warn("[" .. CFG.Name .. "] " .. tostring(err))
                Diag.LogError("loop", err)
                task.wait(1)
            end
            task.wait(type(interval) == "function" and interval() or interval)
        end
    end)
end

