    local function show() btn.Text = value btn.TextColor3 = Theme.Text end
    function obj:Set(v, silent)
        local ok, key = pcall(function() return Enum.KeyCode[tostring(v)] end)
        if not (ok and key) then return end
        value = key.Name
        show()
        if not silent and opt.Callback then pcall(opt.Callback, key) end
    end
    function obj:Get() return value end
    btn.MouseButton1Click:Connect(function()
        if Library.Listening then return end
        Library.Listening = true
        btn.Text = "Press a key..."
