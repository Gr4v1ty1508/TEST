    -- GravityHub/AFS/CONFIG/<PlayerName>.json
    local function ensureFolder(path)
        if not (isfolder and makefolder) then return end
        local cur = ""
        for part in string.gmatch(path, "[^/]+") do
            cur = cur == "" and part or (cur .. "/" .. part)
            pcall(function() if not isfolder(cur) then makefolder(cur) end end)
        end
    end
    W.EnsureFolder = ensureFolder
    local configDir = CFG.ConfigFolder .. "/CONFIG"
    local configPath = configDir .. "/" .. LP.Name .. ".json"
    local lastSaved = nil
    local function encodeFlags()
        local out = {}
        for flag, el in pairs(Library.Flags) do
            local ok, v = pcall(el.Get, el)
            if ok and v ~= nil and type(v) ~= "function" and type(v) ~= "userdata" then out[flag] = v end
        end
        local ok, json = pcall(HttpService.JSONEncode, HttpService, out)
        return ok and json or nil
    end
    -- writes only when something changed since the last save
    function W:SaveConfig()
        if not writefile then return end
        local json = encodeFlags()
        if not json or json == lastSaved then return end
        ensureFolder(configDir)
        if pcall(writefile, configPath, json) then lastSaved = json end
    end
    function W:LoadConfig()
        if not (readfile and isfile) then return end
        local okExists, exists = pcall(isfile, configPath)
        if not okExists or not exists then return end
        local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(configPath)) end)
        if not ok or type(decoded) ~= "table" then Util.Notify("Config broken, starting fresh") return end
        for flag, value in pairs(decoded) do
            local el = Library.Flags[flag]
            if el then pcall(el.Set, el, value) end
        end
        lastSaved = encodeFlags()
    end

    function W:Destroy()
        for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
        gui:Destroy()
    end

    return W
end

