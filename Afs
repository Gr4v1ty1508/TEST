-- Remote Spy
if hookmetamethod and getnamecallmethod then
    local original
    original = hookmetamethod(game, "__namecall", function(self, ...)
        if State.Spy and not (checkcaller and checkcaller()) then
            local method = getnamecallmethod()
            if (method == "FireServer" or method == "InvokeServer") and typeof(self) == "Instance"
               and self.Parent == Remotes and self.Name ~= "ClickerDamage" then
                local out = {}
                for i, arg in ipairs({ ... }) do
                    local text
                    if typeof(arg) == "Instance" then
                        text = arg:GetFullName()
                    elseif type(arg) == "table" then
                        local ok, json = pcall(HttpService.JSONEncode, HttpService, arg)
                        text = ok and json or tostring(arg)
                    else
                        text = typeof(arg) .. " " .. tostring(arg)
                    end
                    out[#out + 1] = "[" .. i .. "] " .. text
                end
                print("[SPY] " .. self.Name .. ":" .. method .. "(" .. table.concat(out, ", ") .. ")")
            end
        end
        return original(self, ...)
    end)
end

