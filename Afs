-- whole inventory: the game keeps it on the server; GetPetData (RemoteFunction) is
-- asked once a minute. Whatever shape it answers with, pets are read as
-- { id, name, rarity, shiny, locked, equipped } when those fields can be found.
local inventoryCache, inventoryAt = {}, -999
function Data.Inventory(force)
    if not force and os.clock() - inventoryAt < 60 then return inventoryCache end
    inventoryAt = os.clock()
    local ok, reply = pcall(Net.Raw, "GetPetData", {})
    local out = {}
    local function field(t, names)
        for _, n in ipairs(names) do if t[n] ~= nil then return t[n] end end
        return nil
    end
    local function scan(t, keyId, depth)
        if type(t) ~= "table" or depth > 3 then return end
        local name = field(t, { "Name", "PetName", "Type", "Pet" })
        local id = field(t, { "UID", "Uid", "Id", "ID", "PetId" }) or keyId
        if type(name) == "string" and id ~= nil then
            out[#out + 1] = { id = tostring(id), name = name, rarity = field(t, { "Rarity", "Tier" }),
                shiny = field(t, { "Shiny", "IsShiny" }), locked = field(t, { "Locked", "Lock", "IsLocked" }),
                equipped = field(t, { "Equipped", "IsEquipped" }) }
            return
        end
        for k, v in pairs(t) do scan(v, (type(k) == "string" or type(k) == "number") and k or nil, depth + 1) end
    end
    if ok then scan(reply, nil, 0) end
    -- the game's own Pets menu (MainGui.Pets.Main.Scroll): one PetBox per pet with
    -- UID (IntValue), PetName, Equipped / Locked icons. Filled after the menu was opened once.
    if #out == 0 then
        pcall(function()
            local scroll = Data.MainGui().Pets.Main.Scroll
            for _, box in ipairs(scroll:GetChildren()) do
                local uid, name = box:FindFirstChild("UID"), box:FindFirstChild("PetName")
                if uid and name and uid.Value ~= 0 then
                    local eq, lk = box:FindFirstChild("Equipped"), box:FindFirstChild("Locked")
                    out[#out + 1] = { id = tostring(uid.Value), name = name.Text,
                        equipped = eq and eq.Visible or false, locked = lk and lk.Visible or false }
                end
            end
        end)
    end
    inventoryCache = out
    return out
end

function Features.Fuse()
    local types, rarities = F("FusePets") or {}, F("FuseRarity") or {}
    if not next(types) then return end
    -- only pets from the inventory list (GetPetData); equipped pets are never fused
    local ids = {}
    for _, p in ipairs(Data.Inventory()) do
