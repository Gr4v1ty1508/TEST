local Library = { Flags = {}, Theme = {} }
local Theme = Library.Theme
Theme.Window  = Color3.fromRGB(16, 16, 17)
Theme.Sidebar = Color3.fromRGB(19, 19, 20)
Theme.Card    = Color3.fromRGB(23, 23, 24)
Theme.Element = Color3.fromRGB(29, 29, 31)
Theme.Hover   = Color3.fromRGB(36, 36, 39)
Theme.Stroke  = Color3.fromRGB(40, 40, 43)
Theme.Text    = Color3.fromRGB(232, 232, 236)
Theme.Sub     = Color3.fromRGB(150, 150, 158)
Theme.Dim     = Color3.fromRGB(95, 95, 102)
Theme.Accent  = Color3.fromRGB(235, 235, 240)
Theme.SwitchOn  = Color3.fromRGB(105, 105, 112)
Theme.SwitchOff = Color3.fromRGB(48, 48, 52)

local accentTargets = {}   -- objects re-coloured when the accent changes

local function make(class, props, children)
    local o = Instance.new(class)
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else o[k] = v end
    end
    for _, c in ipairs(children or {}) do c.Parent = o end
    o.Parent = parent
    return o
end
local function corner(r) return make("UICorner", { CornerRadius = UDim.new(0, r or 8) }) end
local function stroke(c, t) return make("UIStroke", { Color = c or Theme.Stroke, Thickness = t or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) end
local function padding(l, r, t, b)
    return make("UIPadding", { PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or l or 0),
        PaddingTop = UDim.new(0, t or l or 0), PaddingBottom = UDim.new(0, b or t or l or 0) })
end
local function list(pad, dir)
    return make("UIListLayout", { Padding = UDim.new(0, pad or 0), SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = dir or Enum.FillDirection.Vertical })
end
local function tween(o, props, t, style)
    local tw = TweenService:Create(o, TweenInfo.new(t or 0.18, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end
local function text(props)
    local base = { BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center }
    for k, v in pairs(props) do base[k] = v end
    return make("TextLabel", base)
end
local function isPress(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end
local function isMove(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

local function guiParent()
    local ok, h = pcall(function() return gethui and gethui() end)
    if ok and h then return h end
    local ok2, core = pcall(function() local c = game:GetService("CoreGui") local _ = c.Name return c end)
    if ok2 and core then return core end
    return LP:WaitForChild("PlayerGui")
end

local function draggable(handle, target, onClick)
    local down, start, startPos, moved
    track(handle.InputBegan:Connect(function(input)
        if isPress(input) then
            down, moved, start, startPos = true, false, input.Position, target.Position
            local c
            c = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    c:Disconnect()
                    down = false
                    if not moved and onClick then onClick() end
                end
            end)
        end
    end))
    track(UIS.InputChanged:Connect(function(input)
        if down and isMove(input) then
            local d = input.Position - start
            if d.Magnitude > 6 then moved = true end
            if moved then
                target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end
    end))
end

-- small 3x3 dot grid icon used on dropdowns
local function gridIcon(parent)
    local holder = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 16),
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Parent = parent },
        { make("UIGridLayout", { CellSize = UDim2.fromOffset(4, 4), CellPadding = UDim2.fromOffset(2, 2) }) })
    for _ = 1, 9 do make("Frame", { BackgroundColor3 = Theme.Sub, BorderSizePixel = 0, Parent = holder }, { corner(1) }) end
    return holder
end

-- the hub's own mark: an outlined diamond
local function diamond(parent, size, filled)
    local d = make("Frame", { Size = UDim2.fromOffset(size, size), Rotation = 45, BorderSizePixel = 0,
        BackgroundColor3 = Theme.Accent, BackgroundTransparency = filled and 0 or 1, Parent = parent },
        { corner(2), stroke(Theme.Accent, 1.5) })
    return d
end

