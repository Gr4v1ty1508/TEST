-- Dropdown: searchable, single or multi. Items are strings.
function Elements:Dropdown(opt)
    self._order = self._order + 1
    local multi = opt.Multi
    local holder = make("Frame", { BackgroundColor3 = Theme.Element, Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = self._order, Parent = self.Body }, { corner(8), stroke(), list(0) })
    local header = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 1, Parent = holder })
    local headerText = text({ Text = opt.Title, TextColor3 = Theme.Sub, Position = UDim2.fromOffset(16, 0),
        Size = UDim2.new(1, -52, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = header })
    gridIcon(header)

    local body = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        Visible = false, LayoutOrder = 2, Parent = holder }, { list(6), padding(12, 12, 0, 10) })
    local search = make("TextBox", { BackgroundColor3 = Theme.Card, Size = UDim2.new(1, 0, 0, 34), Text = "",
        PlaceholderText = "Search...", PlaceholderColor3 = Theme.Dim, Font = Enum.Font.Gotham, TextSize = 13,
        TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
        LayoutOrder = 1, Visible = opt.Search ~= false, Parent = body }, { corner(8), padding(34, 10, 0, 0) })
    -- magnifier drawn with two frames
    local lens = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(10, 10), Position = UDim2.new(0, -22, 0.5, -7), Parent = search },
        { corner(5), stroke(Theme.Sub, 1.5) })
    make("Frame", { BackgroundColor3 = Theme.Sub, BorderSizePixel = 0, Size = UDim2.fromOffset(2, 6), Rotation = -45,
        Position = UDim2.fromOffset(10, 8), Parent = lens })

    local listFrame = make("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0),
        ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Dim, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = body }, { list(2) })

    local items, selected, single, rows, open = {}, {}, nil, {}, false
    local obj = { Type = "Dropdown" }

    local function summary()
        if multi then
            local names = Util.SetToList(selected)
            headerText.Text = #names > 0 and (opt.Title .. " • " .. table.concat(names, ", ")) or (opt.Title .. "...")
        else
            headerText.Text = single and (opt.Title .. " • " .. single) or (opt.Title .. "...")
        end
        headerText.TextColor3 = (single or next(selected)) and Theme.Text or Theme.Sub
    end

    local function paint(rowObj, name)
        local on = multi and selected[name] or (not multi and single == name)
        rowObj.check.Visible = on and true or false
        rowObj.label.Position = on and UDim2.fromOffset(34, 0) or UDim2.fromOffset(14, 0)
        rowObj.label.TextColor3 = on and Theme.Text or Theme.Sub
    end

    local function resize()
        local shown = 0
        for _, r in ipairs(rows) do if r.frame.Visible then shown = shown + 1 end end
        listFrame.Size = UDim2.new(1, 0, 0, math.min(shown * 36, opt.MaxHeight or 250))
    end

    local function fire()
        if not opt.Callback then return end
        if multi then
            local copy = {}
            for k, v in pairs(selected) do copy[k] = v end
            pcall(opt.Callback, copy)
        else
            pcall(opt.Callback, single)
        end
    end

    function obj:Refresh(newItems, keepSelection)
        for _, r in ipairs(rows) do r.frame:Destroy() end
        rows, items = {}, newItems or {}
        if keepSelection == false then selected, single = {}, nil end
        for i, name in ipairs(items) do
            local f = make("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = Theme.Element,
                BackgroundTransparency = 1, Size = UDim2.new(1, -4, 0, 34), LayoutOrder = i, Parent = listFrame }, { corner(6) })
            local check = text({ Text = "✓", Font = Enum.Font.GothamBold, TextSize = 13, Position = UDim2.fromOffset(12, 0),
                Size = UDim2.new(0, 16, 1, 0), Parent = f })
            local label = text({ Text = tostring(name), TextColor3 = Theme.Sub, Size = UDim2.new(1, -40, 1, 0),
                TextTruncate = Enum.TextTruncate.AtEnd, Parent = f })
            local r = { frame = f, check = check, label = label, name = name }
            rows[#rows + 1] = r
            paint(r, name)
            f.MouseEnter:Connect(function() tween(f, { BackgroundTransparency = 0.4 }, 0.1) end)
            f.MouseLeave:Connect(function() tween(f, { BackgroundTransparency = 1 }, 0.1) end)
            f.MouseButton1Click:Connect(function()
                if multi then
                    selected[name] = not selected[name] or nil
                else
                    if single == name and not opt.Required then single = nil else single = name end
                end
                for _, rr in ipairs(rows) do paint(rr, rr.name) end
                summary()
                fire()
            end)
        end
        search.Text = ""
        resize()
        summary()
    end

    function obj:Set(v, silent)
        if multi then
            selected = {}
            if type(v) == "table" then
                for k, on in pairs(v) do
                    if type(k) == "number" then selected[on] = true elseif on then selected[k] = true end
                end
            end
        else
            single = v
        end
        for _, r in ipairs(rows) do paint(r, r.name) end
        summary()
        if not silent then fire() end
    end
    function obj:Get()
        if multi then
            local copy = {}
            for k, v in pairs(selected) do copy[k] = v end
            return copy
        end
        return single
    end
    function obj:Items() return items end

    search:GetPropertyChangedSignal("Text"):Connect(function()
        local q = string.lower(search.Text)
        for _, r in ipairs(rows) do r.frame.Visible = q == "" or string.find(string.lower(tostring(r.name)), q, 1, true) ~= nil end
        resize()
    end)

    make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = header })
        .MouseButton1Click:Connect(function()
            open = not open
            body.Visible = open
        end)

    obj:Refresh(opt.Items or {})
    if opt.Default ~= nil then obj:Set(opt.Default, true) end
    return register(opt.Flag, obj)
end

