-- auto update: every 30 s compare the world list with what the dropdowns show;
-- a new world, a removed world or new numbering refreshes every list by itself
local lastWorldSig = nil
local function worldSignature()
    Data.ResetWorldCache()
    return table.concat(Data.FarmWorldLabels(), "\n") .. "#" .. table.concat(Data.EventWorlds(), "\n")
end
task.spawn(function()
    lastWorldSig = worldSignature()
    while running do
        task.wait(30)
        local ok, sig = pcall(worldSignature)
        if ok and sig ~= lastWorldSig then
            lastWorldSig = sig
            for _, fn in ipairs(Refreshers) do pcall(fn) end
            Util.Notify("World list updated")
        end
    end
end)
task.spawn(function()
    while running and autoSave do
