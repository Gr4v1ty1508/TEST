local Combat = {}
local SendPet = Bindables:FindFirstChild("SendPet")

-- Enemies far from you are streamed out: the model, its DisplayName / Health values
-- and its pivot exist, but its parts (HumanoidRootPart) don't until you get close.
-- So an enemy is alive by its Health value, and found by its pivot position.
Combat.Skip = setmetatable({}, { __mode = "k" })   -- enemy -> skip until (os.clock)
function Combat.Alive(e)
    if not e or not e.Parent then return false end
    if Combat.Skip[e] and os.clock() < Combat.Skip[e] then return false end
    local hp = e:FindFirstChild("Health")
    if hp then return hp.Value > 0 end
    return e:FindFirstChild("HumanoidRootPart") ~= nil
end
-- where an enemy is. With StreamingEnabled a far enemy is only an empty Model (no parts,
-- seen in the dumps), so: HumanoidRootPart -> any other part of it (CombatBorder, ...)
-- -> the model's pivot (only if it isn't the empty-model default at 0,0,0)
function Combat.Pos(e)
    if not e then return nil, nil end
    local part = e:FindFirstChild("HumanoidRootPart")
    if part and part:IsA("BasePart") then return part.Position, part end
    part = e:FindFirstChild("CombatBorder") or e:FindFirstChildWhichIsA("BasePart", true)
    if part then return part.Position, part end
    local ok, cf = pcall(e.GetPivot, e)
    if ok and cf and cf.Position.Magnitude > 5 then return cf.Position, nil end
    return nil, nil
end
-- GravityHub/AFS/combat_log.txt: what the attack loop picked and why it did / didn't teleport
Combat.LogLast = {}
function Combat.Log(key, msg)
    local now = os.clock()
    if Combat.LogLast[key] == msg then return end
    Combat.LogLast[key] = msg
    if key ~= "brain" then Combat.Status = msg end
    if not appendfile then return end
    pcall(function()
        if isfolder and makefolder and not isfolder(CFG.ConfigFolder) then
            local cur = ""
            for seg in string.gmatch(CFG.ConfigFolder, "[^/]+") do
                cur = cur == "" and seg or (cur .. "/" .. seg)
                if not isfolder(cur) then makefolder(cur) end
            end
        end
        local root = Util.Root()
        appendfile(CFG.ConfigFolder .. "/combat_log.txt", os.date("%H:%M:%S") .. string.format(" %.1f  ", now % 1000) .. msg
            .. (root and string.format("   me @ (%.0f, %.0f, %.0f)", root.Position.X, root.Position.Y, root.Position.Z) or "   (no character)") .. "\n")
    end)
end
function Combat.Name(e)
    local t = e:FindFirstChild("DisplayName")
    return t and t.Value or e.Name
end
function Combat.HP(e)
    local hp = e:FindFirstChild("Health")
    return hp and hp.Value or 0
end

-- the "Enemies" folders of a world. Big maps (the Tower has hundreds of rooms) are only
-- searched every 5 s instead of on every attack step.
local enemyFolderCache = {}
function Combat.EnemyFolders(world)
    local c = enemyFolderCache[world]
    if c and os.clock() - c.at < 5 then
        local alive = {}
        for _, f in ipairs(c.list) do if f.Parent then alive[#alive + 1] = f end end
        return alive
    end
    local list = {}
    local direct = world:FindFirstChild("Enemies")
    if direct then list[1] = direct end
    for _, obj in ipairs(world:GetDescendants()) do
        if obj.Name == "Enemies" and obj ~= direct and obj:IsA("Folder") then list[#list + 1] = obj end
    end
    enemyFolderCache[world] = { at = os.clock(), list = list }
    return list
end

-- names = set of names to keep (nil = all)
function Combat.List(worldName, names)
    local out = {}
    local world = Worlds:FindFirstChild(worldName or "")
    if not world then return out end
    local function consider(e)
        if Combat.Alive(e) and (not names or names[Combat.Name(e)] or names[e.Name]) then out[#out + 1] = e end
    end
    -- every world keeps its enemies in <World>.Enemies (dungeon / trial rooms may nest more)
    local folders = Combat.EnemyFolders(world)
    for _, f in ipairs(folders) do
        for _, e in ipairs(f:GetChildren()) do consider(e) end
    end
    if #folders == 0 then
        for _, e in ipairs(world:GetDescendants()) do
            if e:FindFirstChild("DisplayName") then consider(e) end
        end
    end
    return out
end

function Combat.MaxHP(e)
    local m = e:FindFirstChild("MaxHealth")
    return (m and m.Value) or Combat.HP(e)
end
-- Nearest   = closest one
-- Weakest   = the weakest KIND of mob (lowest MaxHealth); same kind -> least HP left, then closest
-- Strongest = the strongest kind (highest MaxHealth, = the boss); same kind -> closest
function Combat.Pick(list, mode)
    if #list == 0 then return nil end
    local root = Util.Root()
    local best, k1, k2, k3
    for _, e in ipairs(list) do
        local pos = Combat.Pos(e)
        local dist = (root and pos) and (pos - root.Position).Magnitude or math.huge
        local a, b, c
        if mode == "Weakest" then a, b, c = Combat.MaxHP(e), Combat.HP(e), dist
        elseif mode == "Strongest" then a, b, c = -Combat.MaxHP(e), dist, 0
        else a, b, c = dist, 0, 0 end
        if not best or a < k1 or (a == k1 and (b < k2 or (b == k2 and c < k3))) then
            best, k1, k2, k3 = e, a, b, c
        end
    end
    return best
end

Combat.Options = { Teleport = true, PetTP = false, Ult = false }
-- "Teleport While Farm" is for the normal world farm only. Every mode (Time Trial,
-- Infinity Tower, Dungeon, Raid, Gate, Defense, ...) always warps to its mobs, like Yuto Hub.
Combat.InFarm = false
function Combat.CanTP() return Combat.Options.Teleport or not Combat.InFarm end

-- RequestPetTeleport(pet) for each of YOUR equipped pets (needs the pet-teleport passive; the
-- game itself sends it too). Sent AFTER the character got to the enemy - sent before, it pulled
-- the pets to the spot we were leaving, and they had to run all the way after us.
-- Only pets that are far away (left behind) are pulled: pulling a pet that is already fighting
-- puts it back on the player and it stops hitting (seen: every pet stacked on the player).
function Combat.PetsToMe()
    if not Combat.Options.PetTP then return end
    local root = Util.Root()
    for _, pet in ipairs(Data.EquippedPets()) do
        local ok, far = pcall(function() return (pet:GetPivot().Position - root.Position).Magnitude > 60 end)
        if not ok or far then task.spawn(Net.Call, "PetTeleport", pet) end
    end
end
-- how many of my equipped pets are on this enemy right now (pet.Data.Attacking / ServerAttacking,
-- seen in the pet dump) and how many are equipped
function Combat.PetsOn(e, pets)
    -- the enemy keeps who hits it too: Attackers["1".."50"].Value = pet model (seen in the dump)
    local att = e:FindFirstChild("Attackers")
    if att then
        local mine, n = {}, 0
        for _, p in ipairs(pets) do mine[p] = true end
        for _, v in ipairs(att:GetChildren()) do
            if v:IsA("ObjectValue") and v.Value and mine[v.Value] then n = n + 1 end
        end
        if n > 0 then return n, #pets end
    end
    local on = 0
    for _, p in ipairs(pets) do
        local d = p:FindFirstChild("Data")
        local a = d and d:FindFirstChild("Attacking")
        local s = d and d:FindFirstChild("ServerAttacking")
        local av, sv = a and a.Value, s and s.Value
        if (av and (av == e or av:IsDescendantOf(e))) or (sv and (sv == e or sv:IsDescendantOf(e))) then on = on + 1 end
    end
    return on, #pets
end
-- pets that are far from the enemy and not fighting it: put them next to us (what other open
-- hubs do after every teleport: the pet model's TargetPart + HumanoidRootPart moved onto you)
function Combat.PullFarPets(e, pets, pos)
    local root = Util.Root()
    if not (root and pos) then return 0 end
    local n = 0
    for _, p in ipairs(pets) do
        local d = p:FindFirstChild("Data")
        local a = d and d:FindFirstChild("Attacking")
        local av = a and a.Value
        if not (av and (av == e or av:IsDescendantOf(e))) then
            local ok, far = pcall(function() return (p:GetPivot().Position - pos).Magnitude > 80 end)
            if ok and far then
                n = n + 1
                for _, nm in ipairs({ "TargetPart", "HumanoidRootPart" }) do
                    local part = p:FindFirstChild(nm)
                    if part and part:IsA("BasePart") then pcall(function() part.CFrame = root.CFrame end) end
                end
            end
        end
    end
    return n
end
function Combat.Attack(e, wanted, opts)
    local tag = opts and opts.tag
    local t0 = os.clock()
    local movedAt, sentAt, ultAt, pulledAt = nil, -99, 0, 0
    local arrived = true
    local streamedAt = 0
    local hp0, hpAt = Combat.HP(e), nil
    local hpStart = hp0
    local stats = { sends = 0, pulls = 0, maxOn = 0, firstHit = nil, tps = 0 }
    local pets, petsAt = Data.EquippedPets(), os.clock()
    do
        local pos, part = Combat.Pos(e)
        local root = Util.Root()
        local where = pos and string.format("(%.0f, %.0f, %.0f) %s", pos.X, pos.Y, pos.Z, part and part.Name or "pivot") or "NO POSITION"
        Combat.Log("atk", "target " .. e.Name .. " [" .. Combat.Name(e) .. "] hp " .. string.format("%.3g", Combat.HP(e))
            .. " at " .. where .. (root and pos and string.format("  dist %.0f", (pos - root.Position).Magnitude) or "")
            .. (Combat.CanTP() and "" or "  | Teleport While Farm is OFF"))
        if not pos then
            -- nothing to go to (not streamed in, no pivot): try the next one for a few seconds
            Combat.Skip[e] = os.clock() + 5
            return
        end
    end
    -- CFG.KillTimeout only ends a fight that stopped taking damage: chests have ~15x the HP of a
    -- mob (a Rare Chest took ~60 s) and were dropped at 25 s, then picked again
    while Combat.Alive(e) and wanted() and (os.clock() - t0 < CFG.KillTimeout or (hpAt and os.clock() - hpAt < 3)) do
        -- no damage at all for 8 s once we're next to it (room not started, out of reach):
        -- skip it for 30 s so the rest of the hub can move on
        if e:FindFirstChild("HumanoidRootPart") then
            hpAt = hpAt or os.clock()
            if Combat.HP(e) < hp0 then
                hp0, hpAt = Combat.HP(e), os.clock()
                stats.firstHit = stats.firstHit or (os.clock() - t0)
            end
            if os.clock() - hpAt > 8 then
                local on, total = Combat.PetsOn(e, pets)
                Combat.Log("atk", "no damage on " .. e.Name .. " for 8 s (pets on it " .. on .. "/" .. total .. ") -> skipped 30 s")
                Combat.Skip[e] = os.clock() + 30
                break
            end
        end
        if os.clock() - petsAt > 1 then pets, petsAt = Data.EquippedPets(), os.clock() end
        local root = Util.Root()
        local pos, part = Combat.Pos(e)
        -- optional per-fight hook (off: see Combat.FightTick note next to Features.Ult)
        if Combat.FightTick and os.clock() - ultAt > 0.31 then
            ultAt = os.clock()
            Combat.FightTick()
        end
        -- pets left behind: pulled once, right after we arrived at the enemy
        if movedAt and not arrived and os.clock() - movedAt > 0.05 then
            arrived = true
            Combat.PetsToMe()
        end
        local moved = false
        if Combat.CanTP() and root and pos and (root.Position - pos).Magnitude > 12 then
            movedAt, moved, arrived = os.clock(), true, false
            stats.tps = stats.tps + 1
            if part then
                root.CFrame = part.CFrame * CFrame.new(0, 0, 4)
            else
                -- not loaded yet: go to where it is and ask the game to load that area
                root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 4))
                if os.clock() - streamedAt > 2 then
                    streamedAt = os.clock()
                    task.spawn(pcall, function() LP:RequestStreamAroundAsync(pos) end)
                end
            end
        end
        -- send the pets (the game's click: SendPet:Fire(enemy, true, true)).
        -- Not in the same frame as a teleport: right after one the game withdraws the pets
        -- (WithdrawPets fires again and again while you move - seen in the logs), which undid the
        -- send, and the old code only sent again 5 s later = ~6 s per mob. Now it looks at the
        -- pets themselves: none on this enemy -> send again every 0.3 s; some on it -> every 1.5 s;
        -- all on it -> leave them alone (a send restarts their attack).
        if not moved and SendPet and (e:FindFirstChild("HumanoidRootPart") or part)
           and (not movedAt or os.clock() - movedAt > 0.1) then
            local on, total = Combat.PetsOn(e, pets)
            if on > stats.maxOn then stats.maxOn = on end
            local every = (on == 0 and 0.3) or (on < total and 1.5) or math.huge
            -- it's taking damage although no pet reads as "on it" (the game may not fill those
            -- values everywhere): don't keep re-sending fast
            if on == 0 and stats.firstHit and os.clock() - hpAt < 1 then every = 3 end
            if os.clock() - sentAt > every then
                sentAt = os.clock()
                stats.sends = stats.sends + 1
                pcall(SendPet.Fire, SendPet, e, true, true)
            end
            -- pets still far away a moment after we arrived: bring them over (every 2 s at most)
            if on < total and os.clock() - pulledAt > 2 and (not movedAt or os.clock() - movedAt > 0.4) then
                pulledAt = os.clock()
                local n = Combat.PullFarPets(e, pets, pos)
                if n > 0 then stats.pulls = stats.pulls + 1 end
            end
        end
        -- a short visit (dungeon): leave once the pets are on it, at most 1.5 s
        if tag and not moved then
            local on = Combat.PetsOn(e, pets)
            if on > stats.maxOn then stats.maxOn = on end
            if (on > 0 and movedAt and os.clock() - movedAt > 0.4) or os.clock() - t0 > 1.5 then break end
        end
        task.wait()
    end
    -- one line per enemy in combat_log.txt: where the time went
    pcall(function()
        Combat.Log("done", string.format("%s [%s] %s in %.1f s | first hit %s | pets on it max %d/%d | sends %d | pulls %d | tps %d | hp %.3g -> %.3g",
            e.Name, Combat.Name(e), Combat.Alive(e) and (tag and "visited (pets on it)" or "LEFT") or "killed", os.clock() - t0,
            stats.firstHit and string.format("%.1f s", stats.firstHit) or "never", stats.maxOn, #pets,
            stats.sends, stats.pulls, stats.tps, hpStart, Combat.HP(e)))
    end)
end

-- one attack step; false when nothing is left
function Combat.Step(worldName, wanted, names, mode, maxDist, skip)
    local list = Combat.List(worldName, names)
    if skip then
        local keep = {}
        for _, e in ipairs(list) do if not skip(e) then keep[#keep + 1] = e end end
        list = keep
    end
    if maxDist then
        -- only enemies near us (the Tower holds every player's trial run in one map)
        local root = Util.Root()
        local near, far, unknown = {}, 0, 0
        for _, e in ipairs(list) do
            local pos = Combat.Pos(e)
            if not pos then unknown = unknown + 1
            elseif root and (pos - root.Position).Magnitude <= maxDist then near[#near + 1] = e
            else far = far + 1 end
        end
        if #near == 0 and #list > 0 then
            Combat.Log("near", #list .. " enemies in " .. tostring(worldName) .. ": " .. far .. " farther than " .. maxDist .. ", " .. unknown .. " without a position")
        end
        list = near
    end
    local target = Combat.Pick(list, mode or "Nearest")
    if not target then
        Combat.Log("step", "no enemy in " .. tostring(worldName) .. (maxDist and (" within " .. maxDist) or "") .. " (found " .. #list .. ")")
        return false
    end
    Combat.LogLast.step = nil
    Combat.Attack(target, wanted)
    return true
end

