-- uses the ultimate the same way the player does: the R button on screen, the R key,
-- and the UseAbility remote as a last resort
local VIM = game:GetService("VirtualInputManager")
function Features.Ult()
    -- "Attack While Ulti" (watched from Yuto Hub): every ~0.3 s, for every equipped pet model
    -- PetAttack(pet) then PetAbility(pet) - pets keep attacking and use their ult without
    -- waiting for the animation
    for _, pet in ipairs(Data.EquippedPets()) do
        Net.Raw("PetAttack", { pet })
        Net.Raw("PetAbility", { pet })
    end
end
-- Combat.FightTick (PetAttack + PetAbility for every pet ~3x a second while fighting) is NOT set:
-- Yuto's dungeon runs (two full logs) send none of it - the game's own pet code then teleports
-- the pets onto each enemy (RequestPetTeleport) and mobs die in ~1 s. With the spam on, the game
