local Flags = Library.Flags
local function F(flag)
    local el = Flags[flag]
    if not el then return nil end
    return el:Get()
end
local function On(flag) return F(flag) == true end
local function worldsFrom(flag)
    local out = {}
    for _, label in ipairs(Util.SetToList(F(flag))) do out[#out + 1] = Data.FromLabel(label) end
    return out
end
local function contains(t, v) for _, x in ipairs(t) do if x == v then return true end end return false end

local Features = {}
local Stats = { InfFloor = 1, InfBest = 0, DungeonRuns = 0, GateRuns = 0, TrialFloor = 0, TrialName = nil, Rebirths = 0 }
