-- whole inventory: the game keeps it on the server; GetPetData (RemoteFunction) is
-- asked once a minute. Whatever shape it answers with, pets are read as
-- { id, name, rarity, shiny, locked, equipped } when those fields can be found.
local inventoryCache, inventoryAt = {}, -999
-- save data (GetData("GameData").Pets): { UID = 866728, PetId = "Femto", CustomName = "Lucky",
--   Passives = { "EnchantingFairy", ... }, Shiny, Void, Locked, Level }
local PET_NAME_KEYS = { "PetId", "Name", "PetName", "Pet", "Type" }
local PET_ID_KEYS = { "UID", "Uid", "uid", "ID" }
local function fieldOf(t, names)
    for _, n in ipairs(names) do if t[n] ~= nil then return t[n] end end
    return nil
end
-- every table in `root` that looks like a pet (a name + a UID, or a name keyed by a number)
local function scanPets(root, out, index)
    local seen = {}
    local function scan(t, keyId, depth)
        if type(t) ~= "table" or depth > 6 or seen[t] then return end
        seen[t] = true
        local name = fieldOf(t, PET_NAME_KEYS)
        local id = fieldOf(t, PET_ID_KEYS) or (type(keyId) == "number" and keyId or tonumber(keyId))
        if type(name) == "string" and id ~= nil and (t.Passives ~= nil or t.Level ~= nil or t.UID ~= nil or t.Shiny ~= nil) then
            local nick, shown = t.CustomName, Data.PetDisplay(name)
            local stats = (Data.Module("PetStats") or {})[name]
            local rec = { id = tostring(id), name = (type(nick) == "string" and nick ~= "" and nick ~= shown) and (nick .. " | " .. shown) or shown,
                type = name, rarity = fieldOf(t, { "Rarity", "Tier" }) or (type(stats) == "table" and stats.Rarity or nil),
                shiny = fieldOf(t, { "Shiny", "IsShiny" }), locked = fieldOf(t, { "Locked", "Lock", "IsLocked" }),
                equipped = fieldOf(t, { "Equipped", "IsEquipped" }), raw = t }
            if not index[rec.id] then out[#out + 1] = rec index[rec.id] = rec end
            return
        end
        for k, v in pairs(t) do scan(v, k, depth + 1) end
    end
    local pets = root.Pets or root.pets or root.PetInventory or root.Inventory
    scan(type(pets) == "table" and pets or root, nil, 0)
    if #out == 0 and type(pets) == "table" then scan(root, nil, 0) end
end
-- the player's whole save as the client sees it: Modules.LocalDairebStore.GetData()
-- (this is where every pet in the inventory is, not only the equipped ones)
function Data.StoreData()
    local st = Data.Module("LocalDairebStore")
    if not st or type(st.GetData) ~= "function" then return nil end
    -- the client's save is the "GameData" store (Pets, EquippedPets, TeamEventData, ...)
    local ok, r = pcall(st.GetData, "GameData")
    if ok and type(r) == "table" then return r end
    -- other builds: the names are the keys of the stores table in GetData's upvalues
    local getup = (debug and debug.getupvalues) or getupvalues
    local tries = {}
    if getup then
        for _, fn in ipairs({ st.GetData, st.IndexExists }) do
            local okU, ups = pcall(getup, fn)
            for _, u in pairs(okU and ups or {}) do
                if type(u) == "table" then
                    for k in pairs(u) do if type(k) == "string" then tries[#tries + 1] = { k } end end
                end
            end
        end
    end
    local best, bestN = nil, 0
    for _, args in ipairs(tries) do
        local ok2, r2 = pcall(st.GetData, table.unpack(args))
        if ok2 and type(r2) == "table" and next(r2) then
            local n = 0
            pcall(function() local o, i = {}, {} scanPets(r2, o, i) n = #o end)
            if n > bestN then best, bestN = r2, n end
            if not best then best = r2 end
        end
    end
    return best
end
Data.InventoryIndex = {}
function Data.Inventory(force)
    if not force and os.clock() - inventoryAt < 60 and #inventoryCache > 0 then return inventoryCache end
    inventoryAt = os.clock()
    local out, index = {}, {}
    -- 1. the client's copy of your save (all pets)
    local store = Data.StoreData()
    if store then
        pcall(scanPets, store, out, index)
        -- GameData.EquippedPets = { uid, uid, ... }
        if type(store.EquippedPets) == "table" then
            for _, uid in pairs(store.EquippedPets) do
                local rec = index[tostring(uid)]
                if rec then rec.equipped = true end
            end
        end
    end
    -- 2. GetPetData remote
    if #out == 0 then
        local ok, reply = pcall(Net.Raw, "GetPetData", {})
        if ok and type(reply) == "table" then pcall(scanPets, reply, out, index) end
    end
    -- 3. the game's own Pets menu (filled after the menu was opened once)
    if #out == 0 then
        pcall(function()
            local scroll = Data.MainGui().Pets.Main.Scroll
            for _, box in ipairs(scroll:GetChildren()) do
                local uid, name = box:FindFirstChild("UID"), box:FindFirstChild("PetName")
                if uid and name and uid.Value ~= 0 then
                    local eq, lk = box:FindFirstChild("Equipped"), box:FindFirstChild("Locked")
                    local rec = { id = tostring(uid.Value), name = name.Text,
                        equipped = eq and eq.Visible or false, locked = lk and lk.Visible or false }
                    out[#out + 1] = rec
                    index[rec.id] = rec
                end
            end
        end)
    end
    inventoryCache, Data.InventoryIndex = out, index
    return out
end
-- passive <slot> of any pet (equipped model first, else the saved data)
function Data.PetPassive(id, slot)
    -- live read from the save every time (GameData.Pets[i].UID / .Passives), so it works
    -- right after joining too, before any pet list was refreshed
    local raw
    local store = Data.StoreData()
    if store and type(store.Pets) == "table" then
        for _, t in pairs(store.Pets) do
            if type(t) == "table" and tostring(t.UID) == tostring(id) then raw = t break end
        end
    end
    if not raw then
        local rec = Data.InventoryIndex[tostring(id)]
        if not rec then Data.Inventory() rec = Data.InventoryIndex[tostring(id)] end
        raw = rec and rec.raw
    end
    local p = raw and (raw.Passives or raw.Passive)
    if type(p) == "table" then
        local v = p[slot] or p[tostring(slot)]
        if type(v) == "table" then v = v.Name or v.Passive or v.Id or v[1] end
        if v ~= nil then return tostring(v) end
        return ""                                  -- the pet was found, this slot is empty
    elseif type(p) == "string" and slot == 1 then
        return p
    end
    return nil
end

-- take every equipped pet off and put it back in the same slot order (what "re equip" means:
-- fresh pet models = they attack again right away)
function Features.ReEquipPets()
    local uids = {}
    for _, m in ipairs(Data.EquippedPets()) do
        local uid = Data.PetUID(m)
        if uid then uids[#uids + 1] = tonumber(uid) or uid end
    end
    if #uids == 0 then return end
    for _, uid in ipairs(uids) do Net.Call("ManagePetUnequip", uid) end
    task.wait(0.4)
    for slot, uid in ipairs(uids) do Net.Call("ManagePetEquip", uid, slot) end
end


-- PASSIVE ------------------------------------------------------------------------------------
local passiveDone, passiveRolls = {}, {}
local PassiveStatus

local function readPassive(petId, slot, reply)
    local pet = Data.PetObject(petId)
    if pet then
        local v = Data.PetValue(pet, { "Passive" .. slot, "Passive_" .. slot, "PassiveSlot" .. slot })
        if v == nil and slot == 1 then v = Data.PetValue(pet, { "Passive", "PassiveName" }) end
        if v == nil then
            local folder = (pet:FindFirstChild("Data") and pet.Data:FindFirstChild("Passives")) or pet:FindFirstChild("Passives")
            local c = folder and (folder:FindFirstChild(tostring(slot)) or folder:GetChildren()[slot])
            if c then v = c:IsA("ValueBase") and c.Value or c.Name end
        end
        if v ~= nil then return tostring(v) end
    end
    local saved = Data.PetPassive(petId, slot)
    if saved then return saved end
    if type(reply) == "table" then
        local r = reply[slot] or reply.Passive or reply.Name or reply[1]
        return r and tostring(r) or nil
    elseif reply ~= nil then
        return tostring(reply)
    end
    return nil
end

-- machines = the "Category" values in the game's PassiveStats ("Frieren2026", "Easter2026", ...)
-- passives without a category are the normal machine
function Data.PassiveMachines()
    local seen, out = {}, {}
    for k in pairs(Data.Module("PassiveCategories") or {}) do
        if type(k) == "string" and not seen[k] then seen[k] = true out[#out + 1] = k end
    end
    if #out > 0 then
        table.sort(out)
        table.insert(out, 1, "Normal")
        return out
    end
    for _, t in pairs(Data.Module("PassiveStats") or {}) do
        if type(t) == "table" and type(t.Category) == "string" and not seen[t.Category] then
            seen[t.Category] = true
            out[#out + 1] = t.Category
        end
    end
    table.sort(out)
    table.insert(out, 1, "Normal")
    if #out == 1 then return CFG.PassiveMachines end
    return out
end

function Features.PassiveStatusText()
    local lines = {}
    local ready = next(F("PassivePets") or {}) and next(F("PassiveSlots") or {})
    lines[#lines + 1] = "Status [" .. (On("AutoPassive") and "<font color='#4ade80'>running</font>" or (ready and "<font color='#4ade80'>ready</font>" or "<font color='#f87171'>not ready</font>")) .. "]"
    lines[#lines + 1] = "[-] Pets : " .. Util.Count(F("PassivePets"))
    lines[#lines + 1] = "[-] Passive Slot : " .. table.concat(Util.SetToList(F("PassiveSlots")), ", ")
    lines[#lines + 1] = "[-] Reroll Mode : " .. tostring(F("PassiveMode") or "-")
    lines[#lines + 1] = "[-] Passive Selected :"
    for _, n in ipairs(Util.SetToList(F("PassiveNames"))) do lines[#lines + 1] = "    [+] " .. n end
    lines[#lines + 1] = "[-] Passive Rarity Selected :"
    for _, n in ipairs(Util.SetToList(F("PassiveRarity"))) do lines[#lines + 1] = "    [+] " .. n end
    lines[#lines + 1] = "[-] Passive Machine : " .. tostring(F("PassiveMachine") or "-")
    lines[#lines + 1] = "[-] Delayed " .. tostring(F("PassiveDelay") or 0.5)
    local done, total = 0, 0
    for _ in pairs(passiveRolls) do total = total + 1 end
    for _ in pairs(passiveDone) do done = done + 1 end
    lines[#lines + 1] = "[-] Slots done : " .. done .. " / " .. total
    return table.concat(lines, "\n")
end

local _, passiveRarityOf = Data.Passives()
local warnedRead = false
local function passiveWanted(got)
    if not got then return false end
    if (F("PassiveMode") or "Keep Selected Passive") == "Keep Selected Rarity" then
        return (F("PassiveRarity") or {})[passiveRarityOf[got] or ""] == true
    end
    for name in pairs(F("PassiveNames") or {}) do
        if string.lower(got) == string.lower(name) or string.find(string.lower(got), string.lower(name), 1, true) then return true end
    end
    return false
end
-- Yuto Hub (watched): every ~0.55 s ONE RollPassive per pet, always on the same slot of that
-- pet until it's good: RollPassive(uid, machine, true, slot). A slot that already holds a
-- wanted passive is never rolled.
function Features.Passive()
    local pets = Util.SetToList(F("PassivePets"))
    local slots = Util.SetToList(F("PassiveSlots"))
    if #pets == 0 or #slots == 0 then return end
    local machine = F("PassiveMachine") or "Normal"
    if not Features.PassiveReady(machine, "passive") then return end
    local sent = {}
    for _, label in ipairs(pets) do
        local id = Data.PetId(label)
        for _, slotText in ipairs(slots) do
            local slot = tonumber(slotText) or 1
            local key = id .. "#" .. slot
            if not passiveDone[key] then
                local now = readPassive(id, slot)
                if now == nil and not Data.PetObject(id) then
                    -- not equipped and its passive can't be read: rolling blind could roll
                    -- straight past the passive you want, so this pet is skipped
                    if Util.Every("passive-blind-" .. key, 30) then
                        Util.Notify(label .. ": can't read its passive - equip it to roll it")
                    end
                    break
                elseif passiveWanted(now) then
                    passiveDone[key] = true            -- already good: keep it, never roll it
                else
                    passiveRolls[key] = (passiveRolls[key] or 0) + 1
                    Net.Call("RollPassive", id, machine, slot, F("PassiveMethod") == "Shard")
                    sent[#sent + 1] = { label = label, id = id, slot = slot, key = key }
                    break                              -- one slot per pet per round
                end
            end
        end
    end
    if #sent == 0 then
        Flags.AutoPassive:Set(false)
        Util.Notify("All selected slots have a kept passive")
        if PassiveStatus then PassiveStatus:Set(Features.PassiveStatusText()) end
        return
    end
    task.wait(F("PassiveDelay") or 0.5)
    -- pets that aren't equipped are read from the save data: re-read it once per round
    for _, r in ipairs(sent) do
        if not Data.PetObject(r.id) then Data.Inventory(true) break end
    end
    for _, r in ipairs(sent) do
        local got = readPassive(r.id, r.slot)
        if passiveWanted(got) then
            passiveDone[r.key] = true
            Util.Notify(r.label .. " slot " .. r.slot .. " -> " .. got)
        elseif not got and not warnedRead then
            warnedRead = true
            Util.Notify("Can't read the pet's passive - send a Gravity Dumper report")
        end
    end
    if PassiveStatus then PassiveStatus:Set(Features.PassiveStatusText()) end
end
-- LUNAR VS SOLAR QUESTS --------------------------------------------------------------------------
-- Modules.TeamEventInfo (EventId "LunarSolar2026"): 9 passive quests, labels in QuestLabels,
-- goals in Targets. Progress is read from the event board in PlayerGui (each row: the label
-- text + a "12/2000" text next to it), so the board has to be opened once.
-- Every quest is done by rerolling ONE pet / slot the player picks:
--   Normal / Divine quests -> machine + currency that move the most unfinished quests at once
--   Spend ... Shards -> "Shard Reroll", Spend ... Tokens -> "Token Reroll"
do
local EQ = { rows = {}, scannedAt = -999 }
local function eqNumber(t)
    if not t then return nil end
    local n, suf = string.match(string.gsub(t, ",", ""), "^%s*([%d%.]+)%s*([KkMm]?)%s*$")
    n = tonumber(n)
    if not n then return nil end
    if suf == "K" or suf == "k" then n = n * 1e3 elseif suf == "M" or suf == "m" then n = n * 1e6 end
    return n
end
local function eqPattern(fmt)
    local esc = string.gsub(fmt, "[%(%)%.%+%-%*%?%[%]%^%$]", "%%%0")
    esc = string.gsub(esc, "%%s", "[%%d,%%.]+[KkMm]?")
    return "^%s*" .. esc .. "%s*$"
end
function Features.EventQuestScan()
    local info = Data.Module("TeamEventInfo")
    local pg = LP:FindFirstChild("PlayerGui")
    if not (info and info.QuestLabels and pg) then return false end
    local pats = {}
    for key, fmt in pairs(info.QuestLabels) do pats[key] = eqPattern(fmt) end
    local rows = {}
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text ~= "" then
            for key, pat in pairs(pats) do
                if not rows[key] and string.find(d.Text, pat) then
                    -- the "x/y" text is in the same row (siblings, or one level down)
                    local row, prog = d.Parent, nil
                    for _, c in ipairs(row and row:GetDescendants() or {}) do
                        if c:IsA("TextLabel") and c ~= d and string.find(c.Text, "^%s*[%d,%.]+[KkMm]?%s*/%s*[%d,%.]+[KkMm]?%s*$") then prog = c break end
                    end
                    if prog then rows[key] = { title = d, progress = prog } end
                end
            end
        end
    end
    EQ.rows, EQ.scannedAt = rows, os.clock()
    return next(rows) ~= nil
end
-- key -> { cur, goal } (nil when the board isn't loaded)
function Features.EventQuestProgress()
    -- 1. the save: GameData.TeamEventData.QuestsFinished = { NormalPassives = 3, ... } (= the board's "3/2000")
    local info = Data.Module("TeamEventInfo")
    local store = Data.StoreData and Data.StoreData()
    local ted = store and store.TeamEventData
    if type(ted) == "table" and type(ted.QuestsFinished) == "table" and info and type(info.Targets) == "table"
       and (not info.EventId or not ted.EventId or ted.EventId == info.EventId) then
        -- a finished quest isn't a number any more (seen: board 2000/2000 while the save read 0),
        -- so anything that isn't a number but is set counts as done; the board rows
        -- (MainGui.TeamEvent.Quests.Frame.<Quest>.Progress "x/y") are read too and the higher wins
        local board
        pcall(function() board = Data.MainGui().TeamEvent.Quests.Frame end)
        local out = {}
        for key, goal in pairs(info.Targets) do
            local goalN = tonumber(goal)
            if goalN then
                local v = ted.QuestsFinished[key]
                local cur = tonumber(v) or ((v ~= nil and v ~= false) and goalN or 0)
                -- or marked in another table of TeamEventData (e.g. Completed[key] = true)
                for k2, t2 in pairs(ted) do
                    if k2 ~= "QuestsFinished" and type(t2) == "table" and t2[key] == true then cur = goalN end
                end
                local row = board and board:FindFirstChild(key)
                local prog = row and row:FindFirstChild("Progress")
                if prog and prog:IsA("TextLabel") then
                    local a, b = string.match(prog.Text, "^%s*(.-)%s*/%s*(.-)%s*$")
                    local ga, gb = eqNumber(a), eqNumber(b)
                    if ga and gb and gb == goalN and ga > cur then cur = ga end
                end
                out[key] = { cur = math.min(cur, goalN), goal = goalN }
            end
        end
        if next(out) then return out end
    end
    -- 2. the board in PlayerGui (MainGui.TeamEvent.Quests.Frame.<Quest>.Progress)
    local alive = false
    for _, r in pairs(EQ.rows) do if r.progress.Parent then alive = true break end end
    if not alive and os.clock() - EQ.scannedAt > 10 then
        if not Features.EventQuestScan() and Util.Every("eq-open", 20) then
            -- board not built yet: press the game's own TeamEvent button (left menu) once
            local mg = Data.MainGui()
            local btn = mg and mg:FindFirstChild("TeamEvent", true)
            if btn and btn:IsA("GuiButton") and Features.FireGui then
                Features.FireGui(btn, { "MouseButton1Down", "MouseButton1Click", "Activated" })
                task.wait(1.5)
                Features.EventQuestScan()
            end
        end
    end
    local out = {}
    for key, r in pairs(EQ.rows) do
        if r.progress.Parent then
            local a, b = string.match(r.progress.Text, "^%s*(.-)%s*/%s*(.-)%s*$")
            local cur, goal = eqNumber(a), eqNumber(b)
            if cur and goal then out[key] = { cur = cur, goal = goal } end
        end
    end
    return next(out) and out or nil
end
-- seconds left before the next set of quests (0 = quests are open). After all quests are done
-- the board shows "0:01:59:43" (2 h, TeamEventInfo.CooldownTimer) and rolls don't count then.
-- Read from the save (TeamEventData.QuestTimer + CooldownTimer) and from the board's Timer text.
function Features.EventQuestCooldown()
    local left = 0
    pcall(function()
        -- QuestTimer = when the last quest was finished (0 = never); the new quests come
        -- CooldownTimer (7200 s) later. Seen: QuestTimer 1791140914, board "0:01:53:19".
        local ted = Data.StoreData().TeamEventData
        local info = Data.Module("TeamEventInfo") or {}
        local t = tonumber(ted.QuestTimer) or 0
        local cdLen = tonumber(info.CooldownTimer) or 7200
        local now = workspace:GetServerTimeNow()
        if t > 0 and t + cdLen > now then left = math.min(t + cdLen - now, cdLen) end
    end)
    pcall(function()
        local timer = Data.MainGui().TeamEvent.Quests.Timer
        -- "Quest Timer: 00:00:00" (open) or "0:01:59:43" (d:hh:mm:ss) / "01:59:43"
        local parts = {}
        for n in string.gmatch(timer.Text, "%d+") do parts[#parts + 1] = tonumber(n) end
        local secs, any = 0, #parts > 0
        for i, n in ipairs(parts) do
            secs = (i == 2 and #parts == 4) and (secs * 24 + n) or (secs * 60 + n)
        end
        if any and secs > left then left = secs end
    end)
    return math.floor(left)
end
-- which quests one reroll moves: machine "Normal" / "Event" / "Requiem", shards = true/false
local EQ_MOVES = {
    NormalPassives       = function(m) return m == "Normal" end,
    NormalDivinePassives = function(m) return m == "Normal" end,
    EventPassives        = function(m) return m == "Event" end,
    EventDivinePassives  = function(m) return m == "Event" end,
    DivinePassives       = function() return true end,
    EventShards          = function(m, sh) return m == "Event" and sh end,
    EventTokens          = function(m, sh) return m == "Event" and not sh end,
    WorldShards          = function(m, sh) return m == "Normal" and sh end,
    RequiemTokens        = function(m, sh) return m == "Requiem" and not sh end,
}
-- order = which one wins when two move the same number of quests:
-- Requiem token -> Event token (the picked Event Machine) -> Normal token -> Event shard -> Normal shard
local EQ_CHOICES = {
    { "Requiem", false }, { "Event", false }, { "Normal", false }, { "Event", true }, { "Normal", true },
}
-- the item a reroll pays with (Items in the save): RequiemToken, <Category>PassiveToken /
-- <Category>Shard (PassiveCategories), PassiveToken for Normal. nil = unknown (not checked)
function Features.EQCurrency(machineKind, shards)
    local cats = Data.Module("PassiveCategories") or {}
    if machineKind == "Requiem" then
        return (type(cats.Requiem) == "table" and cats.Requiem.TokenId) or "RequiemToken"
    elseif machineKind == "Event" then
        local c = cats[F("EQEventMachine") or "Frieren2026"]
        if type(c) ~= "table" then return nil end
        if shards then return c.ShardId end
        return c.TokenId
    elseif not shards then
        return "PassiveToken"
    end
    return nil
end
function Features.EQHave(item)
    local st = Data.StoreData()
    local it = st and st.Items
    return type(it) == "table" and (tonumber(it[item]) or 0) or nil
end
function Features.EventQuestStatus()
    local info = Data.Module("TeamEventInfo")
    local prog = Features.EventQuestProgress()
    local lines = {}
    if not info then return "TeamEventInfo module not found" end
    if not prog then return "Open the Lunar vs Solar quest board once so the hub can read it." end
    for _, key in ipairs(info.QuestOrder or {}) do
        local q = prog[key]
        local fmt = (info.QuestLabels or {})[key] or key
        local goal = q and q.goal or (info.Targets or {})[key] or 0
        local text = string.format(fmt, tostring(goal))
        lines[#lines + 1] = (q and q.cur >= q.goal and "[done] " or "[ ] ") .. text .. "  " .. (q and (q.cur .. "/" .. q.goal) or "?")
    end
    return table.concat(lines, "\n")
end
function Features.EventQuests()
    -- several pets: each one gets a reroll every round (old single-pet config still works)
    -- right after a join the picks still hold last game's UIDs (other pets now!): wait
    if not Features.PicksReady then task.wait(1) return end
    local pets = Util.SetToList(F("EQPets"))
    if #pets == 0 and type(F("EQPet")) == "string" and F("EQPet") ~= "" then pets = { F("EQPet") } end
    if #pets == 0 then
        if Util.Every("eq-pet", 30) then Util.Notify("Event Quests: pick the pets to reroll first") end
        return
    end
    -- all quests done -> 2 h cooldown: don't roll (it wouldn't count), leave the character to the
    -- other features and start again by itself when the new quests open
    local cd = Features.EventQuestCooldown()
    if cd > 0 then
        if Util.Every("eq-cd", 600) then
            Util.Notify(string.format("Lunar vs Solar: new quests in %d:%02d - doing other things meanwhile", cd // 3600, (cd % 3600) // 60))
        end
        if Features.EQStatus and Util.Every("eq-status", 5) then
            pcall(function() Features.EQStatus:Set(string.format("Cooldown : %d:%02d:%02d (new quests after this)", cd // 3600, (cd % 3600) // 60, cd % 60)) end)
        end
        task.wait(2)
        return
    end
    local prog = Features.EventQuestProgress()
    if not prog then
        if Util.Every("eq-board", 30) then Util.Notify("Event Quests: open the Lunar vs Solar quest board once") end
        return
    end
    local wanted = F("EQQuests") or {}
    local open = {}
    for key, q in pairs(prog) do
        if q.cur < q.goal and (not next(wanted) or wanted[key]) then open[key] = true end
    end
    if not next(open) then
        -- points are given by the game as each quest finishes (nothing to hand in).
        -- When all are done the board resets after its cooldown: keep waiting, then start again.
        if Util.Every("eq-alldone", 300) then Util.Notify("Lunar vs Solar: all quests done - waiting for the new quests") end
        if Features.EQStatus and Util.Every("eq-status", 10) then
            pcall(function() Features.EQStatus:Set("Waiting for new quests\n" .. Features.EventQuestStatus()) end)
        end
        task.wait(5)
        return
    end
    -- the machine + currency that moves the most unfinished quests
    local best, bestN, unreachable
    for _, c in ipairs(EQ_CHOICES) do
        -- shards are only spent while their own "Spend ... Shards" quest is still open
        local shardQuest = c[1] == "Normal" and "WorldShards" or "EventShards"
        local n = 0
        if c[2] and not open[shardQuest] then n = -1 end
        -- not enough of what this reroll pays with (1 per pet per round): skip it
        local cur = Features.EQCurrency(c[1], c[2])
        local have = cur and Features.EQHave(cur)
        if have and have < #pets then n = -1 end
        -- its machine can't be reached right now (see GoPassiveMachine): use another choice
        local mach = c[1] == "Event" and (F("EQEventMachine") or "Frieren2026") or c[1]
        if On("PassiveGoMachine") and not Features.MachineReachable(mach) then n = -1 unreachable = mach end
        if n == 0 then
            for key in pairs(open) do if EQ_MOVES[key] and EQ_MOVES[key](c[1], c[2]) then n = n + 1 end end
        end
        if n > 0 and (not bestN or n > bestN) then best, bestN = c, n end
    end
    if not best then
        if Util.Every("eq-broke", 60) then
            Util.Notify(unreachable and ("Lunar vs Solar: the " .. tostring(unreachable) .. " machine can't be reached right now - doing other things, trying again in a few minutes")
                or "Lunar vs Solar: not enough tokens / shards for the open quests")
        end
        task.wait(3)
        return
    end
    local machine = best[1] == "Event" and (F("EQEventMachine") or "Frieren2026") or best[1]
    local slot = tonumber(F("EQSlot") or "1") or 1
    if not Features.PassiveReady(machine, "lunar") then return end
    for _, label in ipairs(pets) do
        Net.Call("RollPassive", Data.PetId(label), machine, slot, best[2])
    end
    Features.EQLast = machine .. (best[2] and " shard" or " token") .. " reroll x" .. #pets
    task.wait(F("EQDelay") or 0.5)
    if Features.EQStatus and Util.Every("eq-status", 2) then
        pcall(function() Features.EQStatus:Set("Rolling : " .. Features.EQLast .. "\n" .. Features.EventQuestStatus()) end)
    end
end
end

-- MEGA BOOST CRAFTER --------------------------------------------------------------------------------
-- Potion Master (Worlds.Frieren.MegaBooster): 50 Super boosts -> 1 Mega boost (Remote UpgradePotion).
-- Super boosts come from the Time Trial shop (Remote TrialShopPurchase, paid with Items.TowerShard).
-- Each item stacks to 500 (ItemStats.ItemLimit). Per selected Mega boost, until it has 500:
--   Super < 50 -> buy as many Supers as fit (500 cap / shards)  ->  craft while Super >= 50.
-- The exact arguments are learned from the game when you buy / craft once by hand
-- (learned_calls.json); until then a few forms are tried and the one that changes your items is kept.
do
local MB = { buyForm = nil, craftForm = nil, tried = {} }
local MEGA_FALLBACK = {
    { key = "MegaDmg", form = "Dmg", name = "Mega DMG Boost" }, { key = "MegaDrops", form = "Drops", name = "Mega Drop Boost" },
    { key = "MegaLuck", form = "Luck", name = "Mega Luck Boost" }, { key = "MegaPassiveLuck", form = "Passive", name = "Mega Passive Luck Boost" },
    { key = "MegaTime", form = "Time", name = "Mega Time Boost" }, { key = "MegaXp", form = "Xp", name = "Mega XP Boost" },
    { key = "MegaYen", form = "Yen", name = "Mega Yen Boost" },
}
function Features.MegaTypes()
    local bd, shop = Data.Module("BoostData"), Data.Module("TimeTrialShop") or {}
    local list = {}
    if bd then
        for key, v in pairs(bd) do
            if type(v) == "table" and v.BasicForm and string.sub(key, 1, 4) == "Mega" then
                list[#list + 1] = { key = key, form = v.BasicForm, name = v.DisplayName or key }
            end
        end
    end
    if #list == 0 then list = MEGA_FALLBACK end
    local out = {}
    for _, m in ipairs(list) do
        local base = string.sub(m.key, 5)                         -- "Xp", "PassiveLuck"
        local src = shop["Super" .. base .. "Boost"] and ("Super" .. base .. "Boost")
            or (shop[base .. "Boost"] and (base .. "Boost")) or ("Super" .. base .. "Boost")
        local price = type(shop[src]) == "table" and tonumber(shop[src].Price) or nil
        out[#out + 1] = { key = m.key, form = m.form, name = m.name, mega = m.key .. "Boost", src = src, price = price }
    end
    table.sort(out, function(a, b) return a.name < b.name end)
    return out
end
function Features.MegaNames()
    local n = {}
    for _, m in ipairs(Features.MegaTypes()) do n[#n + 1] = m.name end
    return n
end
local function itemCount(name)
    local st = Data.StoreData()
    local it = st and st.Items
    return type(it) == "table" and (tonumber(it[name]) or 0) or 0
end
local function itemLimit(name)
    local is = Data.Module("ItemStats")
    local v = type(is) == "table" and type(is[name]) == "table" and tonumber(is[name].ItemLimit)
    return v or 500
end
-- wait up to `t` seconds for an item count to change
local function waitChange(name, before, t)
    local t0 = os.clock()
    while os.clock() - t0 < t do
        task.wait(0.2)
        local now = itemCount(name)
        if now ~= before then return now - before end
    end
    return 0
end
-- learned args with the item swapped: every string arg that is one of `known` becomes the
-- matching form for this item (same kind as the learned one), numbers become `amount`
local function learnedArgs(remote, m, kinds, amount)
    local args, n = Learn.Get(remote)
    if not args then return nil end
    for i = 1, n do
        local a = args[i]
        if type(a) == "string" then
            local done = false
            for _, getter in pairs(kinds) do
                for _, other in ipairs(Features.MegaTypes()) do
                    if getter(other) == a then args[i] = getter(m) done = true break end
                end
                if done then break end
            end
        elseif type(a) == "number" and amount then
            args[i] = amount
        end
    end
    args.n = n
    return args
end
local BUY_KINDS = { src = function(x) return x.src end }
local CRAFT_KINDS = { key = function(x) return x.key end, form = function(x) return x.form end,
    mega = function(x) return x.mega end, src = function(x) return x.src end }
local BUY_GUESSES = { function(m, a) return { m.src, a, n = 2 } end, function(m) return { m.src, n = 1 } end }
local CRAFT_GUESSES = {
    function(m) return { m.key, n = 1 } end, function(m) return { m.form, n = 1 } end,
    function(m) return { m.mega, n = 1 } end, function(m) return { m.src, n = 1 } end,
}
function Features.MegaBuy(m, amount)
    local before = itemCount(m.src)
    local learned = learnedArgs("TrialShopPurchase", m, BUY_KINDS, amount)
    if learned then
        Net.Raw("TrialShopPurchase", learned)
        return waitChange(m.src, before, 3)
    end
    local first = MB.buyForm or 1
    for i = first, (MB.buyForm or #BUY_GUESSES) do
        Net.Raw("TrialShopPurchase", BUY_GUESSES[i](m, amount))
        local got = waitChange(m.src, before, 2.5)
        if got > 0 then MB.buyForm = i return got end
    end
    return 0
end
function Features.MegaCraftOne(m)
    local before = itemCount(m.mega)
    local learned = learnedArgs("UpgradePotion", m, CRAFT_KINDS, nil)
    if learned then
        Net.Raw("UpgradePotion", learned)
        return waitChange(m.mega, before, 3)
    end
    local first = MB.craftForm or 1
    for i = first, (MB.craftForm or #CRAFT_GUESSES) do
        Net.Raw("UpgradePotion", CRAFT_GUESSES[i](m))
        local got = waitChange(m.mega, before, 2.5)
        if got > 0 then MB.craftForm = i return got end
    end
    return 0
end
-- the Potion Master stands in Worlds.Frieren (MegaBooster)
function Features.GoPotionMaster()
    if Util.World() ~= "Frieren" then
        if Util.Every("mega-travel", 6) then Travel.To("Frieren") task.wait(1.5) end
        return
    end
    local w = Worlds:FindFirstChild("Frieren")
    local mdl = w and w:FindFirstChild("MegaBooster")
    local part = mdl and mdl:FindFirstChildWhichIsA("BasePart", true)
    local root = Util.Root()
    if part and root and (root.Position - part.Position).Magnitude > 12 then
        Util.MoveTo(part.CFrame * CFrame.new(0, 3, 8))
        task.wait(0.3)
    end
end
function Features.AtPotionMaster()
    if Util.World() ~= "Frieren" then return false end
    local w = Worlds:FindFirstChild("Frieren")
    local mdl = w and w:FindFirstChild("MegaBooster")
    local part = mdl and mdl:FindFirstChildWhichIsA("BasePart", true)
    local root = Util.Root()
    return part ~= nil and root ~= nil and (root.Position - part.Position).Magnitude < 25
end
function Features.MegaStatusText()
    local lines = {}
    local picked = F("MegaTypes") or {}
    for _, m in ipairs(Features.MegaTypes()) do
        if picked[m.name] then
            local c = itemCount(m.mega)
            lines[#lines + 1] = (c >= itemLimit(m.mega) and "[done] " or "[ ] ") .. m.name .. "  " .. c .. "/" .. itemLimit(m.mega)
                .. "   (" .. m.src .. " " .. itemCount(m.src) .. ")"
        end
    end
    lines[#lines + 1] = "Tower Shards : " .. itemCount("TowerShard")
    return table.concat(lines, "\n")
end
function Features.MegaCraft()
    local picked = F("MegaTypes") or {}
    local shards = itemCount("TowerShard")
    local anyOpen, craftM, buyM, buyAmt = false, nil, nil, 0
    for _, m in ipairs(Features.MegaTypes()) do
        local mega = itemCount(m.mega)
        if picked[m.name] and mega < itemLimit(m.mega) then
            anyOpen = true
            local src = itemCount(m.src)
            if src >= 50 then craftM = m break end
            -- not enough Supers for one craft: buy as many as fit (500 cap, shards, what's still needed)
            local room = math.min(itemLimit(m.src) - src, (itemLimit(m.mega) - mega) * 50 - src)
            if m.price and m.price > 0 then room = math.min(room, math.floor(shards / m.price)) end
            if room >= 50 - src and not buyM then buyM, buyAmt = m, room end
        end
    end
    if not anyOpen then
        Flags.AutoMegaCraft:Set(false)
        Util.Notify("Mega Boosts: every selected boost is full")
        return
    end
    if craftM then
        local m = craftM
        -- craft at the Potion Master
        if On("MegaGoMaster") then
            Features.MegaWantAt = os.clock()
            if not Features.AtPotionMaster() then return end
        end
        local crafts = math.min(itemCount(m.src) // 50, itemLimit(m.mega) - itemCount(m.mega))
        for _ = 1, crafts do
            if not On("AutoMegaCraft") then return end
            if Features.MegaCraftOne(m) <= 0 then
                if Util.Every("mega-craft", 30) then
                    Util.Notify("Mega Boosts: crafting didn't work - craft one Mega boost by hand at the Potion Master")
                end
                task.wait(3)
                return
            end
            Features.MegaWantAt = os.clock()
        end
        return
    end
    if buyM then
        if Features.MegaBuy(buyM, buyAmt) <= 0 and Util.Every("mega-buy", 30) then
            Util.Notify("Mega Boosts: buying didn't work - buy one Super boost by hand in the Time Trial shop")
            task.wait(3)
        end
        return
    end
    if Util.Every("mega-poor", 60) then Util.Notify("Mega Boosts: not enough Tower Shards to buy more Super boosts") end
    task.wait(5)
end
end

-- PASSIVE MACHINE (like Yuto): rerolls are done standing at the machine.
-- Each machine is Worlds.<World>.Passive (prompt "Reroll"). Event categories have their own
-- world (Frieren2026, Easter2026, BC2026, Christmas2); Normal / Requiem use the main machine.
do
local NORMAL_MACHINE_WORLDS = { TimeChamber = true, MHA = true, MadeInAbyss = true, MachineWorld = true }
function Features.PassiveMachineWorld(machine)
    if machine and machine ~= "Normal" and machine ~= "Requiem" then
        local w = Worlds:FindFirstChild(machine)
        if w and w:FindFirstChild("Passive") then return machine end
    end
    local cur = Util.World()
    local w = Worlds:FindFirstChild(cur)
    if NORMAL_MACHINE_WORLDS[cur] and w and w:FindFirstChild("Passive") then return cur end
    return "TimeChamber"
end
function Features.PassiveMachineCFrame(world)
    local w = Worlds:FindFirstChild(world)
    local m = w and w:FindFirstChild("Passive")
    if not m then return nil end
    local root = m:FindFirstChild("RootPart") or m:FindFirstChildWhichIsA("BasePart", true)
    if root then return root.CFrame end
    local ok, cf = pcall(m.GetPivot, m)
    if ok and cf and cf.Position.Magnitude > 5 then return cf end
    return nil
end
function Features.AtPassiveMachine(machine)
    local world = Features.PassiveMachineWorld(machine)
    if Util.World() ~= world then return false end
    local cf, root = Features.PassiveMachineCFrame(world), Util.Root()
    return cf ~= nil and root ~= nil and (root.Position - cf.Position).Magnitude < 25
end
-- called by the Brain (it owns the character): travel to the machine's world, then stand at it
-- a machine whose world can't be reached (travel refused 3 times in a row - event world closed,
-- locked, or the game won't let you leave where you are): skipped for 10 min. Before, Lunar
-- (priority 1) kept trying every 6 s forever and held the character - nothing else ran for hours.
Features.MachineFail = {}
function Features.MachineReachable(machine)
    local f = Features.MachineFail[Features.PassiveMachineWorld(machine)]
    return not (f and f.untilT and os.clock() < f.untilT)
end
function Features.GoPassiveMachine(machine)
    local world = Features.PassiveMachineWorld(machine)
    if Util.World() ~= world then
        if Util.Every("passive-travel", 6) then
            Travel.To(world)
            task.wait(1.5)
            if Util.World() ~= world then
                local f = Features.MachineFail[world] or { n = 0 }
                f.n = f.n + 1
                if f.n >= 3 then
                    f.n, f.untilT = 0, os.clock() + 600
                    Util.Notify("Passive machine in " .. Data.WorldDisplay(world) .. ": can't get there (teleport failed 3x) - skipped for 10 min")
                    Combat.Log("passive", "machine world " .. world .. " unreachable (travel failed 3x) - skipped for 10 min")
                end
                Features.MachineFail[world] = f
            else
                Features.MachineFail[world] = nil
            end
        end
        return
    end
    local cf, root = Features.PassiveMachineCFrame(world), Util.Root()
    if cf and root and (root.Position - cf.Position).Magnitude > 12 then
        Util.MoveTo(cf * CFrame.new(0, 3, 8))
        task.wait(0.3)
    end
end
