local lastPos
conns[#conns + 1] = game:GetService("RunService").Heartbeat:Connect(function()
    if not recording then lastPos = nil return end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local p = root.Position
    if lastPos and (p - lastPos).Magnitude > 25 then
        local from, to = lastPos, p
        task.spawn(function()
            rec(string.format("TP %s -> %s  %.0f studs  at: %s", posText(from), posText(to), (to - from).Magnitude, whatIsAt(to)))
        end)
    end
    lastPos = p
end)

