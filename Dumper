local function startRecord(all)
    calls = { t0 = os.clock() }
    lastIncoming = {}
    lastLine, lastCount = nil, 0
    watchAll = all and true or false
    recording = true
    rec("recording started in world " .. (wv and tostring(wv.Value) or "?") .. (watchAll and "  (watching other scripts too)" or ""))
    if watchAll then
        status("watching... run the other hub's feature now")
    else
        status(hookmetamethod and "recording... do the actions by hand" or "recording (no hookmetamethod: only server -> you)")
    end
end
local function stopRecord()
    recording = false
    rec("recording stopped")
    flushRepeat()
    local stamp = os.date("%H%M%S")
    local name = (watchAll and "watch_" or "calls_") .. stamp .. ".txt"
    save(name, calls)
    watchAll = false
    status("saved " .. name .. " (" .. #calls .. " lines)")
end

