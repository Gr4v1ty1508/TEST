------------------------------------------------------------------------
-- files
------------------------------------------------------------------------
local function ensureFolder(path)
    if not (isfolder and makefolder) then return end
    local cur = ""
    for part in string.gmatch(path, "[^/]+") do
        cur = cur == "" and part or (cur .. "/" .. part)
        pcall(function() if not isfolder(cur) then makefolder(cur) end end)
    end
end
local function save(name, lines)
    if not writefile then return false end
    ensureFolder(ROOT .. (string.find(name, "/") and ("/" .. string.match(name, "^(.*)/")) or ""))
    local text = type(lines) == "table" and table.concat(lines, "\n") or tostring(lines)
    return pcall(writefile, ROOT .. "/" .. name, text)
end

------------------------------------------------------------------------
-- small helpers
------------------------------------------------------------------------
local function path(obj)
    local ok, p = pcall(function() return obj:GetFullName() end)
    return ok and p or tostring(obj)
end

local function valueText(v)
    local t = typeof(v)
    if t == "Instance" then return "<" .. v.ClassName .. "> " .. path(v) end
    if t == "string" then return string.format("%q", string.sub(v, 1, 200)) end
    if t == "table" then return "{table}" end
    return tostring(v)
end

local function attrs(obj)
    local ok, a = pcall(function() return obj:GetAttributes() end)
    if not ok or type(a) ~= "table" or next(a) == nil then return "" end
    local parts = {}
    for k, v in pairs(a) do parts[#parts + 1] = k .. "=" .. valueText(v) end
    table.sort(parts)
    return "  @{" .. table.concat(parts, ", ") .. "}"
end

local function describe(obj)
    local s = obj.Name .. "  <" .. obj.ClassName .. ">"
    pcall(function()
        if obj:IsA("ValueBase") then s = s .. " = " .. valueText(obj.Value) end
        if obj:IsA("GuiObject") then s = s .. (obj.Visible and "  [visible]" or "  [hidden]") end
        if obj:IsA("LayerCollector") then s = s .. (obj.Enabled and "  [enabled]" or "  [disabled]") end
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            if obj.Text ~= "" then s = s .. '  "' .. string.sub(obj.Text, 1, 60) .. '"' end
        end
        if obj:IsA("ProximityPrompt") then s = s .. '  prompt "' .. obj.ActionText .. '" / "' .. obj.ObjectText .. '" hold=' .. obj.HoldDuration end
        if obj:IsA("BasePart") then
            local p = obj.Position
            s = s .. string.format("  pos(%.0f, %.0f, %.0f)", p.X, p.Y, p.Z)
        end
        if obj:IsA("Model") and obj.PrimaryPart then s = s .. "  primary=" .. obj.PrimaryPart.Name end
    end)
    return s .. attrs(obj)
end

-- tree with same-named siblings grouped ("x40 of: Enemy <Model>") so it stays readable
local function tree(obj, depth, out, indent, maxKinds)
    indent = indent or ""
    if #out >= MAX_LINES then return end
    if not obj then out[#out + 1] = indent .. "(missing)" return end
    local kids = {}
    pcall(function() kids = obj:GetChildren() end)
    out[#out + 1] = indent .. describe(obj) .. (#kids > 0 and ("  (" .. #kids .. ")") or "")
    if depth <= 0 or #kids == 0 then return end
    local groups, order = {}, {}
    for _, c in ipairs(kids) do
        local key = c.Name .. "<" .. c.ClassName .. ">"
        if not groups[key] then groups[key] = { first = c, n = 0 } order[#order + 1] = key end
        groups[key].n = groups[key].n + 1
    end
    for i, key in ipairs(order) do
        if i > (maxKinds or 80) then out[#out + 1] = indent .. "  ... " .. (#order - i + 1) .. " more kinds" break end
        local g = groups[key]
        if g.n > 1 then out[#out + 1] = indent .. "  x" .. g.n .. " of:" end
        tree(g.first, depth - 1, out, indent .. "  ", maxKinds)
        if #out >= MAX_LINES then out[#out + 1] = "... (cut, file too long)" return end
    end
end

-- table -> readable text (cycle safe, depth / size limited)
local function ser(v, depth, seen, indent)
    indent = indent or ""
    local t = typeof(v)
    if t ~= "table" then
        if t == "function" then return "<function>" end
        return valueText(v)
    end
    if seen[v] then return "<cycle>" end
    if depth <= 0 then return "{...}" end
    seen[v] = true
    local keys = {}
    for k in pairs(v) do keys[#keys + 1] = k end
    table.sort(keys, function(a, b)
        if type(a) == type(b) and (type(a) == "number" or type(a) == "string") then return a < b end
        return type(a) < type(b)
    end)
    local lines = { "{" }
    for i, k in ipairs(keys) do
        if i > 400 then lines[#lines + 1] = indent .. "  ... " .. (#keys - 400) .. " more" break end
        local ks = type(k) == "string" and k or ("[" .. tostring(k) .. "]")
        lines[#lines + 1] = indent .. "  " .. ks .. " = " .. ser(v[k], depth - 1, seen, indent .. "  ")
    end
    lines[#lines + 1] = indent .. "}"
    seen[v] = nil
    return table.concat(lines, "\n")
end

local function argsText(args, n)
    local parts = {}
    for i = 1, n do
        local a = args[i]
        if typeof(a) == "table" then
            parts[i] = "[" .. i .. "] " .. string.gsub(ser(a, 4, {}, "      "), "\n%s*", " ")
        else
            parts[i] = "[" .. i .. "] " .. valueText(a)
        end
    end
    return table.concat(parts, ", ")
end

