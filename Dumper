local SKIP_MODULES = { GameAnalytics = true, MarketplaceHandler = true, PlayerInputModule = true, LocalizationHandler = true }
local function dumpModules()
    local folder = RS:FindFirstChild("ModuleScripts")
    if not folder then save("modules/_none.txt", "no ReplicatedStorage.ModuleScripts") return end
    local index = {}
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("ModuleScript") and not SKIP_MODULES[m.Name] then
            status("module " .. m.Name)
            local done, ok, res = false, false, nil
            task.spawn(function()
                ok, res = pcall(require, m)
                done = true
            end)
            local t0 = os.clock()
            while not done and os.clock() - t0 < 3 do task.wait() end
            local text
            if not done then text = "(require timed out)"
            elseif not ok then text = "(require failed) " .. tostring(res)
            else text = ser(res, 7, {}, "") end
            save("modules/" .. m.Name .. ".txt", text)
            index[#index + 1] = string.format("%-28s %s", m.Name, (not done and "timeout") or (ok and typeof(res)) or "failed")
        end
    end
    save("modules/_index.txt", index)
end

-- your whole save as the client holds it (Modules.LocalDairebStore.GetData()):
-- every pet in the inventory with its passives - Gravity Hub's Auto Passive reads this
local function dumpStore()
    local m = RS:FindFirstChild("LocalDairebStore", true)
    if not (m and m:IsA("ModuleScript")) then save("store.txt", "(LocalDairebStore not found)") return end
    local ok, st = pcall(require, m)
    if not ok or type(st) ~= "table" or type(st.GetData) ~= "function" then save("store.txt", "(can't require: " .. tostring(st) .. ")") return end
    local LPl = game:GetService("Players").LocalPlayer
    local lines = {}
    for _, fn in ipairs({ "IsEnabled", "GetDataStoreConnected" }) do
        if type(st[fn]) == "function" then
            local okf, r = pcall(st[fn])
            lines[#lines + 1] = fn .. "() -> " .. (okf and ser(r, 2, {}, "") or ("error " .. tostring(r)))
        end
    end
    local tries = { { "GetData()", {} }, { "GetData(store)", { st } }, { "GetData(player)", { LPl } },
        { "GetData(store, player)", { st, LPl } }, { "GetData(userId)", { LPl.UserId } }, { "GetData(\"Pets\")", { "Pets" } } }
    local res, used = nil, nil
    for _, t in ipairs(tries) do
        local done, okc, r = false, false, nil
        task.spawn(function() okc, r = pcall(st.GetData, table.unpack(t[2])) done = true end)
        local t0 = os.clock()
        while not done and os.clock() - t0 < 4 do task.wait() end
        lines[#lines + 1] = t[1] .. " -> " .. (not done and "(timed out)"
            or (okc and (type(r) == "table" and "table" or (type(r) .. " " .. tostring(r))) or ("error " .. tostring(r))))
        if done and okc and type(r) == "table" and next(r) and not res then res, used = r, t[1] end
    end
    lines[#lines + 1] = ""
    lines[#lines + 1] = res and ("=== " .. used .. " ===\n" .. ser(res, 5, {}, "")) or "(no table returned)"
    save("store.txt", table.concat(lines, "\n"))
end

local function dumpAll()
    local steps = {
        { "summary", dumpSummary }, { "remotes", dumpRemotes }, { "player", dumpPlayer },
        { "gui", dumpGui }, { "world", dumpWorld }, { "near", dumpNear }, { "modes", dumpModes },
        { "trees", dumpBig }, { "modules", dumpModules }, { "store", dumpStore },
    }
    local errs = {}
    for _, s in ipairs(steps) do
        status("dumping " .. s[1] .. "...")
        local ok, e = pcall(s[2])
        if not ok then errs[#errs + 1] = s[1] .. ": " .. tostring(e) end
        task.wait()
    end
    if #errs > 0 then save("dump_errors.txt", errs) end
    status(#errs == 0 and "done - saved to " .. ROOT or ("done with " .. #errs .. " errors (dump_errors.txt)"))
end

------------------------------------------------------------------------
-- recorder: your remote calls (+ return values) and what the server sends
------------------------------------------------------------------------
local recording = false
local watchAll = false      -- "Watch Other Hub": also record calls made by other executor scripts
local calls = {}
local lastIncoming = {}
local lastLine, lastCount = nil, 0
local function flushRepeat()
    if lastCount > 1 then calls[#calls] = calls[#calls] .. "   (x" .. lastCount .. ")" end
    lastLine, lastCount = nil, 0
end
local function rec(line)
    if #calls >= 8000 then return end
    -- the same call again and again (attacks...) is written once with a count
    if line == lastLine then lastCount = lastCount + 1 return end
    flushRepeat()
    lastLine, lastCount = line, 1
    calls[#calls + 1] = string.format("%8.2f  %s", os.clock() - (calls.t0 or os.clock()), line)
end
local function shouldRecord()
    return recording and running and (watchAll or not (checkcaller and checkcaller()))
end
local function who()
    return (checkcaller and checkcaller()) and "[script] " or "[game]   "
end
local function posText(p) return string.format("(%.0f, %.0f, %.0f)", p.X, p.Y, p.Z) end
-- names of what's at a position (parts within 12 studs), for teleports / touches
local function whatIsAt(pos)
    local names = {}
    pcall(function()
        local params = OverlapParams.new()
        local char = LP.Character
        if char then params.FilterDescendantsInstances = { char } params.FilterType = Enum.RaycastFilterType.Exclude end
        for i, part in ipairs(workspace:GetPartBoundsInRadius(pos, 12, params)) do
            if i > 4 then break end
            names[#names + 1] = path(part)
        end
    end)
    return #names > 0 and table.concat(names, " | ") or "nothing"
end

if hookmetamethod and getnamecallmethod then
    local original
    original = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        -- IMPORTANT: no method calls (GetFullName, IsA, ...) before original() below -
        -- they would replace the namecall method and the game's real call (attacks!)
        -- would never be sent. Only plain reads here; all formatting runs later.
        if shouldRecord() and typeof(self) == "Instance" then
            local isRemote = (method == "FireServer" or method == "InvokeServer")
            local parent = self.Parent
            local isBindable = watchAll and (method == "Fire" or method == "Invoke") and parent and parent.Name == "Bindable"
            if (isRemote or isBindable) and (watchAll or not SPAM[self.Name]) then
                local args, obj, tag = table.pack(...), self, who()
                local function head()
                    return tag .. "OUT " .. obj.Name .. ":" .. method .. "(" .. argsText(args, args.n) .. ")"
                end
                if method == "InvokeServer" then
                    if setnamecallmethod then setnamecallmethod(method) end
                    local res = table.pack(original(self, ...))
                    task.spawn(function()
                        rec(head() .. "  ->  " .. (res.n > 0 and argsText(res, res.n) or "nil"))
                    end)
                    return table.unpack(res, 1, res.n)
                end
                task.spawn(function() rec(head()) end)
            end
        end
        if setnamecallmethod then setnamecallmethod(method) end
        return original(self, ...)
    end)
end

-- other hubs sometimes call the functions directly (not through __namecall), and use
-- the executor's prompt / touch helpers: hook those too while watching
local hooked = {}
if hookfunction then
    local function hookRemoteMethod(className, methodName)
        local ok, fn = pcall(function() return Instance.new(className)[methodName] end)
        if not ok or not fn then return end
        local old
        old = hookfunction(fn, (newcclosure or function(f) return f end)(function(self, ...)
            if watchAll and shouldRecord() and typeof(self) == "Instance" then
                local args, obj, tag = table.pack(...), self, who()
                task.spawn(function()
                    rec(tag .. "OUT(direct) " .. obj.Name .. ":" .. methodName .. "(" .. argsText(args, args.n) .. ")")
                end)
            end
            return old(self, ...)
        end))
        hooked[#hooked + 1] = { fn = fn, old = old }
    end
    pcall(hookRemoteMethod, "RemoteEvent", "FireServer")
    pcall(hookRemoteMethod, "RemoteFunction", "InvokeServer")
    local function hookGlobal(name, describeArgs)
        local fn = getgenv and getgenv()[name] or nil
        if type(fn) ~= "function" then return end
        local old
        old = hookfunction(fn, (newcclosure or function(f) return f end)(function(...)
            if watchAll and recording and running then
                local args = table.pack(...)
                task.spawn(function()
                    local ok, txt = pcall(describeArgs, table.unpack(args, 1, args.n))
                    rec("[script] " .. name .. " " .. (ok and txt or "?"))
                end)
            end
            return old(...)
        end))
        hooked[#hooked + 1] = { fn = fn, old = old }
    end
    pcall(hookGlobal, "fireproximityprompt", function(p)
        return path(p) .. '  "' .. tostring(p.ActionText) .. '"'
    end)
    pcall(hookGlobal, "firetouchinterest", function(a, b, state)
        local part = (typeof(b) == "Instance" and b:IsA("BasePart")) and b or a
        return path(part) .. "  state=" .. tostring(state) .. (part:IsA("BasePart") and ("  at " .. posText(part.Position)) or "")
    end)
    pcall(hookGlobal, "firesignal", function(sig) return tostring(sig) end)
end

-- teleports: the character jumping more than 25 studs in one frame (what other hubs do
