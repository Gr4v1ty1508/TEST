            if not recording then return end
            local args = table.pack(...)
            local line = "IN  " .. r.Name .. "(" .. argsText(args, args.n) .. ")"
            if lastIncoming[r.Name] == line then return end   -- same message again
            lastIncoming[r.Name] = line
            rec(line)
        end)
    end
