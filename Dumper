local status = function() end

local function dumpSummary()
    local out = {}
    local exec = "?"
    pcall(function() exec = table.concat({ identifyexecutor() }, " ") end)
    out[#out + 1] = "Gravity Dumper  " .. os.date("%Y-%m-%d %H:%M:%S")
    out[#out + 1] = "executor: " .. exec .. "   place: " .. tostring(game.PlaceId) .. "   job: " .. tostring(game.JobId)
    local w = LP:FindFirstChild("World")
    out[#out + 1] = "World value: " .. (w and valueText(w.Value) or "(no World value)")
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then out[#out + 1] = string.format("you are at (%.0f, %.0f, %.0f)", root.Position.X, root.Position.Y, root.Position.Z) end
    local fns = {}
    for _, n in ipairs({ "hookmetamethod", "getnamecallmethod", "checkcaller", "getconnections", "firesignal",
        "fireproximityprompt", "firetouchinterest", "fireclickdetector", "writefile", "appendfile", "readfile",
        "setclipboard", "gethui", "getgc", "getsenv", "decompile", "request", "identifyexecutor" }) do
        fns[#fns + 1] = n .. "=" .. tostring(getfenv()[n] ~= nil)
    end
    out[#out + 1] = "functions: " .. table.concat(fns, " ")
    local worlds = workspace:FindFirstChild("Worlds")
    out[#out + 1] = "Worlds folders: " .. (worlds and #worlds:GetChildren() or 0)
    save("summary.txt", out)
end

local function dumpRemotes()
    local out = {}
    for _, root in ipairs({ RS, workspace, LP, game:GetService("StarterGui") }) do
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") or d:IsA("UnreliableRemoteEvent")
                or d:IsA("BindableEvent") or d:IsA("BindableFunction") then
                out[#out + 1] = string.format("%-22s %s", d.ClassName, path(d))
            end
        end
    end
    table.sort(out)
    save("remotes.txt", out)
end

local function dumpPlayer()
    local out = {}
    for _, c in ipairs(LP:GetChildren()) do
        if c.Name ~= "PlayerGui" and c.Name ~= "PlayerScripts" and c.Name ~= "Backpack" and c.Name ~= "Pets" then
            tree(c, 3, out)
        end
    end
    out[#out + 1] = "player attributes:" .. attrs(LP)
    local pets = LP:FindFirstChild("Pets")
    out[#out + 1] = ""
    out[#out + 1] = "Pets: " .. (pets and #pets:GetChildren() or 0)
    if pets then
        for i, p in ipairs(pets:GetChildren()) do
            if i > 3 then break end
            -- LocalPlayer.Pets holds ObjectValues -> follow them to the pet model (its Data folder)
            local m = p:IsA("ObjectValue") and p.Value or p
            if m then
                out[#out + 1] = "  pet " .. i .. ": " .. path(m)
                local data = m:FindFirstChild("Data")
                tree(data or m, 3, out, "    ")
            end
        end
    end
    -- the server's pet data (read-only RemoteFunction)
    local rem = RS:FindFirstChild("Remote")
    for _, n in ipairs({ "GetPetData", "GetBPdata", "GetRebirthData", "GetYenMultiplier", "GetBaseLevel" }) do
        local r = rem and rem:FindFirstChild(n)
        if r and r:IsA("RemoteFunction") then
            local done, ok, res = false, false, nil
            task.spawn(function() ok, res = pcall(r.InvokeServer, r) done = true end)
            local t0 = os.clock()
            while not done and os.clock() - t0 < 5 do task.wait() end
            save("server_" .. n .. ".txt", not done and "(timed out)" or (ok and ser(res, 6, {}, "") or ("(error) " .. tostring(res))))
        end
    end
    save("player.txt", out)
end

local function dumpGui()
    local out = {}
    local pg = LP:FindFirstChild("PlayerGui")
    for _, g in ipairs(pg and pg:GetChildren() or {}) do
        tree(g, g.Name == "MainGui" and 5 or 2, out, "", 120)
    end
    save("gui.txt", out)
end

local function dumpWorld()
    local out = {}
    local worlds = workspace:FindFirstChild("Worlds")
    local wv = LP:FindFirstChild("World")
    local name = wv and tostring(wv.Value) or ""
    local w = worlds and worlds:FindFirstChild(name)
    out[#out + 1] = "current world: " .. name
    tree(w, 6, out, "", 60)
    -- first enemy-looking model in full
    if w then
        for _, d in ipairs(w:GetDescendants()) do
            if d:IsA("Model") and d:FindFirstChild("HumanoidRootPart") and (d:FindFirstChild("Health") or d:FindFirstChild("DisplayName") or d:GetAttribute("Health")) then
                out[#out + 1] = ""
                out[#out + 1] = "first enemy (" .. path(d) .. "):"
                tree(d, 4, out, "  ", 60)
                break
            end
        end
    end
    local eff = workspace:FindFirstChild("Effects")
    out[#out + 1] = ""
    out[#out + 1] = "workspace.Effects:"
    tree(eff, 3, out, "  ", 40)
    save("world.txt", out)
end

-- every map piece within 1500 studs of you, NOT grouped (e.g. your own trial rooms
-- among hundreds of same-named rooms), 5 levels deep
local function plain(obj, depth, out, indent)
    if #out >= MAX_LINES then return end
    out[#out + 1] = indent .. describe(obj)
    if depth <= 0 then return end
    for _, c in ipairs(obj:GetChildren()) do
        if not c:IsA("Texture") and not c:IsA("Decal") and not c:IsA("Sound") then
            plain(c, depth - 1, out, indent .. "  ")
        end
    end
end
local function dumpNear()
    local out = {}
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local worlds = workspace:FindFirstChild("Worlds")
    local wv = LP:FindFirstChild("World")
    local w = worlds and wv and worlds:FindFirstChild(tostring(wv.Value))
    if not root or not w then save("near.txt", "no character / world") return end
    out[#out + 1] = string.format("you: (%.0f, %.0f, %.0f) in %s", root.Position.X, root.Position.Y, root.Position.Z, w.Name)
    local function near(m)
        local ok, cf = pcall(function() return m:GetPivot() end)
        if m:IsA("BasePart") then return (m.Position - root.Position).Magnitude end
        if ok and cf then return (cf.Position - root.Position).Magnitude end
        return math.huge
    end
    for _, folderName in ipairs({ "Map", "Enemies" }) do
        local f = w:FindFirstChild(folderName)
        local list = {}
        for _, m in ipairs(f and f:GetChildren() or {}) do
            local d = near(m)
            if d <= 1500 then list[#list + 1] = { m = m, d = d } end
        end
        table.sort(list, function(a, b) return a.d < b.d end)
        out[#out + 1] = ""
        out[#out + 1] = "######## " .. folderName .. " within 1500 studs: " .. #list
        for i, it in ipairs(list) do
            if i > 25 then break end
            out[#out + 1] = string.format("--- %.0f studs away", it.d)
            plain(it.m, folderName == "Map" and 5 or 2, out, "  ")
        end
    end
    -- prompts near you
    out[#out + 1] = ""
    out[#out + 1] = "######## ProximityPrompts within 300 studs"
    for _, d in ipairs(w:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Parent and d.Parent:IsA("BasePart") and (d.Parent.Position - root.Position).Magnitude < 300 then
            out[#out + 1] = path(d) .. '  "' .. d.ActionText .. '" enabled=' .. tostring(d.Enabled)
        end
    end
    save("near.txt", out)
end

local function dumpModes()
    local out = {}
